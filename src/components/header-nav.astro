---
import { siteConfig, type NavItem } from '@/lib/site-config';

const nav = siteConfig.nav as NavItem[];
---
<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/85 backdrop-blur-md supports-[backdrop-filter]:bg-background/70"
  data-header
>
  <div class="container-fluid flex h-16 items-center justify-between gap-6">
    <!-- 左：品牌 logo (紫渐变 + retroarch.svg + FluxA 黑字 — 还原最初样式) -->
    <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="FluxA 首页">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-[linear-gradient(135deg,#7a27ff_0%,#5b2bcb_100%)]">
        <img src="/retroarch.svg" alt="" class="h-4 w-4 brightness-0 invert" />
      </span>
      <span class="text-[17px] font-bold text-[#181E25] tracking-[-0.01em]">
        {siteConfig.brand.name}
      </span>
    </a>

    <!-- 桌面端 nav -->
    <nav class="hidden md:flex items-center gap-1 text-sm" aria-label="主导航">
      {nav.map((item) => {
        if (item.subMenu) {
          return (
            <div class="relative" data-has-submenu>
              <button
                type="button"
                class="inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-foreground/70 transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40"
                aria-haspopup="true"
                aria-expanded="false"
                data-submenu-trigger
              >
                {item.label}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 opacity-60 transition-transform group-data-[state=open]:rotate-180">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>
              <div
                class="absolute left-0 top-full pt-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 z-50"
                role="menu"
              >
                <div class="min-w-[260px] rounded-lg border border-border bg-popover p-2 shadow-md">
                  {item.subMenu.map((cat) => (
                    <div class="px-2 py-2">
                      <div class="text-[11px] font-medium text-muted-foreground uppercase tracking-wider mb-1.5 px-2">
                        {cat.category}
                      </div>
                      <div class="space-y-0.5">
                        {cat.items.map((sub) => (
                          <a
                            href={sub.href}
                            class="block rounded-md px-2 py-1.5 text-sm text-foreground/80 transition-colors hover:bg-muted hover:text-foreground"
                            role="menuitem"
                          >
                            {sub.label}
                          </a>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          );
        }
        return (
          <a
            href={item.href}
            class="inline-flex items-center rounded-md px-3 py-1.5 text-foreground/70 transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40"
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- 桌面端右侧：登录 + 立即咨询 -->
    <div class="hidden md:flex items-center gap-2 shrink-0">
      <a
        href="#about"
        class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-foreground/70 transition-colors hover:text-foreground"
      >
        登录
      </a>
      <a
        href="#contact"
        class="inline-flex h-8 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40"
      >
        立即咨询
      </a>
    </div>

    <!-- 移动端：汉堡 -->
    <button
      type="button"
      class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-md text-foreground hover:bg-muted transition-colors"
      aria-label="打开菜单"
      aria-expanded="false"
      data-mobile-toggle
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" data-icon-closed>
        <line x1="4" x2="20" y1="6" y2="6" />
        <line x1="4" x2="20" y1="12" y2="12" />
        <line x1="4" x2="20" y1="18" y2="18" />
      </svg>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 hidden" data-icon-open>
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </svg>
    </button>
  </div>

  <!-- 移动端全屏菜单 -->
  <div
    class="md:hidden hidden border-t border-border bg-background"
    data-mobile-menu
    role="dialog"
    aria-label="移动端菜单"
  >
    <div class="container-fluid py-3 space-y-1">
      {nav.map((item) => {
        if (item.subMenu) {
          return (
            <details class="group rounded-md">
              <summary class="flex items-center justify-between cursor-pointer list-none px-3 py-2.5 rounded-md text-sm font-medium text-foreground hover:bg-muted transition-colors [&::-webkit-details-marker]:hidden">
                <span>{item.label}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-muted-foreground transition-transform group-open:rotate-180">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <div class="pb-2 pl-3 space-y-3">
                {item.subMenu.map((cat) => (
                  <div>
                    <div class="text-[11px] font-medium text-muted-foreground uppercase tracking-wider px-3 mb-1.5">
                      {cat.category}
                    </div>
                    {cat.items.map((sub) => (
                      <a
                        href={sub.href}
                        class="block rounded-md px-3 py-2 text-sm text-foreground/80 hover:bg-muted hover:text-foreground transition-colors"
                      >
                        {sub.label}
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            </details>
          );
        }
        return (
          <a
            href={item.href}
            class="block px-3 py-2.5 rounded-md text-sm font-medium text-foreground hover:bg-muted transition-colors"
          >
            {item.label}
          </a>
        );
      })}
      <a
        href="#contact"
        class="block mt-2 px-3 py-2.5 rounded-md text-sm font-medium text-center bg-primary text-primary-foreground"
      >
        立即咨询
      </a>
    </div>
  </div>
</header>

<script>
  // 移动端汉堡 toggle
  const toggle = document.querySelector('[data-mobile-toggle]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
  const iconClosed = document.querySelector('[data-icon-closed]') as SVGElement | null;
  const iconOpen = document.querySelector('[data-icon-open]') as SVGElement | null;
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!isOpen));
      iconClosed?.classList.toggle('hidden', !isOpen);
      iconOpen?.classList.toggle('hidden', isOpen);
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });
  }

  // 桌面端 dropdown：click toggle
  const submenuItems = document.querySelectorAll('[data-has-submenu]');
  submenuItems.forEach((item) => {
    const trigger = item.querySelector('[data-submenu-trigger]') as HTMLButtonElement | null;
    const panel = item.querySelector('[role="menu"]') as HTMLElement | null;
    if (!trigger || !panel) return;
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      // 关闭其他
      submenuItems.forEach((other) => {
        if (other === item) return;
        const t = other.querySelector('[data-submenu-trigger]') as HTMLButtonElement | null;
        const p = other.querySelector('[role="menu"]') as HTMLElement | null;
        if (t && p) {
          t.setAttribute('aria-expanded', 'false');
          p.classList.add('opacity-0', 'invisible', 'translate-y-1');
          p.classList.remove('opacity-100', 'visible', 'translate-y-0');
        }
      });
      trigger.setAttribute('aria-expanded', String(!expanded));
      panel.classList.toggle('opacity-0', expanded);
      panel.classList.toggle('invisible', expanded);
      panel.classList.toggle('translate-y-1', expanded);
      panel.classList.toggle('opacity-100', !expanded);
      panel.classList.toggle('visible', !expanded);
      panel.classList.toggle('translate-y-0', !expanded);
    });
  });

  // 点击外部关闭 dropdown
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-has-submenu]')) {
      submenuItems.forEach((item) => {
        const t = item.querySelector('[data-submenu-trigger]') as HTMLButtonElement | null;
        const p = item.querySelector('[role="menu"]') as HTMLElement | null;
        if (t && p) {
          t.setAttribute('aria-expanded', 'false');
          p.classList.add('opacity-0', 'invisible', 'translate-y-1');
          p.classList.remove('opacity-100', 'visible', 'translate-y-0');
        }
      });
    }
  });
</script>
