---
import Icon from '@/components/icon.astro';
import { Button } from '@/components/ui/button';

interface ServiceHighlight {
  title: string;
  description: string;
  icon: string;
}

interface ServiceData {
  name: string;
  slug: string;
  tagline: string;
  description: string;
  icon: string;
  highlights: ServiceHighlight[];
  ctaLabel: string;
}

interface PricingTier {
  name: string;
  price: string;
  period: string;
  originalPrice?: string;
  features: string[];
  recommended: boolean;
  ctaLabel: string;
}

interface PricingData {
  tiers: PricingTier[];
}

interface Props {
  service: ServiceData;
  pricing?: PricingData | null;
}

const { service, pricing } = Astro.props;
const tierCount = pricing?.tiers.length ?? 0;
const startingTier = pricing?.tiers[0];
const startingPrice = startingTier
  ? `${startingTier.price}${startingTier.period ?? ''}`
  : null;
---
<section class="relative py-24 bg-zinc-950 overflow-hidden">
  <div class="absolute top-0 left-1/3 w-[500px] h-[500px] bg-indigo-500/15 rounded-full blur-3xl -z-0"></div>
  <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-cyan-500/10 rounded-full blur-3xl -z-0"></div>

  <div class="container mx-auto max-w-4xl px-4 text-center relative">
    <div class="inline-flex h-20 w-20 rounded-2xl bg-gradient-to-br from-indigo-500/20 to-cyan-500/20 border border-indigo-500/30 items-center justify-center mb-8">
      <Icon name={service.icon} class="text-indigo-300" size={40} />
    </div>
    <h1 class="text-4xl md:text-6xl font-bold text-white tracking-tighter">{service.name}</h1>
    <p class="mt-6 text-lg md:text-xl text-zinc-400 max-w-2xl mx-auto leading-relaxed">{service.tagline}</p>

    {(startingPrice || tierCount > 0) && (
      <div class="mt-8 inline-flex flex-wrap items-center justify-center gap-2 rounded-full border border-zinc-800 bg-zinc-900/60 backdrop-blur-md px-5 py-2.5 text-sm">
        {startingPrice && (
          <>
            <span class="text-zinc-500">起售价</span>
            <span class="font-semibold text-white">从 {startingPrice} 起</span>
          </>
        )}
        {tierCount > 0 && (
          <>
            {startingPrice && <span class="text-zinc-700">·</span>}
            <span class="text-zinc-500">共 {tierCount} 个套餐</span>
          </>
        )}
      </div>
    )}

    <p class="mt-10 text-zinc-300 max-w-2xl mx-auto leading-relaxed">{service.description}</p>

    <div class="mt-12 flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/pricing">
        <Button size="lg" variant="outline" className="rounded-full h-12 px-8 border-zinc-700 bg-zinc-900/50 text-white hover:bg-zinc-800 backdrop-blur-sm">
          查看套餐
        </Button>
      </a>
      <a href="/contact">
        <Button size="lg" className="rounded-full h-12 px-8 bg-white text-zinc-950 hover:bg-zinc-200">
          {service.ctaLabel}
        </Button>
      </a>
    </div>
  </div>
</section>

<section class="py-20 bg-zinc-900">
  <div class="container mx-auto max-w-5xl px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-white text-center tracking-tight">核心亮点</h2>
    <p class="mt-3 text-center text-zinc-400">为什么选择 {service.name}</p>
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {service.highlights.map((h) => (
        <div class="backdrop-blur-md bg-zinc-950/60 border border-zinc-800 rounded-2xl p-6 hover:border-zinc-700 transition-all">
          <div class="flex items-center gap-3">
            <div class="shrink-0 h-10 w-10 rounded-xl bg-gradient-to-br from-indigo-500/20 to-cyan-500/20 border border-indigo-500/30 flex items-center justify-center">
              <Icon name={h.icon} class="text-indigo-300" size={20} />
            </div>
            <h3 class="text-base font-semibold text-white">{h.title}</h3>
          </div>
          <p class="mt-4 text-sm text-zinc-400 leading-relaxed">{h.description}</p>
        </div>
      ))}
    </div>

    <div class="mt-14 text-center">
      <a href="/pricing" class="text-sm font-medium text-indigo-400 hover:text-indigo-300 transition-colors">
        查看完整套餐对比 →
      </a>
    </div>
  </div>
</section>
