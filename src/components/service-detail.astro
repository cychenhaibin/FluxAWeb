---
import Icon from '@/components/icon.astro';
import { Button } from '@/components/ui/button';

interface ServiceHighlight {
  title: string;
  description: string;
  icon: string;
}

interface ServiceData {
  name: string;
  slug: string;
  tagline: string;
  description: string;
  icon: string;
  highlights: ServiceHighlight[];
  ctaLabel: string;
}

interface PricingTier {
  name: string;
  price: string;
  period: string;
  originalPrice?: string;
  features: string[];
  recommended: boolean;
  ctaLabel: string;
}

interface PricingData {
  tiers: PricingTier[];
}

interface Props {
  service: ServiceData;
  pricing?: PricingData | null;
}

const { service, pricing } = Astro.props;
const tierCount = pricing?.tiers.length ?? 0;
const startingTier = pricing?.tiers[0];
const startingPrice = startingTier
  ? `${startingTier.price}${startingTier.period ?? ''}`
  : null;
---
<section class="relative bg-[#08090a] pt-32 pb-12 overflow-hidden">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="flex items-end justify-between gap-8">
      <h1 class="text-[clamp(2.5rem,6.5vw,5rem)] leading-[0.95] font-semibold text-white tracking-[-0.04em] text-balance max-w-3xl">{service.name}</h1>
      <div class="hidden md:flex items-center gap-1.5 text-[13px] text-zinc-400 shrink-0 pb-3">
        <span class="px-1.5 py-0.5 rounded-md bg-[#5e6ad2] text-white text-[11px] font-medium uppercase tracking-wider">{service.slug}</span>
      </div>
    </div>
    <p class="mt-6 text-[15px] md:text-base text-zinc-400 leading-relaxed text-pretty max-w-2xl">
      {service.tagline.split(/[，,。]/)[0]}。<br />
      官方价直充 + 透明服务费，5 分钟极速到账。
    </p>
  </div>
</section>

<section class="bg-[#08090a] pb-24">
  <div class="container mx-auto max-w-6xl px-4">
    <p class="text-[15px] text-zinc-300 leading-relaxed max-w-2xl">{service.description}</p>

    <div class="mt-8 inline-flex flex-wrap items-center gap-x-3 gap-y-1.5 rounded-md border border-white/10 bg-white/5 px-4 py-2.5 text-[13px] backdrop-blur-md">
      {startingPrice && (
        <>
          <span class="text-zinc-500">起售价</span>
          <span class="font-semibold text-white tnum">{startingPrice}</span>
        </>
      )}
      {tierCount > 0 && (
        <>
          <span class="text-zinc-700">·</span>
          <span class="text-zinc-500">共 {tierCount} 个套餐</span>
        </>
      )}
    </div>

    <div class="mt-8 flex flex-col sm:flex-row gap-3">
      <a href="/pricing">
        <Button size="lg" variant="outline" className="rounded-md h-10 px-4 text-[13px] font-medium border-white/15 bg-white/5 text-white hover:bg-white/10">
          查看套餐
        </Button>
      </a>
      <a href="/contact">
        <Button size="lg" className="rounded-md h-10 px-4 text-[13px] font-medium bg-[#5e6ad2] text-white hover:bg-[#7173f3]">
          {service.ctaLabel}
        </Button>
      </a>
    </div>
  </div>
</section>

<section class="bg-[#08090a] pb-20 border-t border-white/5">
  <div class="container mx-auto max-w-5xl px-4 pt-20">
    <h2 class="text-2xl md:text-[28px] leading-[1.2] font-semibold text-white text-left tracking-[-0.025em]">核心亮点</h2>
    <p class="mt-2 text-zinc-400 text-[14px]">为什么选择 {service.name}</p>
    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      {service.highlights.map((h) => (
        <div class="card rounded-md p-5 hover:border-[#5e6ad2]/50 transition-all">
          <div class="flex items-center gap-3">
            <div class="shrink-0 h-9 w-9 rounded-md bg-[#5e6ad2]/15 border border-[#5e6ad2]/25 flex items-center justify-center">
              <Icon name={h.icon} class="text-[#5e6ad2]" size={18} />
            </div>
            <h3 class="text-[15px] font-semibold text-white tracking-tight">{h.title}</h3>
          </div>
          <p class="mt-3 text-[13.5px] text-zinc-400 leading-relaxed">{h.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
