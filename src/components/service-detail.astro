---
import Icon from '@/components/icon.astro';
import { Button } from '@/components/ui/button';

interface ServiceHighlight {
  title: string;
  description: string;
  icon: string;
}

interface ServiceData {
  name: string;
  slug: string;
  tagline: string;
  description: string;
  icon: string;
  highlights: ServiceHighlight[];
  ctaLabel: string;
}

interface PricingTier {
  name: string;
  price: string;
  period: string;
  originalPrice?: string;
  features: string[];
  recommended: boolean;
  ctaLabel: string;
}

interface PricingData {
  tiers: PricingTier[];
}

interface Props {
  service: ServiceData;
  pricing?: PricingData | null;
}

const { service, pricing } = Astro.props;
const tierCount = pricing?.tiers.length ?? 0;
const startingTier = pricing?.tiers[0];
const startingPrice = startingTier
  ? `${startingTier.price}${startingTier.period ?? ''}`
  : null;
---
<section class="relative py-28 hero-mesh overflow-hidden">
  <div class="container mx-auto max-w-4xl px-4 text-center relative">
    <div class="inline-flex h-16 w-16 rounded-2xl glass-dark items-center justify-center mb-7">
      <Icon name={service.icon} class="text-white" size={32} />
    </div>
    <h1 class="text-[clamp(2rem,5vw,3.75rem)] leading-[1.15] font-semibold text-white tracking-[-0.02em] text-balance drop-shadow-sm">{service.name}</h1>
    <p class="mt-5 text-base md:text-lg text-white/90 max-w-2xl mx-auto leading-relaxed text-pretty">{service.tagline}</p>

    {(startingPrice || tierCount > 0) && (
      <div class="mt-7 inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1 glass-dark rounded-full px-4 py-2 text-[13px] text-white">
        {startingPrice && (
          <>
            <span class="text-white/70">起售价</span>
            <span class="font-semibold tnum">从 {startingPrice} 起</span>
          </>
        )}
        {tierCount > 0 && (
          <>
            {startingPrice && <span class="text-white/40">·</span>}
            <span class="text-white/70">共 {tierCount} 个套餐</span>
          </>
        )}
      </div>
    )}

    <p class="mt-9 text-[15px] text-white/85 max-w-2xl mx-auto leading-relaxed">{service.description}</p>

    <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/pricing">
        <Button size="lg" className="rounded-full h-11 px-6 text-[13px] font-medium glass-dark text-white hover:bg-white/25">
          查看套餐
        </Button>
      </a>
      <a href="/contact">
        <Button size="lg" className="rounded-full h-11 px-6 text-[13px] font-medium bg-white text-[#1d1d1f] hover:bg-white/90">
          {service.ctaLabel}
        </Button>
      </a>
    </div>
  </div>
</section>

<section class="py-16 bg-[#fbfbfd]">
  <div class="container mx-auto max-w-5xl px-4">
    <h2 class="text-2xl md:text-[28px] leading-[1.2] font-semibold text-zinc-900 text-center tracking-[-0.015em]">核心亮点</h2>
    <p class="mt-2.5 text-center text-zinc-600 text-[14px]">为什么选择 {service.name}</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {service.highlights.map((h) => (
        <div class="glass rounded-3xl p-6 hover:bg-white/70 transition-all">
          <div class="flex items-center gap-3">
            <div class="shrink-0 h-10 w-10 rounded-xl bg-gradient-to-br from-[#f97316] to-[#ec4899] flex items-center justify-center shadow-apple">
              <Icon name={h.icon} class="text-white" size={20} />
            </div>
            <h3 class="text-[15px] font-semibold text-zinc-900 tracking-tight">{h.title}</h3>
          </div>
          <p class="mt-3.5 text-[13.5px] text-zinc-600 leading-relaxed">{h.description}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="/pricing" class="text-[13px] font-medium text-[#0071e3] hover:text-[#0077ed] transition-colors">
        查看完整套餐对比 →
      </a>
    </div>
  </div>
</section>
