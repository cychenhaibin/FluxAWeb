---
import Icon from '@/components/icon.astro';
import { Button } from '@/components/ui/button';

interface ServiceHighlight {
  title: string;
  description: string;
  icon: string;
}

interface ServiceData {
  name: string;
  slug: string;
  tagline: string;
  description: string;
  icon: string;
  highlights: ServiceHighlight[];
  ctaLabel: string;
}

interface PricingTier {
  name: string;
  price: string;
  period: string;
  originalPrice?: string;
  features: string[];
  recommended: boolean;
  ctaLabel: string;
}

interface PricingData {
  tiers: PricingTier[];
}

interface Props {
  service: ServiceData;
  pricing?: PricingData | null;
}

const { service, pricing } = Astro.props;
const tierCount = pricing?.tiers.length ?? 0;
const startingTier = pricing?.tiers[0];
const startingPrice = startingTier
  ? `${startingTier.price}${startingTier.period ?? ''}`
  : null;
---
<section class="relative py-28 bg-[#08090a] mesh-bg overflow-hidden">
  <div class="container mx-auto max-w-4xl px-4 text-center relative">
    <div class="inline-flex h-16 w-16 rounded-xl bg-[#5e6ad2]/15 border border-[#5e6ad2]/25 items-center justify-center mb-7">
      <Icon name={service.icon} class="text-[#5e6ad2]" size={32} />
    </div>
    <h1 class="text-[clamp(2rem,5vw,3.75rem)] leading-[1.1] font-semibold text-white tracking-[-0.025em] text-balance">{service.name}</h1>
    <p class="mt-5 text-base md:text-lg text-zinc-400 max-w-2xl mx-auto leading-relaxed text-pretty">{service.tagline}</p>

    {(startingPrice || tierCount > 0) && (
      <div class="mt-7 inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-[13px] backdrop-blur-md">
        {startingPrice && (
          <>
            <span class="text-zinc-500">起售价</span>
            <span class="font-semibold text-white tnum">从 {startingPrice} 起</span>
          </>
        )}
        {tierCount > 0 && (
          <>
            {startingPrice && <span class="text-zinc-700">·</span>}
            <span class="text-zinc-500">共 {tierCount} 个套餐</span>
          </>
        )}
      </div>
    )}

    <p class="mt-9 text-[15px] text-zinc-300 max-w-2xl mx-auto leading-relaxed">{service.description}</p>

    <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/pricing">
        <Button size="lg" variant="outline" className="rounded-lg h-11 px-5 text-[13px] font-medium border-white/15 bg-white/5 text-white hover:bg-white/10 backdrop-blur-md">
          查看套餐
        </Button>
      </a>
      <a href="/contact">
        <Button size="lg" className="rounded-lg h-11 px-5 text-[13px] font-medium bg-[#5e6ad2] text-white hover:bg-[#7173f3] shadow-purple">
          {service.ctaLabel}
        </Button>
      </a>
    </div>
  </div>
</section>

<section class="py-16 bg-[#0e0e10] border-t border-white/5">
  <div class="container mx-auto max-w-5xl px-4">
    <h2 class="text-2xl md:text-[28px] leading-[1.2] font-semibold text-white text-center tracking-[-0.015em]">核心亮点</h2>
    <p class="mt-2.5 text-center text-zinc-400 text-[14px]">为什么选择 {service.name}</p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {service.highlights.map((h) => (
        <div class="card rounded-xl p-6 hover:border-[#5e6ad2]/50 transition-all">
          <div class="flex items-center gap-3">
            <div class="shrink-0 h-10 w-10 rounded-lg bg-[#5e6ad2]/15 border border-[#5e6ad2]/25 flex items-center justify-center">
              <Icon name={h.icon} class="text-[#5e6ad2]" size={20} />
            </div>
            <h3 class="text-[15px] font-semibold text-white tracking-tight">{h.title}</h3>
          </div>
          <p class="mt-3.5 text-[13.5px] text-zinc-400 leading-relaxed">{h.description}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="/pricing" class="text-[13px] font-medium text-[#5e6ad2] hover:text-[#c4c5f5] transition-colors">
        查看完整套餐对比 →
      </a>
    </div>
  </div>
</section>
