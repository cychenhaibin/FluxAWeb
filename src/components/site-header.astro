---
import { siteConfig } from '@/lib/site-config';
const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-50 bg-white/85 backdrop-blur-md border-b border-[#E4E7EB]">
  <div class="container mx-auto max-w-6xl px-4 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 shrink-0">
      <span class="inline-flex h-8 w-8 rounded-lg gradient-purple items-center justify-center shadow-sm">
        <img src="/retroarch.svg" alt="FluxA" class="h-4 w-4 brightness-0 invert" />
      </span>
      <span class="text-[18px] font-bold text-[#181E25] tracking-[-0.02em]">{siteConfig.brand.name}</span>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-[14px] font-medium">
      {siteConfig.nav.map((item) => (
        <a
          href={item.href}
          class={`transition-colors ${
            currentPath === item.href
              ? 'text-[#7A27FF]'
              : 'text-[#181E25] hover:text-[#7A27FF]'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a
      href="/contact"
      class="inline-flex items-center justify-center h-10 px-5 rounded-full gradient-purple text-white text-[14px] font-medium hover:opacity-90 transition-opacity shrink-0"
    >
      立即购买
    </a>
  </div>
</header>
