---
import { siteConfig } from '@/lib/site-config';
import { Button } from '@/components/ui/button';
---
<header class="sticky top-0 z-50 backdrop-blur-xl bg-zinc-950/70 border-b border-zinc-800/60">
  <div class="container mx-auto max-w-6xl px-4 h-14 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 text-[15px] font-semibold text-white tracking-[-0.01em]">
      <span class="inline-block h-6 w-6 rounded-md bg-gradient-to-br from-indigo-500 to-cyan-500 flex items-center justify-center text-white text-[11px] font-bold">F</span>
      {siteConfig.brand.name}
    </a>
    <nav class="hidden md:flex items-center gap-7 text-[13px]">
      {siteConfig.nav.map((item) => (
        <a href={item.href} class="text-zinc-400 hover:text-white transition-colors">
          {item.label}
        </a>
      ))}
    </nav>
    <a href="/contact">
      <Button className="rounded-full h-9 px-4 text-[13px] font-medium bg-white text-zinc-950 hover:bg-zinc-200">
        立即购买
      </Button>
    </a>
  </div>
</header>
