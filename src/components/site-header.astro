---
import { siteConfig } from '@/lib/site-config';
const currentPath = Astro.url.pathname;

// MiniMax 风格：把主导航 7 项居中，登录按钮在最右
const mainNav = siteConfig.nav; // 7 项
---
<header class="sticky top-0 z-50 bg-white border-b border-[#E4E7EB]">
  <div class="container mx-auto max-w-6xl px-4 h-16 flex items-center justify-between">
    <!-- 左 logo：紫渐变背景 + retroarch 图标 + FluxA 黑字 -->
    <a href="/" class="flex items-center gap-2.5 shrink-0">
      <span class="inline-flex h-7 w-7 rounded-md gradient-purple items-center justify-center">
        <img src="/retroarch.svg" alt="FluxA" class="h-3.5 w-3.5 brightness-0 invert" />
      </span>
      <span class="text-[16px] font-bold text-[#181E25] tracking-[-0.01em]">{siteConfig.brand.name}</span>
    </a>
    <!-- 居中导航 -->
    <nav class="hidden lg:flex items-center gap-7 text-[14px] font-medium">
      {mainNav.map((item) => (
        <a
          href={item.href}
          class={`transition-colors ${
            currentPath === item.href
              ? 'text-[#7A27FF]'
              : 'text-[#181E25] hover:text-[#7A27FF]'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <!-- 右：联系客服按钮 (圆角胶囊) -->
    <a
      href="/contact"
      class="inline-flex items-center justify-center h-9 px-5 rounded-full border border-[#E4E7EB] bg-white text-[#181E25] text-[13px] font-medium hover:border-[#181E25] transition-colors shrink-0"
    >
      联系客服
    </a>
  </div>
</header>
