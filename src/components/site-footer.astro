---
import { siteConfig } from '@/lib/site-config';
---
<footer class="bg-[#0a0d12] text-white mt-24">
  <div class="container mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-12 md:grid-cols-[280px_1fr]">
      <!-- 左：logo + 简介 -->
      <div>
        <a href="/" class="inline-flex items-center gap-2.5">
          <span class="inline-flex h-8 w-8 rounded-md gradient-purple items-center justify-center">
            <img src="/retroarch.svg" alt="FluxA" class="h-4 w-4 brightness-0 invert" />
          </span>
          <span class="text-[18px] font-bold tracking-[-0.01em]">{siteConfig.brand.name}</span>
        </a>
        <p class="mt-5 text-[14px] text-white/60 leading-relaxed max-w-xs">
          AI 服务，一站搞定。<br />
          官方价 + 仅 $3 人工费。
        </p>
        <a
          href="/contact"
          class="mt-6 inline-flex items-center justify-center h-10 px-5 rounded-full bg-white text-[#181E25] text-[13px] font-medium hover:opacity-90 transition-opacity"
        >
          联系我们
        </a>
      </div>

      <!-- 右：4 列 -->
      <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4">
        <div>
          <div class="text-[12px] font-semibold text-white/40 uppercase tracking-[0.15em]">业务</div>
          <ul class="mt-4 space-y-2.5 text-[14px] text-white/80">
            {siteConfig.nav
              .filter((n): n is { label: string; href: string } => Boolean(n.href?.startsWith('/services/')))
              .map((item) => (
                <li>
                  <a href={item.href} class="hover:text-white transition-colors">{item.label}</a>
                </li>
              ))}
          </ul>
        </div>
        <div>
          <div class="text-[12px] font-semibold text-white/40 uppercase tracking-[0.15em]">资源</div>
          <ul class="mt-4 space-y-2.5 text-[14px] text-white/80">
            <li><a href="/pricing" class="hover:text-white transition-colors">价格</a></li>
            <li><a href="/faq" class="hover:text-white transition-colors">常见问题</a></li>
          </ul>
        </div>
        <div>
          <div class="text-[12px] font-semibold text-white/40 uppercase tracking-[0.15em]">公司</div>
          <ul class="mt-4 space-y-2.5 text-[14px] text-white/80">
            <li><a href="/contact" class="hover:text-white transition-colors">联系我们</a></li>
            <li><a href={`mailto:${siteConfig.contact.email.address}`} class="hover:text-white transition-colors">商务合作</a></li>
          </ul>
        </div>
        <div>
          <div class="text-[12px] font-semibold text-white/40 uppercase tracking-[0.15em]">为什么选 FluxA</div>
          <ul class="mt-4 space-y-2.5 text-[14px] text-white/80">
            <li class="flex items-start gap-2"><span class="text-[#A36AFF]">✓</span>官方价透明</li>
            <li class="flex items-start gap-2"><span class="text-[#A36AFF]">✓</span>5 分钟到账</li>
            <li class="flex items-start gap-2"><span class="text-[#A36AFF]">✓</span>7×24 客服</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col items-start justify-between gap-3 text-[12px] text-white/50 md:flex-row md:items-center">
      <div class="flex items-center gap-3">
        <span>© {new Date().getFullYear()} {siteConfig.brand.name}.</span>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer" class="hover:text-white/80 transition-colors">
          {siteConfig.icp}
        </a>
      </div>
      <div class="flex items-center gap-5">
        <a href={siteConfig.contact.ticket.url} class="hover:text-white/80 transition-colors">GitHub</a>
        <a href={siteConfig.contact.ticket.url} class="hover:text-white/80 transition-colors">Twitter</a>
        <a href={`mailto:${siteConfig.contact.email.address}`} class="hover:text-white/80 transition-colors">Email</a>
      </div>
    </div>
  </div>

  <button
    type="button"
    aria-label="回到顶部"
    id="back-to-top"
    class="fixed bottom-6 right-6 z-50 hidden h-11 w-11 rounded-full gradient-purple text-white shadow-lg transition-all hover:opacity-90"
  >
    ↑
  </button>
</footer>

<script>
  const btn = document.getElementById('back-to-top');
  if (btn) {
    const toggle = () => {
      btn.classList.toggle('hidden', window.scrollY < 400);
    };
    window.addEventListener('scroll', toggle, { passive: true });
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    toggle();
  }
</script>
