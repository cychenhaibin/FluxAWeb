---
import { siteConfig } from '@/lib/site-config';
---
<footer class="border-t border-black/5 bg-[#f5f5f7] mt-20">
  <div class="container mx-auto max-w-6xl px-4 py-14">
    <div class="grid gap-10 md:grid-cols-4">
      <div>
        <div class="flex items-center gap-3 text-[15px] font-semibold text-zinc-900 tracking-[-0.01em]">
          <span class="inline-flex h-8 w-8 rounded-lg bg-white border border-black/5 items-center justify-center shadow-apple">
            <img src="/retroarch.svg" alt="FluxA" class="h-5 w-5" />
          </span>
          {siteConfig.brand.name}
        </div>
        <p class="mt-3 text-[13px] text-zinc-600 leading-relaxed">{siteConfig.brand.slogan}</p>
        <p class="mt-2 text-[11px] text-zinc-500">官方价 + 仅 $3 人工费</p>
      </div>

      <div>
        <div class="text-[13px] font-semibold text-zinc-900 tracking-tight">快速链接</div>
        <ul class="mt-3 space-y-2 text-[13px] text-zinc-600">
          {siteConfig.nav.map((item) => (
            <li>
              <a href={item.href} class="hover:text-zinc-900 transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <div class="text-[13px] font-semibold text-zinc-900 tracking-tight">联系我们</div>
        <ul class="mt-3 space-y-2.5 text-[13px] text-zinc-600">
          <li>
            <span class="text-zinc-500">{siteConfig.contact.wechat.name}：</span>
            <img
              src={siteConfig.contact.wechat.qrPlaceholder}
              alt={siteConfig.contact.wechat.name}
              class="mt-2 h-20 w-20 rounded-xl border border-black/5 bg-white p-1"
              width="80"
              height="80"
            />
          </li>
          <li>
            <span class="text-zinc-500">{siteConfig.contact.email.name}：</span>
            <a
              href={`mailto:${siteConfig.contact.email.address}`}
              class="block mt-1 hover:text-zinc-900 transition-colors"
            >
              {siteConfig.contact.email.address}
            </a>
          </li>
          <li>
            <span class="text-zinc-500">{siteConfig.contact.ticket.name}：</span>
            <a
              href={siteConfig.contact.ticket.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block mt-1 hover:text-zinc-900 transition-colors break-all"
            >
              {siteConfig.contact.ticket.url}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <div class="text-[13px] font-semibold text-zinc-900 tracking-tight">为什么选 FluxA</div>
        <ul class="mt-3 space-y-2 text-[13px] text-zinc-600">
          <li class="flex items-start gap-2"><span class="text-[#0071e3]">✓</span>官方价透明计费</li>
          <li class="flex items-start gap-2"><span class="text-[#0071e3]">✓</span>5 分钟极速到账</li>
          <li class="flex items-start gap-2"><span class="text-[#0071e3]">✓</span>7×24 真人客服</li>
          <li class="flex items-start gap-2"><span class="text-[#0071e3]">✓</span>全档位覆盖</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-black/5 pt-5 text-[11px] text-zinc-500 md:flex-row">
      <p>© {new Date().getFullYear()} {siteConfig.brand.name}. All rights reserved.</p>
      <p>
        <a
          href="https://beian.miit.gov.cn/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-zinc-700 transition-colors"
        >
          {siteConfig.icp}
        </a>
      </p>
    </div>
  </div>

  <button
    type="button"
    aria-label="回到顶部"
    id="back-to-top"
    class="fixed bottom-6 right-6 z-50 hidden h-10 w-10 rounded-full border border-black/5 bg-white/80 backdrop-blur-md text-zinc-700 shadow-apple transition-all hover:border-[#0071e3]/50 hover:text-[#0071e3]"
  >
    ↑
  </button>
</footer>

<script>
  const btn = document.getElementById('back-to-top');
  if (btn) {
    const toggle = () => {
      btn.classList.toggle('hidden', window.scrollY < 400);
    };
    window.addEventListener('scroll', toggle, { passive: true });
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    toggle();
  }
</script>
