---
// devTools section (minimaxi.com 风格: dev tool marquee + API code + 4 接入方式 + 部署)
// 10 个 dev tool 占位
const tools = [
  'Python', 'Node.js', 'Go', 'Rust', 'Java',
  'TypeScript', 'Ruby', 'PHP', 'cURL', 'Postman',
];

// API code snippet (Python)
const codePython = `from openai import OpenAI

client = OpenAI(
    base_url="https://api.fluxa.example.com/v1",
    api_key="YOUR_FLUXA_KEY"
)

response = client.chat.completions.create(
    model="gpt-4o",
    messages=[
        {"role": "user", "content": "你好，FluxA！"}
    ]
)
print(response.choices[0].message.content)`;

const codeCurl = `curl -X POST "https://api.fluxa.example.com/v1/chat/completions" \\
  -H "Authorization: Bearer YOUR_FLUXA_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "gpt-4o",
    "messages": [{"role": "user", "content": "你好"}]
  }'`;

// 4 接入方式
const integrations = [
  { title: 'OpenAI SDK', desc: '一行 base_url 切换到 FluxA', icon: 'Layers' },
  { title: 'Anthropic SDK', desc: 'Claude 系列原生支持', icon: 'Sparkles' },
  { title: 'REST API', desc: '标准 HTTP 调用 + 流式响应', icon: 'Zap' },
  { title: 'Web UI', desc: 'AI 聚合平台统一界面', icon: 'Globe' },
];
---
<section class="py-24 bg-white">
  <div class="container-fluid">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="heading-display text-[clamp(2.5rem,6vw,4.5rem)] text-balance">
        开发者 <span class="gradient-purple-text">友好</span>
      </h2>
      <p class="mt-5 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed">
        10 种开发工具 · 4 种接入方式 · 5 分钟完成对接
      </p>
    </div>

    <!-- Dev tools marquee -->
    <div class="mt-12 relative overflow-hidden">
      <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
      <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>
      <div class="flex gap-4 animate-marquee whitespace-nowrap">
        {[...tools, ...tools].map((tool) => (
          <div class="shrink-0 inline-flex items-center h-14 px-7 rounded-2xl border border-[#E4E7EB] bg-white text-[#181E25] text-[15px] font-semibold tracking-tight hover:border-[#181E25] transition-colors">
            {tool}
          </div>
        ))}
      </div>
    </div>

    <!-- API code + 4 接入方式 -->
    <div class="mt-16 grid gap-8 lg:grid-cols-[1.4fr_1fr]">
      <!-- 左：API code -->
      <div class="rounded-3xl bg-[#0a0d12] text-white overflow-hidden">
        <div class="flex items-center gap-1.5 px-5 py-3 border-b border-white/10">
          <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
          <div class="ml-3 text-[12px] text-white/60 font-mono">fluxa-quickstart.py / curl</div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2">
          <div class="p-5 border-r border-white/10">
            <div class="text-[10px] uppercase tracking-[0.2em] text-white/50 font-semibold mb-2">Python</div>
            <pre class="text-[12px] leading-[1.7] text-white/90 font-mono whitespace-pre-wrap break-words"><code>{codePython}</code></pre>
          </div>
          <div class="p-5">
            <div class="text-[10px] uppercase tracking-[0.2em] text-white/50 font-semibold mb-2">cURL</div>
            <pre class="text-[12px] leading-[1.7] text-white/90 font-mono whitespace-pre-wrap break-words"><code>{codeCurl}</code></pre>
          </div>
        </div>
      </div>

      <!-- 右：4 接入方式 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {integrations.map((i) => (
          <div class="rounded-3xl bg-[#F7F8FA] border border-[#E4E7EB] p-5 hover:border-[#181E25] transition-colors">
            <div class="inline-flex h-10 w-10 rounded-xl gradient-purple items-center justify-center text-white">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                <path d="M12 2 2 7l10 5 10-5-10-5z" />
                <path d="m2 17 10 5 10-5" />
                <path d="m2 12 10 5 10-5" />
              </svg>
            </div>
            <h3 class="mt-3 text-[15px] font-bold text-[#181E25] tracking-tight">{i.title}</h3>
            <p class="mt-1.5 text-[13px] text-[#6E7782] leading-relaxed">{i.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- 部署信息 -->
    <div class="mt-12 text-center text-[13px] text-[#6E7782]">
      FluxA API 全球部署 · 中国大陆 / 北美 / 欧洲多区域 · SLA 99.9%
    </div>
  </div>
</section>
