---
import { siteConfig } from '@/lib/site-config';
---
<footer class="bg-[#0a0d12] text-white">
  <div class="container-fluid" style="padding-top: 80px; padding-bottom: 40px;">
    <!-- 顶部：品牌简介 + 4 列链接组 -->
    <div class="grid gap-12 md:grid-cols-[320px_1fr]">
      <!-- 左：logo + 简介 + CTA -->
      <div>
        <a href="/" class="inline-flex items-center gap-2.5" aria-label="FluxA 首页">
          <span class="inline-flex h-9 w-9 rounded-lg gradient-purple items-center justify-center">
            <img src="/retroarch.svg" alt="" class="h-4 w-4 brightness-0 invert" />
          </span>
          <span class="text-[20px] font-bold tracking-[-0.01em]">{siteConfig.brand.name}</span>
        </a>
        <p class="mt-5 text-[14px] text-white/60 leading-relaxed max-w-xs">
          AI 服务，一站搞定。<br />
          官方价 + 仅 $3 服务费，5 分钟到账、7×24 客服。
        </p>
        <a
          href="/contact"
          class="mt-6 inline-flex items-center justify-center h-11 px-6 rounded-full bg-white text-[#181E25] text-[13px] font-medium hover:opacity-90 transition-opacity"
        >
          联系客服 →
        </a>
      </div>

      <!-- 右：4 列链接组 -->
      <div class="grid gap-8 grid-cols-2 sm:grid-cols-4">
        <div>
          <div class="text-[12px] font-semibold text-white/40 uppercase tracking-[0.15em]">业务</div>
          <ul class="mt-4 space-y-2.5 text-[14px] text-white/80">
            <li><a href="/services/chatgpt" class="hover:text-white transition-colors">ChatGPT 充值</a></li>
            <li><a href="/services/claude" class="hover:text-white transition-colors">Claude 充值</a></li>
            <li><a href="/services/minimax" class="hover:text-white transition-colors">MiniMax Max 拼车</a></li>
            <li><a href="/services/ai-aggregator" class="hover:text-white transition-colors">AI 聚合</a></li>
          </ul>
        </div>
        <div>
          <div class="text-[12px] font-semibold text-white/40 uppercase tracking-[0.15em]">资源</div>
          <ul class="mt-4 space-y-2.5 text-[14px] text-white/80">
            <li><a href="/pricing" class="hover:text-white transition-colors">价格</a></li>
            <li><a href="/faq" class="hover:text-white transition-colors">常见问题</a></li>
            <li><a href="/blog" class="hover:text-white transition-colors">博客</a></li>
            <li><a href="/news" class="hover:text-white transition-colors">行业动态</a></li>
          </ul>
        </div>
        <div>
          <div class="text-[12px] font-semibold text-white/40 uppercase tracking-[0.15em]">公司</div>
          <ul class="mt-4 space-y-2.5 text-[14px] text-white/80">
            <li><a href="/about" class="hover:text-white transition-colors">关于我们</a></li>
            <li><a href="/careers" class="hover:text-white transition-colors">加入我们</a></li>
            <li><a href="/contact" class="hover:text-white transition-colors">联系我们</a></li>
            <li><a href={`mailto:${siteConfig.contact.email.address}`} class="hover:text-white transition-colors">商务合作</a></li>
          </ul>
        </div>
        <div>
          <div class="text-[12px] font-semibold text-white/40 uppercase tracking-[0.15em]">为什么选 FluxA</div>
          <ul class="mt-4 space-y-2.5 text-[14px] text-white/80">
            <li class="flex items-start gap-2"><span class="text-[#A36AFF]">✓</span>官方价透明</li>
            <li class="flex items-start gap-2"><span class="text-[#A36AFF]">✓</span>5 分钟到账</li>
            <li class="flex items-start gap-2"><span class="text-[#A36AFF]">✓</span>7×24 客服</li>
            <li class="flex items-start gap-2"><span class="text-[#A36AFF]">✓</span>仅 $3 服务费</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 底部：版权 + 备案 + 社交 -->
    <div class="mt-16 pt-6 border-t border-white/10 flex flex-col items-start justify-between gap-3 text-[12px] text-white/50 md:flex-row md:items-center">
      <div class="flex items-center gap-3">
        <span>© {new Date().getFullYear()} {siteConfig.brand.name}. All rights reserved.</span>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer" class="hover:text-white/80 transition-colors">
          {siteConfig.icp}
        </a>
      </div>
      <div class="flex items-center gap-5">
        <a href={siteConfig.contact.ticket.url} class="hover:text-white/80 transition-colors">GitHub</a>
        <a href={siteConfig.contact.ticket.url} class="hover:text-white/80 transition-colors">Twitter</a>
        <a href={`mailto:${siteConfig.contact.email.address}`} class="hover:text-white/80 transition-colors">Email</a>
      </div>
    </div>
  </div>
</footer>
