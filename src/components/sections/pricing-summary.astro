---
import { getCollection } from 'astro:content';
import { Button } from '@/components/ui/button';

const services = await getCollection('services');
const pricingEntries = await getCollection('pricing');

const representativeTiers = new Map<
  string,
  { name: string; price: string; period: string; originalPrice: string; ctaLabel: string }
>();
for (const entry of pricingEntries) {
  const slug = entry.data.service.id;
  const tier =
    entry.data.tiers.find((t) => t.recommended) ?? entry.data.tiers[0];
  representativeTiers.set(slug, {
    name: tier.name,
    price: tier.price,
    period: tier.period,
    originalPrice: tier.originalPrice ?? '',
    ctaLabel: tier.ctaLabel,
  });
}

const gradientMap: Record<string, string> = {
  chatgpt: 'gradient-blue',
  claude: 'gradient-purple',
  minimax: 'gradient-pink',
  'ai-aggregator': 'bg-[#181E25]',
};
---
<section class="py-24 bg-[#F7F8FA] border-t border-[#E4E7EB]">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-[clamp(2rem,5vw,3.5rem)] leading-[1.1] font-bold text-[#181E25] tracking-[-0.035em] text-balance">
        <span class="gradient-pink-text">官方价</span> + 仅 $3 人工费
      </h2>
      <p class="mt-5 text-[16px] text-[#6E7782]">每项业务挑出最受欢迎的一档，价格透明</p>
    </div>

    <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s) => {
        const tier = representativeTiers.get(s.data.slug);
        const g = gradientMap[s.data.slug] || 'gradient-purple';
        return (
          <div class="rounded-3xl bg-white border border-[#E4E7EB] p-6 card-hover flex flex-col">
            <div class={`inline-flex self-start h-7 px-3 rounded-full ${g} text-white text-[11px] font-semibold uppercase tracking-wider items-center`}>
              {s.data.name}
            </div>
            {tier && (
              <>
                <div class="mt-5 text-[40px] font-bold text-[#181E25] tracking-[-0.025em] tnum leading-none">
                  {tier.price}
                  {tier.period && <span class="text-[14px] font-normal text-[#6E7782] ml-1">{tier.period}</span>}
                </div>
                <div class="mt-2 text-[14px] text-[#181E25] font-semibold">{tier.name}</div>
                {tier.originalPrice && (
                  <div class="mt-1 text-[12px] text-[#6E7782] tnum">{tier.originalPrice}</div>
                )}
              </>
            )}
            <div class="mt-6 pt-4 border-t border-[#E4E7EB] mt-auto">
              <a href="/pricing" class="block text-center text-[14px] font-medium text-[#7A27FF] hover:opacity-80 transition-opacity">
                查看完整价格对比 →
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-12 flex justify-center">
      <a href="/pricing">
        <Button size="lg" className="rounded-full h-12 px-7 text-[15px] font-medium gradient-purple text-white hover:opacity-90 shadow-lg">
          查看所有套餐
        </Button>
      </a>
    </div>
  </div>
</section>
