---
import { getCollection } from 'astro:content';
import { Button } from '@/components/ui/button';

const services = await getCollection('services');
const pricingEntries = await getCollection('pricing');

const representativeTiers = new Map<
  string,
  { name: string; price: string; period: string; originalPrice: string; ctaLabel: string }
>();
for (const entry of pricingEntries) {
  const slug = entry.data.service.id;
  const tier =
    entry.data.tiers.find((t) => t.recommended) ?? entry.data.tiers[0];
  representativeTiers.set(slug, {
    name: tier.name,
    price: tier.price,
    period: tier.period,
    originalPrice: tier.originalPrice ?? '',
    ctaLabel: tier.ctaLabel,
  });
}
---
<section class="py-20 bg-[#0e0e10] border-t border-white/5 relative">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[12px] text-zinc-300 mb-5 backdrop-blur-md">
        <span class="h-1.5 w-1.5 rounded-full bg-[#5e6ad2]"></span>
        官方价 + 仅 $3 人工费
      </div>
      <h2 class="text-3xl md:text-[44px] leading-[1.1] font-semibold text-white tracking-[-0.02em] text-balance">套餐一览</h2>
      <p class="mt-4 text-zinc-400 text-base">每项业务挑出最受欢迎的一档，价格透明</p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s) => {
        const tier = representativeTiers.get(s.data.slug);
        return (
          <div class="card rounded-xl p-5 flex flex-col hover:border-[#5e6ad2]/50 transition-all">
            <div class="text-[13px] font-medium text-zinc-500 tracking-tight">{s.data.name}</div>
            {tier && (
              <>
                <div class="mt-2.5 text-[32px] font-semibold text-white tracking-[-0.015em] tnum leading-none">
                  {tier.price}
                  {tier.period && <span class="text-[13px] font-normal text-zinc-500 ml-0.5">{tier.period}</span>}
                </div>
                <div class="mt-2 text-[13px] text-zinc-300 font-medium">{tier.name}</div>
                {tier.originalPrice && (
                  <div class="mt-1 text-[11px] text-zinc-500 tnum">{tier.originalPrice}</div>
                )}
              </>
            )}
            <div class="mt-5 pt-4 border-t border-white/5 mt-auto">
              <a href="/pricing" class="block text-center text-[13px] font-medium text-[#5e6ad2] hover:text-[#c4c5f5] transition-colors">
                查看完整价格对比 →
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-12 flex justify-center">
      <a href="/pricing">
        <Button size="lg" className="rounded-lg h-11 px-5 text-[13px] font-medium bg-white text-[#08090a] hover:bg-zinc-200">
          查看所有套餐
        </Button>
      </a>
    </div>
  </div>
</section>
