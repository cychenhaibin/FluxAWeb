---
import { getCollection } from 'astro:content';
import { Button } from '@/components/ui/button';

const services = await getCollection('services');
const pricingEntries = await getCollection('pricing');

const representativeTiers = new Map<
  string,
  { name: string; price: string; period: string; originalPrice: string; ctaLabel: string }
>();
for (const entry of pricingEntries) {
  const slug = entry.data.service.id;
  const tier =
    entry.data.tiers.find((t) => t.recommended) ?? entry.data.tiers[0];
  representativeTiers.set(slug, {
    name: tier.name,
    price: tier.price,
    period: tier.period,
    originalPrice: tier.originalPrice ?? '',
    ctaLabel: tier.ctaLabel,
  });
}
---
<section class="py-20 bg-zinc-900 relative overflow-hidden">
  <div class="absolute top-1/2 left-0 w-[400px] h-[400px] bg-cyan-500/10 rounded-full blur-3xl -z-0"></div>

  <div class="container mx-auto max-w-6xl px-4 relative">
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-950/60 px-3 py-1 text-xs text-zinc-300 mb-5">
        <span class="h-1.5 w-1.5 rounded-full bg-cyan-400"></span>
        官方价 + 仅 $3 人工费
      </div>
      <h2 class="text-3xl md:text-[44px] leading-[1.1] font-semibold text-white tracking-[-0.03em] text-balance">套餐一览</h2>
      <p class="mt-4 text-zinc-400 text-base">每项业务挑出最受欢迎的一档，价格透明</p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s) => {
        const tier = representativeTiers.get(s.data.slug);
        return (
          <div class="backdrop-blur-md bg-zinc-950/60 border border-zinc-800 rounded-xl p-5 flex flex-col hover:border-zinc-700 transition-all">
            <div class="text-[13px] font-medium text-zinc-400 tracking-tight">{s.data.name}</div>
            {tier && (
              <>
                <div class="mt-2.5 text-[28px] font-semibold text-white tracking-[-0.02em] tnum">
                  {tier.price}
                  {tier.period && <span class="text-[13px] font-normal text-zinc-500 ml-0.5">{tier.period}</span>}
                </div>
                <div class="mt-1.5 text-[13px] text-zinc-300">{tier.name}</div>
                {tier.originalPrice && (
                  <div class="mt-0.5 text-[11px] text-zinc-500 tnum">{tier.originalPrice}</div>
                )}
              </>
            )}
            <div class="mt-5 pt-3.5 border-t border-zinc-800/60 mt-auto">
              <a href="/pricing" class="block text-center text-[13px] font-medium text-indigo-400 hover:text-indigo-300 transition-colors">
                查看完整价格对比 →
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-12 flex justify-center">
      <a href="/pricing">
        <Button size="lg" className="rounded-full h-11 px-6 text-[13px] font-medium bg-white text-zinc-950 hover:bg-zinc-200">
          查看所有套餐
        </Button>
      </a>
    </div>
  </div>
</section>
