---
import { getCollection } from 'astro:content';
import { Button } from '@/components/ui/button';

const services = await getCollection('services');
const pricingEntries = await getCollection('pricing');

const representativeTiers = new Map<
  string,
  { name: string; price: string; period: string; originalPrice: string; ctaLabel: string }
>();
for (const entry of pricingEntries) {
  const slug = entry.data.service.id;
  const tier = entry.data.tiers.find((t) => t.recommended) ?? entry.data.tiers[0];
  representativeTiers.set(slug, {
    name: tier.name,
    price: tier.price,
    period: tier.period,
    originalPrice: tier.originalPrice ?? '',
    ctaLabel: tier.ctaLabel,
  });
}

const tagMap: Record<string, { label: string; gradient: string }> = {
  chatgpt: { label: 'CHATGPT', gradient: 'gradient-blue' },
  claude: { label: 'CLAUDE', gradient: 'gradient-purple' },
  minimax: { label: 'MAX', gradient: 'gradient-pink' },
  'ai-aggregator': { label: 'AI', gradient: 'bg-[#181E25]' },
};
---
<section class="py-24 bg-[#F7F8FA]">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.05] font-bold text-[#181E25] tracking-[-0.04em] text-balance">
        热门套餐
      </h2>
      <p class="mt-5 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed">
        官方价 + 仅 $3 人工费 · 5 分钟极速到账
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {services.map((s) => {
        const tier = representativeTiers.get(s.data.slug);
        const tag = tagMap[s.data.slug] || tagMap['ai-aggregator'];
        return (
          <a
            href={`/services/${s.data.slug}`}
            class="group rounded-3xl bg-white border border-[#E4E7EB] p-6 hover:border-[#181E25] transition-all flex flex-col"
          >
            <div class={`inline-flex self-start h-7 px-3 rounded-full ${tag.gradient} text-white text-[10px] font-bold uppercase tracking-[0.2em] items-center`}>
              {tag.label}
            </div>
            {tier && (
              <>
                <div class="mt-6 text-[40px] font-bold text-[#181E25] tracking-[-0.025em] tnum leading-none">
                  {tier.price}
                  {tier.period && <span class="text-[14px] font-normal text-[#6E7782] ml-1">{tier.period}</span>}
                </div>
                <div class="mt-3 text-[14px] text-[#181E25] font-semibold">{tier.name}</div>
                {tier.originalPrice && (
                  <div class="mt-1 text-[12px] text-[#6E7782] tnum">{tier.originalPrice}</div>
                )}
              </>
            )}
            <div class="mt-auto pt-6 flex items-center justify-between text-[12px] text-[#6E7782]">
              <span>2026</span>
              <span class="text-[#181E25] font-medium group-hover:text-[#7A27FF] transition-colors">查看详情 ›</span>
            </div>
          </a>
        );
      })}
    </div>

    <div class="mt-12 flex justify-center">
      <a href="/pricing">
        <Button className="rounded-full h-12 px-7 text-[15px] font-medium border border-[#E4E7EB] bg-white text-[#181E25] hover:border-[#181E25]">
          查看全部套餐 →
        </Button>
      </a>
    </div>
  </div>
</section>
