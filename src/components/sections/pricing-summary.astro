---
import { getCollection } from 'astro:content';
import { Button } from '@/components/ui/button';

const services = await getCollection('services');
const pricingEntries = await getCollection('pricing');

const representativeTiers = new Map<
  string,
  { name: string; price: string; period: string; originalPrice: string; ctaLabel: string }
>();
for (const entry of pricingEntries) {
  const slug = entry.data.service.id;
  const tier =
    entry.data.tiers.find((t) => t.recommended) ?? entry.data.tiers[0];
  representativeTiers.set(slug, {
    name: tier.name,
    price: tier.price,
    period: tier.period,
    originalPrice: tier.originalPrice ?? '',
    ctaLabel: tier.ctaLabel,
  });
}
---
<section class="py-20 mesh-soft relative">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full bg-white/80 border border-black/5 px-3 py-1 text-[12px] text-zinc-600 mb-5 shadow-apple">
        <span class="h-1.5 w-1.5 rounded-full bg-[#06b6d4]"></span>
        官方价 + 仅 $3 人工费
      </div>
      <h2 class="text-3xl md:text-[44px] leading-[1.15] font-semibold text-zinc-900 tracking-[-0.02em] text-balance">
        套餐 <span class="text-gradient">一览</span>
      </h2>
      <p class="mt-4 text-zinc-600 text-base">每项业务挑出最受欢迎的一档，价格透明</p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s) => {
        const tier = representativeTiers.get(s.data.slug);
        return (
          <div class="glass rounded-3xl p-6 flex flex-col hover:bg-white/70 transition-all">
            <div class="text-[13px] font-medium text-zinc-500 tracking-tight">{s.data.name}</div>
            {tier && (
              <>
                <div class="mt-2.5 text-[32px] font-semibold text-zinc-900 tracking-[-0.005em] tnum leading-none">
                  {tier.price}
                  {tier.period && <span class="text-[13px] font-normal text-zinc-500 ml-0.5">{tier.period}</span>}
                </div>
                <div class="mt-2 text-[13px] text-zinc-700 font-medium">{tier.name}</div>
                {tier.originalPrice && (
                  <div class="mt-1 text-[11px] text-zinc-500 tnum">{tier.originalPrice}</div>
                )}
              </>
            )}
            <div class="mt-5 pt-4 border-t border-black/5 mt-auto">
              <a href="/pricing" class="block text-center text-[13px] font-medium text-[#0071e3] hover:text-[#0077ed] transition-colors">
                查看完整价格对比 →
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-12 flex justify-center">
      <a href="/pricing">
        <Button size="lg" className="rounded-full h-11 px-6 text-[13px] font-medium bg-gradient-to-r from-[#8b5cf6] via-[#ec4899] to-[#f97316] text-white hover:opacity-90 shadow-apple">
          查看所有套餐
        </Button>
      </a>
    </div>
  </div>
</section>
