---
import { getCollection } from 'astro:content';

const services = await getCollection('services');

// 3 旗舰：Max 拼车 (主推大卡) + ChatGPT 充值 + Claude 充值
// minimaxi.com 旗舰结构 (1:1 复刻):
// - 整张卡片是 bg-[#F7F8FA] 浅灰底, 圆角 rounded-3xl
// - 大卡: 顶部 16:9 渐变视觉区 (大文字 overlay) + 下方文字块
// - 小卡: 横向 split — 左侧文字 + 右侧方形渐变视觉区
const svcMax = services.find((s) => s.data.slug === 'minimax');
const svcChatGPT = services.find((s) => s.data.slug === 'chatgpt');
const svcClaude = services.find((s) => s.data.slug === 'claude');
---
<section class="py-24 bg-white">
  <div class="container-fluid">
    <!-- 标题区 -->
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="heading-display text-[clamp(2.5rem,6vw,4.5rem)] text-balance">
        旗舰 <span class="gradient-purple-text">服务</span>
      </h2>
      <p class="mt-5 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed">
        官方价 + 仅 $3 服务费 · 5 分钟到账 · FluxA 3 块旗舰业务
      </p>
    </div>

    <!--
      2-col outer grid: 大卡 (col 1, row-span-2) + 2 小卡 (col 2, 堆叠)
      整张卡片: bg-[#F7F8FA] 浅灰底 + rounded-3xl
    -->
    <div class="mt-16 grid grid-cols-1 lg:grid-cols-2 gap-5 max-w-[1200px] mx-auto">
      <!--
        (1) 大卡: MiniMax Max 拼车
        - 浅灰底 rounded-3xl 卡片
        - 顶部: 16:9 渐变视觉区 (居中 "Max 拼车" 大字)
        - 下方: 文字块 (title + 副 + date + 了解更多)
      -->
      {svcMax && (
        <a
          href={`/services/${svcMax.data.slug}`}
          class="group block lg:row-span-2"
        >
          <div class="bg-[#F7F8FA] rounded-3xl p-3 md:p-4 h-full flex flex-col">
            <!-- 视觉区: 16:9 渐变 (max-w 1100 - 24px - 2×3px padding = ~540) -->
            <div class="relative aspect-[16/9] rounded-2xl gradient-pink overflow-hidden flex items-center justify-center p-6 text-white">
              <!-- 装饰圆 -->
              <div class="absolute inset-0 pointer-events-none">
                <div class="absolute -top-10 -right-10 w-48 h-48 rounded-full bg-white/10 blur-3xl"></div>
                <div class="absolute bottom-5 -left-5 w-32 h-32 rounded-full bg-white/15 blur-2xl"></div>
              </div>
              <!-- 居中大文字 -->
              <div class="relative z-[2] text-[clamp(2rem,4.5vw,3.5rem)] font-bold tracking-[-0.04em] leading-[0.95] text-center text-balance">
                Max<br />拼车
              </div>
            </div>
            <!-- 文字块 -->
            <div class="mt-4 px-3 pb-2 flex-1 flex flex-col">
              <h3 class="text-[22px] md:text-[24px] font-bold text-[#181E25] tracking-tight">{svcMax.data.name}</h3>
              <p class="mt-2 text-[14px] text-[#6E7782] leading-relaxed text-balance">
                {svcMax.data.showcase?.description ?? svcMax.data.tagline}
              </p>
              <div class="mt-auto pt-4 flex items-center gap-4 text-[13px]">
                <span class="text-[#AAB1BA]">2026-08-13</span>
                <span class="text-[#AAB1BA] group-hover:text-[#181E25] transition-colors">了解更多 &gt;</span>
              </div>
            </div>
          </div>
        </a>
      )}

      <!--
        (2) 小卡: ChatGPT 充值
        - 浅灰底 rounded-3xl 卡片
        - 横向 split: 左侧文字 (flex-1) + 右侧方形渐变视觉区 (w-[55%])
      -->
      {svcChatGPT && (
        <a
          href={`/services/${svcChatGPT.data.slug}`}
          class="group block"
        >
          <div class="bg-[#F7F8FA] rounded-3xl p-3 md:p-4 h-full">
            <div class="flex gap-3 md:gap-4 h-full">
              <!-- 左侧文字 -->
              <div class="flex-1 flex flex-col justify-between min-w-0 p-3 md:p-4">
                <div>
                  <h3 class="text-[20px] md:text-[22px] font-bold text-[#181E25] tracking-tight">{svcChatGPT.data.name}</h3>
                  <p class="mt-2 text-[13px] md:text-[14px] text-[#6E7782] leading-relaxed text-balance">
                    {svcChatGPT.data.showcase?.description ?? svcChatGPT.data.tagline}
                  </p>
                </div>
                <div class="mt-auto pt-3 flex items-center gap-3 text-[12px] md:text-[13px]">
                  <span class="text-[#AAB1BA]">2026-07-25</span>
                  <span class="text-[#AAB1BA] group-hover:text-[#181E25] transition-colors">了解更多 &gt;</span>
                </div>
              </div>
              <!-- 右侧视觉区 (1:1 方形, 跟 minimaxi 一致) -->
              <div class="relative w-[55%] aspect-square rounded-2xl gradient-blue overflow-hidden flex items-center justify-center p-4 text-white shrink-0">
                <div class="absolute inset-0 pointer-events-none">
                  <div class="absolute -top-6 -right-6 w-24 h-24 rounded-full bg-white/15 blur-2xl"></div>
                  <div class="absolute bottom-3 -left-3 w-20 h-20 rounded-full bg-white/10 blur-2xl"></div>
                </div>
                <div class="relative z-[2] text-[clamp(1.25rem,2.5vw,1.875rem)] font-bold tracking-[-0.04em] leading-[1.05] text-center">
                  ChatGPT<br />充值
                </div>
              </div>
            </div>
          </div>
        </a>
      )}

      <!--
        (3) 小卡: Claude 充值 (同 ChatGPT 模式, 横向 split)
      -->
      {svcClaude && (
        <a
          href={`/services/${svcClaude.data.slug}`}
          class="group block"
        >
          <div class="bg-[#F7F8FA] rounded-3xl p-3 md:p-4 h-full">
            <div class="flex gap-3 md:gap-4 h-full">
              <!-- 左侧文字 -->
              <div class="flex-1 flex flex-col justify-between min-w-0 p-3 md:p-4">
                <div>
                  <h3 class="text-[20px] md:text-[22px] font-bold text-[#181E25] tracking-tight">{svcClaude.data.name}</h3>
                  <p class="mt-2 text-[13px] md:text-[14px] text-[#6E7782] leading-relaxed text-balance">
                    {svcClaude.data.showcase?.description ?? svcClaude.data.tagline}
                  </p>
                </div>
                <div class="mt-auto pt-3 flex items-center gap-3 text-[12px] md:text-[13px]">
                  <span class="text-[#AAB1BA]">2026-08-05</span>
                  <span class="text-[#AAB1BA] group-hover:text-[#181E25] transition-colors">了解更多 &gt;</span>
                </div>
              </div>
              <!-- 右侧视觉区 (1:1 方形, 跟 minimaxi 一致) -->
              <div class="relative w-[55%] aspect-square rounded-2xl gradient-claude overflow-hidden flex items-center justify-center p-4 text-white shrink-0">
                <div class="absolute inset-0 pointer-events-none">
                  <div class="absolute -top-6 -right-6 w-24 h-24 rounded-full bg-white/15 blur-2xl"></div>
                  <div class="absolute bottom-3 -left-3 w-20 h-20 rounded-full bg-white/10 blur-2xl"></div>
                </div>
                <div class="relative z-[2] text-[clamp(1.25rem,2.5vw,1.875rem)] font-bold tracking-[-0.04em] leading-[1.05] text-center">
                  Claude<br />充值
                </div>
              </div>
            </div>
          </div>
        </a>
      )}
    </div>
  </div>
</section>
