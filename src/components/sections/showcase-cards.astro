---
import { getCollection } from 'astro:content';

const services = await getCollection('services');

// 6 张卡：card 1 = MiniMax Max 拼车（主推）大卡 row-span-2
// card 2-3 = ChatGPT / Claude
// card 4 = AI 聚合
// card 5 = 价格对比入口
// card 6 = 团队账号
const svcMax = services.find((s) => s.data.slug === 'minimax');
const svcChatGPT = services.find((s) => s.data.slug === 'chatgpt');
const svcClaude = services.find((s) => s.data.slug === 'claude');
const svcAI = services.find((s) => s.data.slug === 'ai-aggregator');

// gradient map (minimaxi.com 风格: 紫 / 蓝 / 赤土 / 粉橙)
const gradientMap: Record<string, string> = {
  chatgpt: 'gradient-blue',
  claude: 'gradient-purple',
  minimax: 'gradient-pink',
  'ai-aggregator': 'bg-[#181E25]',
};
const gradientTextMap: Record<string, string> = {
  chatgpt: 'gradient-blue-text',
  claude: 'gradient-purple-text',
  minimax: 'gradient-pink-text',
  'ai-aggregator': 'text-white',
};
---
<section class="py-24 bg-white">
  <div class="container-fluid">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="heading-display text-[clamp(2.5rem,6vw,4.5rem)] text-balance">
        旗舰 <span class="gradient-purple-text">服务</span>
      </h2>
      <p class="mt-5 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed">
        4 块业务一站搞定 · 官方价 + 仅 $3 服务费 · 5 分钟到账
      </p>
    </div>

    <!-- 2x3 grid (1 大图 + 4 普通卡) -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- (1,1) + (2,1) 左大图 row-span-2：MiniMax Max 拼车 -->
      {svcMax && (
        <a
          href={`/services/${svcMax.data.slug}`}
          class="group md:row-span-2 relative aspect-square rounded-3xl gradient-pink overflow-hidden flex flex-col items-start justify-between p-8 text-white hover:scale-[1.01] transition-transform"
        >
          <!-- 装饰圆 -->
          <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/10 blur-3xl"></div>
          <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-[#7A27FF]/30 blur-3xl"></div>
          <div class="absolute bottom-10 -left-10 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>

          <!-- 左上角 icon 盒 -->
          <div class="relative z-[2] w-14 h-14 rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 text-white">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          </div>

          <!-- 大白字 (底部) -->
          <div class="relative z-[2] text-[clamp(2.5rem,6vw,5.5rem)] font-bold tracking-[-0.04em] leading-[0.9] text-balance">
            Max<br />拼车
          </div>
        </a>
      )}

      <!-- (1,2) 中上图：ChatGPT 充值 (蓝渐变) -->
      {svcChatGPT && (
        <a
          href={`/services/${svcChatGPT.data.slug}`}
          class="group relative aspect-square rounded-3xl gradient-blue overflow-hidden flex items-center justify-center hover:scale-[1.01] transition-transform"
        >
          <div class="absolute -top-8 -right-8 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>
          <img src="/icons/openai.svg" alt="OpenAI" class="relative z-10 w-24 h-24 md:w-32 md:h-32 brightness-0 invert" />
        </a>
      )}

      <!-- (1,3) 右上图：Claude 充值 (紫渐变) -->
      {svcClaude && (
        <a
          href={`/services/${svcClaude.data.slug}`}
          class="group relative aspect-square rounded-3xl gradient-purple overflow-hidden flex items-center justify-center hover:scale-[1.01] transition-transform"
        >
          <div class="absolute -top-8 -right-8 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>
          <img src="/icons/anthropic.svg" alt="Anthropic" class="relative z-10 w-24 h-24 md:w-32 md:h-32 brightness-0 invert" />
        </a>
      )}

      <!-- (2,2) 中下图：ChatGPT 文字卡 -->
      {svcChatGPT && (
        <div class="aspect-square rounded-3xl bg-white border border-[#E4E7EB] p-6 md:p-7 flex flex-col">
          <h3 class="text-[24px] md:text-[28px] font-bold text-[#181E25] tracking-tight leading-tight text-balance">
            {svcChatGPT.data.name}
          </h3>
          <p class="mt-2 text-[14px] text-[#6E7782] leading-relaxed text-balance">
            {svcChatGPT.data.tagline}
          </p>
          <div class="mt-auto pt-6 flex items-center gap-3 text-[12px] text-[#6E7782]">
            <span>$23 / 月起</span>
            <a href={`/services/${svcChatGPT.data.slug}`} class="text-[#181E25] font-medium hover:text-[#7A27FF] transition-colors ml-auto">了解更多 &gt;</a>
          </div>
        </div>
      )}

      <!-- (2,3) 右下图：Claude 文字卡 -->
      {svcClaude && (
        <div class="aspect-square rounded-3xl bg-white border border-[#E4E7EB] p-6 md:p-7 flex flex-col">
          <h3 class="text-[24px] md:text-[28px] font-bold text-[#181E25] tracking-tight leading-tight text-balance">
            {svcClaude.data.name}
          </h3>
          <p class="mt-2 text-[14px] text-[#6E7782] leading-relaxed text-balance">
            {svcClaude.data.tagline}
          </p>
          <div class="mt-auto pt-6 flex items-center gap-3 text-[12px] text-[#6E7782]">
            <span>$23 / 月起</span>
            <a href={`/services/${svcClaude.data.slug}`} class="text-[#181E25] font-medium hover:text-[#7A27FF] transition-colors ml-auto">了解更多 &gt;</a>
          </div>
        </div>
      )}
    </div>

    <!-- 大图下方文字 (跟 row-span-2 大图对齐) -->
    {svcMax && (
      <div class="mt-6 grid md:grid-cols-3 gap-6">
        <div>
          <h3 class="text-[22px] font-bold text-[#181E25] tracking-tight">{svcMax.data.name}</h3>
          <p class="mt-2 text-[14px] text-[#6E7782] leading-relaxed text-balance">
            {svcMax.data.description}
          </p>
          <div class="mt-3 flex items-center gap-4 text-[12px] text-[#6E7782]">
            <span>$28 / 月/人起</span>
            <a href={`/services/${svcMax.data.slug}`} class="text-[#181E25] font-medium hover:text-[#7A27FF] transition-colors">了解更多 &gt;</a>
          </div>
        </div>
      </div>
    )}

    <!-- AI 聚合 + 价格入口 (2 张横向卡) -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      {svcAI && (
        <a
          href={`/services/${svcAI.data.slug}`}
          class="group rounded-3xl bg-[#181E25] text-white p-8 flex items-center justify-between hover:scale-[1.01] transition-transform overflow-hidden relative"
        >
          <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-white/5 blur-2xl"></div>
          <div class="relative z-10">
            <div class="text-[11px] uppercase tracking-[0.2em] text-white/60 font-semibold">AI 聚合</div>
            <h3 class="mt-2 text-[24px] md:text-[28px] font-bold tracking-tight">{svcAI.data.name}</h3>
            <p class="mt-2 text-[14px] text-white/70 max-w-md leading-relaxed">
              统一 API · 统一 UI · GPT-4o + Claude + Gemini 全模型
            </p>
          </div>
          <div class="relative z-10 shrink-0 text-[14px] text-white/80 group-hover:translate-x-1 transition-transform">
            →
          </div>
        </a>
      )}
      <a
        href="/pricing"
        class="group rounded-3xl bg-[#F7F8FA] text-[#181E25] p-8 flex items-center justify-between hover:scale-[1.01] transition-transform"
      >
        <div>
          <div class="text-[11px] uppercase tracking-[0.2em] text-[#6E7782] font-semibold">价格</div>
          <h3 class="mt-2 text-[24px] md:text-[28px] font-bold tracking-tight">查看全部套餐</h3>
          <p class="mt-2 text-[14px] text-[#6E7782] max-w-md leading-relaxed">
            4 块业务 · 12 个套餐 · 官方价 + 仅 $3 服务费
          </p>
        </div>
        <div class="shrink-0 text-[14px] text-[#6E7782] group-hover:translate-x-1 transition-transform">
          →
        </div>
      </a>
    </div>
  </div>
</section>
