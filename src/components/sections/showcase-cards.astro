---
import { getCollection } from 'astro:content';

const services = await getCollection('services');

// 3 旗舰：Max 拼车 (主推大卡) + ChatGPT 充值 + Claude 充值
// minimaxi.com 旗舰 cards 模式：1 大 (col-span-2 row-span-2) + 2 小 (右列堆叠)
const svcMax = services.find((s) => s.data.slug === 'minimax');
const svcChatGPT = services.find((s) => s.data.slug === 'chatgpt');
const svcClaude = services.find((s) => s.data.slug === 'claude');
---
<section class="py-24 bg-white">
  <div class="container-fluid">
    <!-- 标题区 (minimaxi.com 风格: 居中 + 大字) -->
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="heading-display text-[clamp(2.5rem,6vw,4.5rem)] text-balance">
        旗舰 <span class="gradient-purple-text">服务</span>
      </h2>
      <p class="mt-5 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed">
        官方价 + 仅 $3 服务费 · 5 分钟到账 · FluxA 3 块旗舰业务
      </p>
    </div>

    <!-- 2-col outer grid: 大卡 (col 1, 2 rows) + 2 小卡 (col 2, stacked) -->
    <div class="mt-16 grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- (1) 大卡: MiniMax Max 拼车 -->
      {svcMax && (
        <a
          href={`/services/${svcMax.data.slug}`}
          class="group block lg:row-span-2"
        >
          <!-- 视觉区 (大, 渐变 + 大字 overlay, minimaxi 风格) -->
          <div class="relative aspect-[4/3] lg:aspect-auto lg:h-full min-h-[360px] rounded-3xl gradient-pink overflow-hidden flex flex-col items-start justify-between p-8 md:p-10 text-white">
            <!-- 装饰圆 (minimaxi 风格模糊光斑) -->
            <div class="absolute inset-0 pointer-events-none">
              <div class="absolute -top-20 -right-20 w-72 h-72 rounded-full bg-white/10 blur-3xl"></div>
              <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-[#7A27FF]/30 blur-3xl"></div>
              <div class="absolute bottom-10 -left-10 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>
            </div>
            <!-- 角标 (左上) -->
            <div class="relative z-[2] text-[11px] uppercase tracking-[0.3em] font-semibold opacity-90">
              {svcMax.data.showcase?.badge ?? 'MAX 拼车'}
            </div>
            <!-- 大字 (底部, overlay 风格) -->
            <div class="relative z-[2] text-[clamp(2.5rem,7vw,5.5rem)] font-bold tracking-[-0.04em] leading-[0.9] text-balance">
              Max<br />拼车
            </div>
          </div>
          <!-- 下方文字块 (minimaxi 风格: name + 副 + 日期 + 了解更多) -->
          <div class="mt-5">
            <h3 class="text-[22px] md:text-[24px] font-bold text-[#181E25] tracking-tight">{svcMax.data.name}</h3>
            <p class="mt-2 text-[14px] text-[#6E7782] leading-relaxed text-balance">
              {svcMax.data.showcase?.description ?? svcMax.data.tagline}
            </p>
            <div class="mt-3 flex items-center gap-4 text-[13px]">
              <span class="text-[#6E7782]">2026-08-13</span>
              <span class="text-[#181E25] font-medium group-hover:text-[#7A27FF] transition-colors">了解更多 &gt;</span>
            </div>
          </div>
        </a>
      )}

      <!-- (2) 小卡: ChatGPT 充值 -->
      {svcChatGPT && (
        <a
          href={`/services/${svcChatGPT.data.slug}`}
          class="group block"
        >
          <!-- 视觉区 (4:3, 渐变 + logo + 文字 overlay) -->
          <div class="relative aspect-[4/3] rounded-3xl gradient-blue overflow-hidden flex flex-col items-start justify-between p-7 md:p-9 text-white">
            <div class="absolute inset-0 pointer-events-none">
              <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>
              <div class="absolute bottom-5 -left-5 w-32 h-32 rounded-full bg-white/10 blur-2xl"></div>
            </div>
            <div class="relative z-[2] text-[11px] uppercase tracking-[0.3em] font-semibold opacity-90">
              {svcChatGPT.data.showcase?.badge ?? 'CHATGPT'}
            </div>
            <div class="relative z-[2] flex items-end gap-3">
              <img src="/icons/openai.svg" alt="OpenAI" class="h-16 w-16 md:h-20 md:w-20 brightness-0 invert" />
              <div class="text-[clamp(2rem,5vw,3.5rem)] font-bold tracking-[-0.04em] leading-[0.9] text-balance">
                充值
              </div>
            </div>
          </div>
          <!-- 下方文字块 -->
          <div class="mt-5">
            <h3 class="text-[20px] md:text-[22px] font-bold text-[#181E25] tracking-tight">{svcChatGPT.data.name}</h3>
            <p class="mt-2 text-[14px] text-[#6E7782] leading-relaxed text-balance">
              {svcChatGPT.data.showcase?.description ?? svcChatGPT.data.tagline}
            </p>
            <div class="mt-3 flex items-center gap-4 text-[13px]">
              <span class="text-[#6E7782]">2026-07-25</span>
              <span class="text-[#181E25] font-medium group-hover:text-[#7A27FF] transition-colors">了解更多 &gt;</span>
            </div>
          </div>
        </a>
      )}

      <!-- (3) 小卡: Claude 充值 -->
      {svcClaude && (
        <a
          href={`/services/${svcClaude.data.slug}`}
          class="group block"
        >
          <!-- 视觉区 (4:3, 渐变 + logo + 文字 overlay) -->
          <div class="relative aspect-[4/3] rounded-3xl gradient-claude overflow-hidden flex flex-col items-start justify-between p-7 md:p-9 text-white">
            <div class="absolute inset-0 pointer-events-none">
              <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>
              <div class="absolute bottom-5 -left-5 w-32 h-32 rounded-full bg-white/10 blur-2xl"></div>
            </div>
            <div class="relative z-[2] text-[11px] uppercase tracking-[0.3em] font-semibold opacity-90">
              {svcClaude.data.showcase?.badge ?? 'CLAUDE'}
            </div>
            <div class="relative z-[2] flex items-end gap-3">
              <img src="/icons/anthropic.svg" alt="Anthropic" class="h-16 w-16 md:h-20 md:w-20 brightness-0 invert" />
              <div class="text-[clamp(2rem,5vw,3.5rem)] font-bold tracking-[-0.04em] leading-[0.9] text-balance">
                充值
              </div>
            </div>
          </div>
          <!-- 下方文字块 -->
          <div class="mt-5">
            <h3 class="text-[20px] md:text-[22px] font-bold text-[#181E25] tracking-tight">{svcClaude.data.name}</h3>
            <p class="mt-2 text-[14px] text-[#6E7782] leading-relaxed text-balance">
              {svcClaude.data.showcase?.description ?? svcClaude.data.tagline}
            </p>
            <div class="mt-3 flex items-center gap-4 text-[13px]">
              <span class="text-[#6E7782]">2026-08-05</span>
              <span class="text-[#181E25] font-medium group-hover:text-[#7A27FF] transition-colors">了解更多 &gt;</span>
            </div>
          </div>
        </a>
      )}
    </div>
  </div>
</section>
