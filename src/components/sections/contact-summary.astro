---
import { siteConfig } from '@/lib/site-config';
import { Button } from '@/components/ui/button';
import Icon from '@/components/icon.astro';

interface Channel {
  key: string;
  name: string;
  iconName: string;
  detail: string;
  href?: string;
  external?: boolean;
}

const channels: Channel[] = [
  {
    key: 'wechat',
    name: siteConfig.contact.wechat.name,
    iconName: 'MessageCircle',
    detail: '扫码添加客服微信，工作日 5 分钟内响应',
  },
  {
    key: 'email',
    name: siteConfig.contact.email.name,
    iconName: 'Mail',
    detail: siteConfig.contact.email.address,
    href: `mailto:${siteConfig.contact.email.address}`,
  },
  {
    key: 'ticket',
    name: siteConfig.contact.ticket.name,
    iconName: 'Ticket',
    detail: '提交工单后工程师会在 1 小时内响应',
    href: siteConfig.contact.ticket.url,
    external: true,
  },
];
---
<section class="py-20 bg-white">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-[#fafafa] px-3 py-1 text-[12px] text-zinc-700 mb-5">
        <span class="h-1.5 w-1.5 rounded-full bg-zinc-900"></span>
        真人值守
      </div>
      <h2 class="text-3xl md:text-[44px] leading-[1.15] font-semibold text-zinc-900 tracking-[-0.02em] text-balance">联系我们</h2>
      <p class="mt-4 text-zinc-600 text-base">三种方式挑一个最方便的，7×24 都有真人</p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-3">
      {channels.map((c) => {
        const body = (
          <article class="h-full bg-white border border-zinc-200 rounded-2xl p-6 flex flex-col items-start hover:border-zinc-900 hover:shadow-ink transition-all">
            <div class="h-11 w-11 rounded-xl bg-zinc-900 flex items-center justify-center">
              <Icon name={c.iconName} class="text-white" size={22} />
            </div>
            <h3 class="mt-3.5 text-[15px] font-semibold text-zinc-900 tracking-tight">{c.name}</h3>
            <p class="mt-1.5 text-[13px] text-zinc-600 flex-1 leading-relaxed">{c.detail}</p>
          </article>
        );
        return c.href ? (
          <a
            href={c.href}
            target={c.external ? '_blank' : undefined}
            rel={c.external ? 'noopener noreferrer' : undefined}
            class="block"
          >
            {body}
          </a>
        ) : (
          body
        );
      })}
    </div>

    <div class="mt-12 flex justify-center">
      <a href="/contact">
        <Button size="lg" className="rounded-full h-11 px-6 text-[13px] font-medium bg-zinc-900 text-white hover:bg-zinc-800">
          联系我们
        </Button>
      </a>
    </div>
  </div>
</section>
