---
import { siteConfig } from '@/lib/site-config';
import { Button } from '@/components/ui/button';
import Icon from '@/components/icon.astro';

interface Channel {
  key: string;
  name: string;
  iconName: string;
  detail: string;
  href?: string;
  external?: boolean;
}

const channels: Channel[] = [
  {
    key: 'wechat',
    name: siteConfig.contact.wechat.name,
    iconName: 'MessageCircle',
    detail: '扫码添加客服微信，工作日 5 分钟内响应',
  },
  {
    key: 'email',
    name: siteConfig.contact.email.name,
    iconName: 'Mail',
    detail: siteConfig.contact.email.address,
    href: `mailto:${siteConfig.contact.email.address}`,
  },
  {
    key: 'ticket',
    name: siteConfig.contact.ticket.name,
    iconName: 'Ticket',
    detail: '提交工单后工程师会在 1 小时内响应',
    href: siteConfig.contact.ticket.url,
    external: true,
  },
];
---
<section class="py-24 bg-zinc-900 relative overflow-hidden">
  <div class="absolute top-1/2 right-0 w-[500px] h-[500px] bg-indigo-500/10 rounded-full blur-3xl -z-0"></div>

  <div class="container mx-auto max-w-6xl px-4 relative">
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-950/50 px-3 py-1 text-xs text-zinc-400 mb-6">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
        真人值守
      </div>
      <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tighter">联系我们</h2>
      <p class="mt-4 text-zinc-400 text-lg">三种方式挑一个最方便的，7×24 都有真人</p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-3">
      {channels.map((c) => {
        const body = (
          <article class="h-full backdrop-blur-md bg-zinc-950/60 border border-zinc-800 rounded-2xl p-6 flex flex-col items-start hover:border-zinc-700 transition-all">
            <div class="h-12 w-12 rounded-xl bg-gradient-to-br from-indigo-500/20 to-cyan-500/20 border border-indigo-500/30 flex items-center justify-center">
              <Icon name={c.iconName} class="text-indigo-300" size={24} />
            </div>
            <h3 class="mt-4 text-lg font-semibold text-white">{c.name}</h3>
            <p class="mt-2 text-sm text-zinc-400 flex-1">{c.detail}</p>
          </article>
        );
        return c.href ? (
          <a
            href={c.href}
            target={c.external ? '_blank' : undefined}
            rel={c.external ? 'noopener noreferrer' : undefined}
            class="block"
          >
            {body}
          </a>
        ) : (
          body
        );
      })}
    </div>

    <div class="mt-12 flex justify-center">
      <a href="/contact">
        <Button size="lg" className="rounded-full h-12 px-8 bg-white text-zinc-950 hover:bg-zinc-200">
          联系我们
        </Button>
      </a>
    </div>
  </div>
</section>
