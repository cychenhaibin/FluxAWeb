---
import { siteConfig } from '@/lib/site-config';
import { Button } from '@/components/ui/button';
import Icon from '@/components/icon.astro';

interface Channel {
  key: string;
  name: string;
  iconName: string;
  detail: string;
  href?: string;
  external?: boolean;
}

const channels: Channel[] = [
  {
    key: 'wechat',
    name: siteConfig.contact.wechat.name,
    iconName: 'MessageCircle',
    detail: '扫码添加客服微信，工作日 5 分钟内响应',
  },
  {
    key: 'email',
    name: siteConfig.contact.email.name,
    iconName: 'Mail',
    detail: siteConfig.contact.email.address,
    href: `mailto:${siteConfig.contact.email.address}`,
  },
  {
    key: 'ticket',
    name: siteConfig.contact.ticket.name,
    iconName: 'Ticket',
    detail: '提交工单后工程师会在 1 小时内响应',
    href: siteConfig.contact.ticket.url,
    external: true,
  },
];

const gradientMap: Record<string, string> = {
  wechat: 'gradient-pink',
  email: 'gradient-purple',
  ticket: 'gradient-blue',
};
---
<section class="py-24 bg-[#F7F8FA] border-t border-[#E4E7EB]">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-[clamp(2rem,5vw,3.5rem)] leading-[1.1] font-bold text-[#181E25] tracking-[-0.035em] text-balance">
        联系 <span class="gradient-pink-text">我们</span>
      </h2>
      <p class="mt-5 text-[16px] text-[#6E7782]">三种方式挑一个最方便的，7×24 都有真人</p>
    </div>

    <div class="mt-16 grid gap-5 sm:grid-cols-3">
      {channels.map((c) => {
        const g = gradientMap[c.key] || 'gradient-purple';
        const body = (
          <article class="h-full rounded-3xl bg-white border border-[#E4E7EB] p-7 card-hover flex flex-col items-start">
            <div class={`h-12 w-12 rounded-xl ${g} flex items-center justify-center shadow-sm`}>
              <Icon name={c.iconName} class="text-white" size={22} />
            </div>
            <h3 class="mt-5 text-[16px] font-bold text-[#181E25] tracking-tight">{c.name}</h3>
            <p class="mt-2 text-[14px] text-[#6E7782] flex-1 leading-relaxed">{c.detail}</p>
          </article>
        );
        return c.href ? (
          <a
            href={c.href}
            target={c.external ? '_blank' : undefined}
            rel={c.external ? 'noopener noreferrer' : undefined}
            class="block"
          >
            {body}
          </a>
        ) : (
          body
        );
      })}
    </div>

    <div class="mt-12 flex justify-center">
      <a href="/contact">
        <Button size="lg" className="rounded-full h-12 px-7 text-[15px] font-medium gradient-purple text-white hover:opacity-90 shadow-lg">
          联系我们
        </Button>
      </a>
    </div>
  </div>
</section>
