---
// research / blog articles (minimaxi.com 风格: 3-6 篇文章卡)
const articles = [
  {
    title: 'MiniMax Max 拼车正式上线',
    subtitle: '人均 $28 / 月起',
    description: 'Anthropic Claude Max 5x 官方团队账号 2-4 人拼车，比单独订阅省 50% 以上。',
    date: '2026-08-13',
    href: '/services/minimax',
    badge: '新品上线',
    color: 'pink',
  },
  {
    title: 'ChatGPT Pro 200 满血套餐',
    subtitle: 'o1 pro + Codex 20x',
    description: 'Pro 200 满血版上线：1v1 专属客户经理 + 7×24 售后 + 所有模型优先通道。',
    date: '2026-08-05',
    href: '/services/chatgpt',
    badge: '套餐',
    color: 'purple',
  },
  {
    title: 'Claude Max 20x 满血体验',
    subtitle: '所有优先通道 + Opus 满血',
    description: 'Max 20x 满血体验：所有优先通道 + Opus 4 满血 + 高峰不限速。',
    date: '2026-07-28',
    href: '/services/claude',
    badge: '套餐',
    color: 'purple',
  },
  {
    title: 'AI 聚合平台上线',
    subtitle: '统一 API · 统一 UI',
    description: 'GPT-4o + Claude Opus + Gemini Pro + 国产大模型，统一接入，智能路由。',
    date: '2026-07-15',
    href: '/services/ai-aggregator',
    badge: '新品上线',
    color: 'dark',
  },
  {
    title: '5 分钟极速到账',
    subtitle: '自动化订单系统',
    description: '我们重构了订单系统，实现 5 分钟极速到账，特殊情况下 30 分钟内人工处理。',
    date: '2026-07-01',
    href: '/blog/fast-fulfillment',
    badge: '工程实践',
    color: 'purple',
  },
  {
    title: '$3 服务费透明计费',
    subtitle: '为什么我们只收 $3',
    description: '我们坚持透明计费，每单仅 $3 服务费，无隐藏费用，所有渠道一视同仁。',
    date: '2026-06-20',
    href: '/blog/transparent-pricing',
    badge: '价格政策',
    color: 'pink',
  },
];

const gradientMap: Record<string, string> = {
  pink: 'gradient-pink',
  purple: 'gradient-purple',
  dark: 'bg-[#181E25]',
};
---
<section class="py-24 bg-white">
  <div class="container-fluid">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="heading-display text-[clamp(2.5rem,6vw,4.5rem)] text-balance">
        最新 <span class="gradient-blue-text">动态</span>
      </h2>
      <p class="mt-5 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed">
        价格调整 / 服务上线 / 工程实践 · 与用户同行
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((a) => (
        <a
          href={a.href}
          class="group rounded-3xl border border-[#E4E7EB] overflow-hidden hover:border-[#181E25] transition-all flex flex-col"
        >
          <!-- 顶部渐变 banner -->
          <div class={`relative aspect-[16/9] ${gradientMap[a.color] ?? 'gradient-purple'} overflow-hidden`}>
            <div class="absolute -top-8 -right-8 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>
            <div class="absolute bottom-0 -left-6 w-32 h-32 rounded-full bg-white/10 blur-2xl"></div>
            <div class="absolute top-4 left-4 inline-flex items-center h-6 px-2.5 rounded-full bg-white/25 backdrop-blur-sm text-white text-[10px] font-semibold uppercase tracking-[0.2em]">
              {a.badge}
            </div>
            <div class="absolute bottom-4 left-4 right-4 text-white text-[20px] font-bold tracking-tight text-balance line-clamp-2">
              {a.title}
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <div class="text-[12px] text-[#6E7782]">{a.date} · {a.subtitle}</div>
            <p class="mt-2 text-[14px] text-[#181E25] leading-relaxed flex-1 text-pretty">
              {a.description}
            </p>
            <div class="mt-3 text-[12px] text-[#181E25] font-medium group-hover:text-[#7A27FF] transition-colors">
              阅读全文 →
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 flex justify-center">
      <a
        href="/news"
        class="inline-flex items-center justify-center h-12 px-7 rounded-full border border-[#E4E7EB] bg-white text-[#181E25] text-[15px] font-medium hover:border-[#181E25] transition-colors"
      >
        查看全部 →
      </a>
    </div>
  </div>
</section>
