---
import { siteConfig } from '@/lib/site-config';
---
<section class="relative bg-white pt-20 pb-10 overflow-hidden">
  <div class="container mx-auto max-w-6xl px-4 text-center">
    <!-- 居中标题 (MiniMax H3 风格：黑 + 紫渐变 同一行) -->
    <h1 class="text-[clamp(3.5rem,9vw,7.5rem)] leading-[1.0] font-bold tracking-[-0.04em] text-[#181E25] text-balance">
      FluxA<span class="gradient-purple-text ml-4">AI 服务</span>
    </h1>

    <!-- 副标题 (1 行，居中，灰色) -->
    <p class="mt-8 text-[18px] md:text-[20px] text-[#6E7782] leading-relaxed text-pretty max-w-2xl mx-auto">
      AI 服务，一站搞定
    </p>

    <!-- 3 CTA (黑色实心 + 黑色实心 + 白底深色边框) -->
    <div class="mt-10 flex flex-col sm:flex-row gap-3 items-center justify-center">
      <a
        href="/pricing"
        class="inline-flex items-center justify-center h-12 px-8 rounded-full bg-[#181E25] text-white text-[15px] font-medium hover:bg-[#0a0d12] transition-colors min-w-[140px]"
      >
        查看套餐价格
      </a>
      <a
        href="/contact"
        class="inline-flex items-center justify-center h-12 px-8 rounded-full bg-[#181E25] text-white text-[15px] font-medium hover:bg-[#0a0d12] transition-colors min-w-[140px]"
      >
        联系客服
      </a>
      <a
        href="/services/minimax"
        class="inline-flex items-center justify-center h-12 px-8 rounded-full border border-[#E4E7EB] bg-white text-[#181E25] text-[15px] font-medium hover:border-[#181E25] transition-colors min-w-[140px]"
      >
        了解更多
      </a>
    </div>
  </div>
</section>

<!-- 大电影感海报图 (占满宽度，渐变 + 几何) -->
<section class="relative bg-white pb-20">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="relative aspect-[16/7] rounded-3xl overflow-hidden shadow-2xl">
      <!-- 渐变背景 (粉橙 → 紫) -->
      <div class="absolute inset-0 bg-gradient-to-br from-[#FF276F] via-[#FF7038] to-[#7A27FF]"></div>
      <!-- 装饰圆 -->
      <div class="absolute top-12 left-12 w-32 h-32 rounded-full bg-white/20 blur-2xl"></div>
      <div class="absolute bottom-16 right-20 w-48 h-48 rounded-full bg-white/15 blur-3xl"></div>
      <div class="absolute top-1/2 right-1/3 w-24 h-24 rounded-full bg-[#7A27FF]/40 blur-2xl"></div>

      <!-- 海报大文字 -->
      <div class="relative h-full flex flex-col items-center justify-center text-white px-8">
        <div class="text-[11px] uppercase tracking-[0.3em] font-semibold opacity-90 mb-4">FEATURED</div>
        <div class="text-[clamp(3rem,7vw,6rem)] font-bold tracking-[-0.04em] leading-[0.95] text-center text-balance">
          Claude Max<br />5x 拼车
        </div>
        <div class="mt-6 text-[15px] md:text-[17px] opacity-90 max-w-xl text-center">
          2 / 3 / 4 人共享团队账号 · 官方价 + 仅 $3 人工费
        </div>
        <a
          href="/services/minimax"
          class="mt-8 inline-flex items-center justify-center h-11 px-7 rounded-full bg-white text-[#7A27FF] text-[14px] font-semibold hover:opacity-90 transition-opacity"
        >
          了解 Max 拼车 →
        </a>
      </div>
    </div>
  </div>
</section>

<!-- 圆点导航 (4 个小横条，第 1 个高亮) -->
<section class="bg-white pb-8">
  <div class="container mx-auto max-w-6xl px-4 flex justify-center gap-2">
    <div class="h-1 w-8 rounded-full bg-[#181E25]"></div>
    <div class="h-1 w-8 rounded-full bg-[#E4E7EB]"></div>
    <div class="h-1 w-8 rounded-full bg-[#E4E7EB]"></div>
    <div class="h-1 w-8 rounded-full bg-[#E4E7EB]"></div>
  </div>
</section>
