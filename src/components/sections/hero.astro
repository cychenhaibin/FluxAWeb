---
import { siteConfig } from '@/lib/site-config';
import { Button } from '@/components/ui/button';
---
<section class="relative bg-white pt-24 pb-16 overflow-hidden">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-3xl mx-auto">
      <!-- 顶部徽章 -->
      <a href="/services/minimax" class="inline-flex items-center gap-2 rounded-full border border-[#E4E7EB] bg-white px-4 py-1.5 text-[13px] text-[#181E25] mb-8 hover:border-[#7A27FF] hover:shadow-sm transition-all">
        <span class="inline-flex h-5 w-5 rounded-full gradient-pink items-center justify-center text-white text-[10px] font-bold">新</span>
        <span class="font-medium">Claude Max 拼车上线</span>
        <span class="text-[#7A27FF]">→</span>
      </a>

      <!-- 主标题 -->
      <h1 class="text-[clamp(2.75rem,7vw,5.5rem)] leading-[1.05] font-bold text-[#181E25] tracking-[-0.04em] text-balance">
        FluxA ·<br />
        <span class="gradient-purple-text">{siteConfig.brand.slogan}</span>
      </h1>

      <!-- 副标题 -->
      <p class="mt-6 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed text-pretty max-w-2xl mx-auto">
        官方价直充 ChatGPT / Claude / Max 拼车 / AI 聚合。<br />
        为 AI 时代打造的高速、稳定、可观测的 AI 服务基础设施。
      </p>

      <!-- 3 CTA -->
      <div class="mt-10 flex flex-col sm:flex-row gap-3 items-center justify-center">
        <a href="/pricing">
          <Button size="lg" className="rounded-full h-12 px-6 text-[15px] font-medium gradient-purple text-white hover:opacity-90 shadow-lg">
            查看套餐价格
          </Button>
        </a>
        <a href="/contact">
          <Button size="lg" className="rounded-full h-12 px-6 text-[15px] font-medium bg-[#181E25] text-white hover:bg-[#0a0d12]">
            联系客服
          </Button>
        </a>
        <a href="/services/minimax">
          <Button size="lg" variant="outline" className="rounded-full h-12 px-6 text-[15px] font-medium border-[#E4E7EB] bg-white text-[#181E25] hover:border-[#7A27FF] hover:text-[#7A27FF]">
            了解 Max 拼车
          </Button>
        </a>
      </div>
    </div>

    <!-- 业务 mockup：粉橙渐变背景 + 4 业务卡 -->
    <div class="mt-20 relative">
      <div class="relative rounded-3xl gradient-pink p-1 overflow-hidden shadow-2xl">
        <div class="rounded-[calc(1.5rem-4px)] bg-white p-8 md:p-12">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- ChatGPT 充值 (蓝渐变) -->
            <div class="rounded-2xl gradient-blue p-6 text-white min-h-[200px] flex flex-col justify-between">
              <div>
                <div class="text-[11px] uppercase tracking-wider font-semibold opacity-90">ChatGPT</div>
                <div class="mt-2 text-[24px] font-bold tracking-tight">GPT-4o 无限</div>
                <div class="mt-1 text-[13px] opacity-90">Plus / Pro 全档</div>
              </div>
              <div class="text-[13px] font-mono opacity-90">$23/月起</div>
            </div>
            <!-- Claude 充值 (紫渐变) -->
            <div class="rounded-2xl gradient-purple p-6 text-white min-h-[200px] flex flex-col justify-between">
              <div>
                <div class="text-[11px] uppercase tracking-wider font-semibold opacity-90">Claude</div>
                <div class="mt-2 text-[24px] font-bold tracking-tight">Sonnet 4.5</div>
                <div class="mt-1 text-[13px] opacity-90">Pro / Max 满血</div>
              </div>
              <div class="text-[13px] font-mono opacity-90">$23/月起</div>
            </div>
            <!-- Max 拼车 (粉橙渐变, hot) -->
            <div class="relative rounded-2xl gradient-pink p-6 text-white min-h-[200px] flex flex-col justify-between">
              <span class="absolute top-3 right-3 px-2 py-0.5 rounded-full bg-white/25 backdrop-blur-sm text-white text-[10px] font-semibold uppercase tracking-wider">Hot</span>
              <div>
                <div class="text-[11px] uppercase tracking-wider font-semibold opacity-90">Max 拼车</div>
                <div class="mt-2 text-[24px] font-bold tracking-tight">5x 拼车</div>
                <div class="mt-1 text-[13px] opacity-90">2/3/4 人共享</div>
              </div>
              <div class="text-[13px] font-mono opacity-90">$28/月起</div>
            </div>
            <!-- AI 聚合 (黑底白字) -->
            <div class="rounded-2xl bg-[#181E25] p-6 text-white min-h-[200px] flex flex-col justify-between">
              <div>
                <div class="text-[11px] uppercase tracking-wider font-semibold opacity-90">AI 聚合</div>
                <div class="mt-2 text-[24px] font-bold tracking-tight">自营稳定</div>
                <div class="mt-1 text-[13px] opacity-90">全模型聚合 API</div>
              </div>
              <div class="text-[13px] font-mono opacity-90">按量计费</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
