---
// 最新动态 section (1:1 复刻 MiniMax 旗舰模型 2x2 grid 布局: 大图 row-span-2 + 2 cell)
// 3 篇文章：第 1 篇作左大图 (row-span-2) + 第 2 篇 (右上 cell) + 第 3 篇 (右下 cell)

const articles = [
  {
    title: 'Claude Max 5x\n拼车上线',
    subtitle: '人均仅 $53/月',
    description: 'Claude Max 5x 团队拼车服务，2-4 人共享账号分摊费用',
    date: '2026-08-13',
    href: '/services/minimax',
    color: 'pink',
    isBig: true,        // row-span-2
  },
  {
    title: 'Pro 200\n满血套餐',
    subtitle: '1v1 专属客户经理 · 7×24 售后',
    description: 'Pro 200 满血版：1v1 专属客户经理 + 7×24 售后',
    date: '2026-08-05',
    href: '/services/chatgpt',
    color: 'purple',
    isBig: false,
  },
  {
    title: 'Max 20x\n满血体验',
    subtitle: '所有优先通道 + Opus 满血',
    description: 'Max 20x 满血体验：所有优先通道 + Opus 满血',
    date: '2026-07-28',
    href: '/services/claude',
    color: 'purple',
    isBig: false,
  },
];

const a1 = articles[0];  // 左大图 row-span-2
const a2 = articles[1];  // (1,2) 右上 cell
const a3 = articles[2];  // (2,2) 右下 cell

// 图标映射 (按文章对应服务的 logo)
const logoMap: Record<string, string> = {
  '/services/chatgpt': 'openai',
  '/services/claude': 'anthropic',
  '/services/minimax': 'openai',
  '/services/ai-aggregator': 'openai',
};
---
<section class="py-24 bg-white">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.05] font-bold text-[#181E25] tracking-[-0.04em] text-balance">
        最新动态
      </h2>
      <p class="mt-5 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed">
        价格调整 / 服务上线 / 工程实践 · 与用户同行
      </p>
    </div>

    <!-- 2x2 grid (1:1 复刻 MiniMax 旗舰模型 布局) -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 md:grid-rows-2 gap-4 md:gap-x-[34px] md:gap-y-6">
      <!-- (1,1) + (2,1) 左大图 row-span-2 h-[550px]：第 1 篇文章 (粉橙 + 大白字) -->
      <a
        href={a1.href}
        class="group md:row-span-2 relative overflow-hidden rounded-3xl md:rounded-[24px] gradient-pink h-[368px] md:h-[550px] hover:scale-[1.01] transition-transform"
      >
        <!-- 装饰圆 (模糊光斑) -->
        <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/10 blur-3xl"></div>
        <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-[#7A27FF]/30 blur-3xl"></div>
        <div class="absolute bottom-10 -left-10 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>

        <!-- 大白字 (居中 bottom) -->
        <div class="absolute left-1/2 -translate-x-1/2 bottom-4 z-[2] w-[min(calc(100%_-_32px),420px)] md:left-6 md:right-auto md:translate-x-0 md:bottom-5 md:w-[min(calc(100%_-_48px),420px)]">
          <div class="text-[clamp(2.5rem,6vw,5.5rem)] font-bold tracking-[-0.04em] leading-[0.9] text-balance text-white whitespace-pre-line">
            {a1.title}
          </div>
        </div>
      </a>

      <!-- (1,2) 右上 cell：第 2 篇文章 (透明 bg + 文字 + 图 + 底部行) -->
      <a
        href={a2.href}
        class="group relative overflow-hidden rounded-3xl md:rounded-[24px] bg-transparent transition-colors duration-300 hover:bg-[#F7F8FA] flex flex-col pt-2.5 pb-2.5 md:block md:h-[264px] md:pt-0 md:pb-0"
      >
        <!-- 文字 -->
        <div class="order-2 md:absolute md:left-6 md:right-[56%] md:top-5 md:bottom-5 md:z-[2] z-[2] mx-auto mt-2.5 w-[min(calc(100%_-_32px),420px)] flex flex-col">
          <h3 class="m-0 whitespace-pre-line text-[24px] font-bold leading-[1.16] tracking-[-0.4px] text-[#181E25] md:text-[28px]">
            {a2.title}
          </h3>
          <p class="m-0 mt-2 text-[14px] font-normal leading-[1.2] text-[#000000] md:text-[15px]">
            {a2.description}
          </p>
        </div>

        <!-- 图 (紫渐变 + logo) -->
        <div class="order-1 md:order-none relative mx-auto h-[200px] w-[min(calc(100%_-_32px),420px)] overflow-hidden rounded-2xl md:rounded-[14px] md:absolute md:bottom-auto md:left-auto md:right-6 md:top-6 md:aspect-[288/217] md:h-auto md:w-[min(288px,48%)]">
          <div class="absolute inset-0 gradient-purple"></div>
          <div class="absolute -top-8 -right-8 w-32 h-32 rounded-full bg-white/15 blur-2xl"></div>
          <img src={`/icons/${logoMap[a2.href] || 'openai'}.svg`} alt="logo" class="absolute inset-0 m-auto w-20 h-20 md:w-24 md:h-24 brightness-0 invert relative z-10" />
        </div>

        <!-- 底部行 -->
        <footer class="order-3 md:absolute md:left-6 md:z-10 md:flex md:bottom-6 flex flex-wrap items-center justify-start gap-x-4 gap-y-1 text-[13px] leading-none text-[#6E7782]">
          <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C]">{a2.date}</span>
          <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C] transition-opacity group-hover:opacity-60">了解更多<span aria-hidden="true" class="inline-flex w-[0.75em] items-center justify-center">&gt;</span></span>
        </footer>
      </a>

      <!-- (2,2) 右下 cell：第 3 篇文章 (透明 bg + 文字 + 图 + 底部行) -->
      <a
        href={a3.href}
        class="group relative overflow-hidden rounded-3xl md:rounded-[24px] bg-transparent transition-colors duration-300 hover:bg-[#F7F8FA] flex flex-col pt-2.5 pb-2.5 md:block md:h-[264px] md:pt-0 md:pb-0"
      >
        <!-- 文字 -->
        <div class="order-2 md:absolute md:left-6 md:right-[56%] md:top-5 md:bottom-5 md:z-[2] z-[2] mx-auto mt-2.5 w-[min(calc(100%_-_32px),420px)] flex flex-col">
          <h3 class="m-0 whitespace-pre-line text-[24px] font-bold leading-[1.16] tracking-[-0.4px] text-[#181E25] md:text-[28px]">
            {a3.title}
          </h3>
          <p class="m-0 mt-2 text-[14px] font-normal leading-[1.2] text-[#000000] md:text-[15px]">
            {a3.description}
          </p>
        </div>

        <!-- 图 (紫渐变 + logo) -->
        <div class="order-1 md:order-none relative mx-auto h-[200px] w-[min(calc(100%_-_32px),420px)] overflow-hidden rounded-2xl md:rounded-[14px] md:absolute md:bottom-auto md:left-auto md:right-6 md:top-6 md:aspect-[288/217] md:h-auto md:w-[min(288px,48%)]">
          <div class="absolute inset-0 gradient-purple"></div>
          <div class="absolute -top-8 -right-8 w-32 h-32 rounded-full bg-white/15 blur-2xl"></div>
          <img src={`/icons/${logoMap[a3.href] || 'openai'}.svg`} alt="logo" class="absolute inset-0 m-auto w-20 h-20 md:w-24 md:h-24 brightness-0 invert relative z-10" />
        </div>

        <!-- 底部行 -->
        <footer class="order-3 md:absolute md:left-6 md:z-10 md:flex md:bottom-6 flex flex-wrap items-center justify-start gap-x-4 gap-y-1 text-[13px] leading-none text-[#6E7782]">
          <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C]">{a3.date}</span>
          <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C] transition-opacity group-hover:opacity-60">了解更多<span aria-hidden="true" class="inline-flex w-[0.75em] items-center justify-center">&gt;</span></span>
        </footer>
      </a>
    </div>

    <div class="mt-16 flex justify-center">
      <a
        href="/faq"
        class="inline-flex items-center justify-center h-12 px-7 rounded-full border border-[#E4E7EB] bg-white text-[#181E25] text-[15px] font-medium hover:border-[#181E25] transition-colors"
      >
        查看全部 →
      </a>
    </div>
  </div>
</section>
