---
// 最新动态 section (1:1 复刻 MiniMax 旗舰模型 2x2 grid 布局)
// 3 篇文章：第 1 篇作左大图 (row-span-2) + 第 2 篇 (右上 cell) + 第 3 篇 (右下 cell)

const articles = [
  {
    title: 'Claude Max 5x\n拼车上线',
    subtitle: '人均仅 $53/月',
    description: 'Claude Max 5x 团队拼车服务，2-4 人共享账号分摊费用',
    date: '2026-08-13',
    href: '/services/minimax',
    color: 'pink',
    isBig: true,
  },
  {
    title: 'Pro 200\n满血套餐',
    subtitle: '1v1 专属客户经理 · 7×24 售后',
    description: 'Pro 200 满血版：1v1 专属客户经理 + 7×24 售后',
    date: '2026-08-05',
    href: '/services/chatgpt',
    color: 'purple',
    isBig: false,
  },
  {
    title: 'Max 20x\n满血体验',
    subtitle: '所有优先通道 + Opus 满血',
    description: 'Max 20x 满血体验：所有优先通道 + Opus 满血',
    date: '2026-07-28',
    href: '/services/claude',
    color: 'purple',
    isBig: false,
  },
];

const a1 = articles[0];
const a2 = articles[1];
const a3 = articles[2];

const logoMap: Record<string, string> = {
  '/services/chatgpt': 'openai',
  '/services/claude': 'anthropic',
  '/services/minimax': 'openai',
  '/services/ai-aggregator': 'openai',
};
---
<section class="py-24 bg-white">
  <div class="mx-auto mt-[50px] w-full max-w-[1126px] px-4 md:mt-[60px] md:px-0">
    <div class="section-heading centered mx-auto mb-[36px] max-w-[760px] text-center">
      <h2 class="m-0 text-[24px] font-bold leading-[1.2] tracking-[-0.2px] text-[#181E25] md:text-[40px] md:tracking-[-0.4px]">
        最新动态
      </h2>
      <p class="m-0 mt-2 flex w-full flex-col justify-center break-words text-center text-[16px] leading-[19.2px] text-[#86909C] md:mt-3">
        价格调整 / 服务上线 / 工程实践 · 与用户同行
      </p>
    </div>

    <!-- 2x2 grid (1:1 复刻 MiniMax 旗舰模型 布局) -->
    <div class="model-layout relative mx-auto grid max-w-[1126px] grid-cols-1 gap-[15px] md:grid-cols-2 md:grid-rows-2 md:gap-x-[34px] md:gap-y-6">
      <!-- (1,1) + (2,1) 左大图 row-span-2 h-[550px]：第 1 篇文章 (粉橙 + 3D 装饰 + 大白字) -->
      <a
        href={a1.href}
        class="model-card group relative overflow-hidden rounded-[16px] bg-transparent transition-colors duration-300 hover:bg-[#F7F8FA] has-[a:active]:bg-[#F7F8FA] md:rounded-[24px] model-card-large h-[368px] md:row-span-2 md:h-[550px] gradient-pink"
      >
        <!-- 装饰圆 (模糊光斑) -->
        <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/10 blur-3xl"></div>
        <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-[#7A27FF]/30 blur-3xl"></div>
        <div class="absolute bottom-10 -left-10 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>

        <!-- 3D 装饰 (SVG 模拟 MiniMax M3 黑色多面体+球体) -->
        <div class="model-image-frame absolute left-1/2 top-3 h-[253px] w-[min(calc(100%_-_32px),336px)] -translate-x-1/2 overflow-hidden rounded-[12px] md:left-6 md:right-auto md:top-[14px] md:aspect-[498/375] md:h-auto md:w-[min(498px,calc(100%_-_48px))] md:translate-x-0 md:rounded-[18px]">
          <svg class="absolute inset-0 m-auto w-[80%] h-[80%] object-contain transition-transform duration-500 group-hover:scale-[1.03]" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="m3-sphere-2" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#3a3a3a" />
                <stop offset="50%" stop-color="#0f0f0f" />
                <stop offset="100%" stop-color="#000" />
              </linearGradient>
              <linearGradient id="m3-highlight-2" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#5a5a5a" stop-opacity="0.7" />
                <stop offset="100%" stop-color="#0a0a0a" stop-opacity="0" />
              </linearGradient>
            </defs>
            <ellipse cx="100" cy="110" rx="78" ry="82" fill="url(#m3-sphere-2)" />
            <path d="M 100 110 L 100 28 A 78 82 0 0 0 28 70 Z" fill="url(#m3-highlight-2)" />
            <ellipse cx="80" cy="70" rx="18" ry="10" fill="#fff" opacity="0.18" />
            <ellipse cx="100" cy="110" rx="78" ry="82" fill="none" stroke="#000" stroke-width="1" opacity="0.5" />
          </svg>
        </div>

        <!-- 大白字 (mobile top-272 + bottom-4, desktop top-405 + bottom-5) -->
        <div class="absolute left-1/2 top-[272px] bottom-4 z-[2] flex w-[min(calc(100%_-_32px),336px)] -translate-x-1/2 flex-col justify-between md:left-6 md:right-auto md:top-[405px] md:translate-x-0 md:bottom-5 md:w-[min(382px,calc(100%_-_48px))]">
          <div class="text-[clamp(2rem,5vw,4.5rem)] font-bold tracking-[-0.04em] leading-[0.95] text-white text-balance md:whitespace-pre-line">
            {a1.title}
          </div>
        </div>
      </a>

      <!-- (1,2) 右上 cell：第 2 篇文章 (MiniMax model-card 1:1) -->
      <a
        href={a2.href}
        class="model-card group relative overflow-hidden rounded-[16px] bg-transparent transition-colors duration-300 hover:bg-[#F7F8FA] has-[a:active]:bg-[#F7F8FA] md:rounded-[24px] flex h-auto flex-col pt-2.5 pb-2.5 md:block md:h-[264px] md:pt-0 md:pb-0"
      >
        <!-- 文字 -->
        <div class="z-[2] order-2 mx-auto mt-2.5 flex w-[min(calc(100%_-_32px),336px)] flex-col md:absolute md:left-6 md:right-[56%] md:top-5 md:bottom-5 md:z-[2] md:w-auto md:overflow-hidden">
          <h3 class="m-0 whitespace-normal text-[24px] font-bold leading-[1.16] tracking-[-0.4px] text-[#181E25] md:whitespace-pre-line md:text-[23px]">
            {a2.title}
          </h3>
          <p class="m-0 mt-2 text-[14px] font-normal leading-[1.2] tracking-[0] text-[#000000] md:mt-2 md:text-[18px]">
            {a2.description}
          </p>
        </div>

        <!-- 图 (紫渐变 + logo) -->
        <div class="model-image-frame relative order-1 mx-auto h-[253px] w-[min(calc(100%_-_32px),336px)] overflow-hidden rounded-[12px] md:absolute md:bottom-auto md:left-auto md:right-6 md:top-6 md:order-none md:aspect-[288/217] md:h-auto md:w-[min(288px,48%)] md:rounded-[14px]">
          <div class="absolute inset-0 gradient-purple"></div>
          <div class="absolute -top-8 -right-8 w-32 h-32 rounded-full bg-white/15 blur-2xl"></div>
          <img src={`/icons/${logoMap[a2.href] || 'openai'}.svg`} alt="logo" class="absolute inset-0 m-auto w-20 h-20 md:w-24 md:h-24 brightness-0 invert relative z-10" />
        </div>

        <!-- 底部行 -->
        <footer class="flex flex-wrap items-center justify-start gap-x-4 gap-y-1 text-[13px] leading-none text-[#6E7782] order-3 md:absolute md:left-6 md:z-10 md:flex md:bottom-6 mt-3 md:mt-0">
          <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C]">{a2.date}</span>
          <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C] transition-opacity group-hover:opacity-60">了解更多<span aria-hidden="true" class="inline-flex w-[0.75em] items-center justify-center">&gt;</span></span>
        </footer>
      </a>

      <!-- (2,2) 右下 cell：第 3 篇文章 (MiniMax model-card 1:1) -->
      <a
        href={a3.href}
        class="model-card group relative overflow-hidden rounded-[16px] bg-transparent transition-colors duration-300 hover:bg-[#F7F8FA] has-[a:active]:bg-[#F7F8FA] md:rounded-[24px] flex h-auto flex-col pt-2.5 pb-2.5 md:block md:h-[264px] md:pt-0 md:pb-0"
      >
        <!-- 文字 -->
        <div class="z-[2] order-2 mx-auto mt-2.5 flex w-[min(calc(100%_-_32px),336px)] flex-col md:absolute md:left-6 md:right-[56%] md:top-5 md:bottom-5 md:z-[2] md:w-auto md:overflow-hidden">
          <h3 class="m-0 whitespace-normal text-[24px] font-bold leading-[1.16] tracking-[-0.4px] text-[#181E25] md:whitespace-pre-line md:text-[23px]">
            {a3.title}
          </h3>
          <p class="m-0 mt-2 text-[14px] font-normal leading-[1.2] tracking-[0] text-[#000000] md:mt-2 md:text-[18px]">
            {a3.description}
          </p>
        </div>

        <!-- 图 (紫渐变 + logo) -->
        <div class="model-image-frame relative order-1 mx-auto h-[253px] w-[min(calc(100%_-_32px),336px)] overflow-hidden rounded-[12px] md:absolute md:bottom-auto md:left-auto md:right-6 md:top-6 md:order-none md:aspect-[288/217] md:h-auto md:w-[min(288px,48%)] md:rounded-[14px]">
          <div class="absolute inset-0 gradient-purple"></div>
          <div class="absolute -top-8 -right-8 w-32 h-32 rounded-full bg-white/15 blur-2xl"></div>
          <img src={`/icons/${logoMap[a3.href] || 'openai'}.svg`} alt="logo" class="absolute inset-0 m-auto w-20 h-20 md:w-24 md:h-24 brightness-0 invert relative z-10" />
        </div>

        <!-- 底部行 -->
        <footer class="flex flex-wrap items-center justify-start gap-x-4 gap-y-1 text-[13px] leading-none text-[#6E7782] order-3 md:absolute md:left-6 md:z-10 md:flex md:bottom-6 mt-3 md:mt-0">
          <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C]">{a3.date}</span>
          <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C] transition-opacity group-hover:opacity-60">了解更多<span aria-hidden="true" class="inline-flex w-[0.75em] items-center justify-center">&gt;</span></span>
        </footer>
      </a>
    </div>

    <div class="mt-16 flex justify-center">
      <a
        href="/faq"
        class="inline-flex items-center justify-center h-12 px-7 rounded-full border border-[#E4E7EB] bg-white text-[#181E25] text-[15px] font-medium hover:border-[#181E25] transition-colors"
      >
        查看全部 →
      </a>
    </div>
  </div>
</section>
