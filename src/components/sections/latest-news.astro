---
// 最新动态 section (1:1 复刻样图 1 布局: 大图 row-span-2 + 2 个图 cell + 2 个文字 cell)
// 3 篇文章：第 1 篇作左大图 (row-span-2) + 第 2 篇 (右上图 / 中下文字) + 第 3 篇 (右中图 / 右下文字)

const articles = [
  {
    title: 'Claude Max 5x\n拼车上线',
    subtitle: '人均仅 $53/月',
    description: 'Claude Max 5x 团队拼车服务，2-4 人共享账号分摊费用',
    date: '2026-08-13',
    href: '/services/minimax',
    color: 'pink',
    isBig: true,
  },
  {
    title: 'Pro 200\n满血套餐',
    subtitle: '1v1 专属客户经理 · 7×24 售后',
    description: 'Pro 200 满血版：1v1 专属客户经理 + 7×24 售后',
    date: '2026-08-05',
    href: '/services/chatgpt',
    color: 'purple',
    isBig: false,
  },
  {
    title: 'Max 20x\n满血体验',
    subtitle: '所有优先通道 + Opus 满血',
    description: 'Max 20x 满血体验：所有优先通道 + Opus 满血',
    date: '2026-07-28',
    href: '/services/claude',
    color: 'purple',
    isBig: false,
  },
];

const a1 = articles[0];
const a2 = articles[1];
const a3 = articles[2];

const logoMap: Record<string, string> = {
  '/services/chatgpt': 'openai',
  '/services/claude': 'anthropic',
  '/services/minimax': 'openai',
};
---
<section class="py-24 bg-white">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.05] font-bold text-[#181E25] tracking-[-0.04em] text-balance">
        最新动态
      </h2>
      <p class="mt-5 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed">
        价格调整 / 服务上线 / 工程实践 · 与用户同行
      </p>
    </div>

    <!-- 2x3 grid (1:1 复刻样图 1 布局) -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- (1,1) + (2,1) 左大图 row-span-2：第 1 篇文章 (粉橙 + 顶部 tag + 大白字底部) -->
      <a
        href={a1.href}
        class="group md:row-span-2 relative aspect-square rounded-3xl gradient-pink overflow-hidden flex flex-col items-start justify-between p-8 text-white hover:scale-[1.01] transition-transform"
      >
        <!-- 装饰圆 -->
        <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/10 blur-3xl"></div>
        <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-[#7A27FF]/30 blur-3xl"></div>
        <div class="absolute bottom-10 -left-10 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>

        <!-- 顶部 tag -->
        <div class="relative z-[2] inline-flex items-center h-7 px-3 rounded-full bg-white/20 backdrop-blur-sm text-white text-[11px] font-medium tracking-wide">
          {a1.subtitle}
        </div>

        <!-- 大白字 (底部) -->
        <div class="relative z-[2] text-[clamp(2.5rem,6vw,5rem)] font-bold tracking-[-0.04em] leading-[0.95] text-balance whitespace-pre-line">
          {a1.title}
        </div>
      </a>

      <!-- (1,2) 中上图：第 2 篇文章 (紫图 + OpenAI logo) -->
      <a
        href={a2.href}
        class="group relative aspect-square rounded-3xl gradient-purple overflow-hidden flex items-center justify-center hover:scale-[1.01] transition-transform"
      >
        <div class="absolute -top-8 -right-8 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>
        <img src={`/icons/${logoMap[a2.href] || 'openai'}.svg`} alt="logo" class="relative z-10 w-24 h-24 md:w-32 md:h-32 brightness-0 invert" />
      </a>

      <!-- (1,3) 右上图：第 3 篇文章 (紫图 + Anthropic logo) -->
      <a
        href={a3.href}
        class="group relative aspect-square rounded-3xl gradient-purple overflow-hidden flex items-center justify-center hover:scale-[1.01] transition-transform"
      >
        <div class="absolute -top-8 -right-8 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>
        <img src={`/icons/${logoMap[a3.href] || 'anthropic'}.svg`} alt="logo" class="relative z-10 w-24 h-24 md:w-32 md:h-32 brightness-0 invert" />
      </a>

      <!-- (2,2) 中下文字 cell (白底) -->
      <div class="aspect-square rounded-3xl bg-white p-6 md:p-7 flex flex-col">
        <h3 class="text-[28px] md:text-[32px] font-bold text-[#181E25] tracking-tight leading-tight text-balance whitespace-pre-line">
          {a2.title}
        </h3>
        <p class="mt-2 text-[15px] text-[#6E7782] leading-relaxed text-balance">
          {a2.description}
        </p>
        <div class="mt-6 flex items-center gap-3 text-[12px] text-[#6E7782]">
          <span>{a2.date}</span>
          <a href={a2.href} class="text-[#181E25] font-medium hover:text-[#7A27FF] transition-colors">了解更多 &gt;</a>
        </div>
      </div>

      <!-- (2,3) 右下文字 cell (白底) -->
      <div class="aspect-square rounded-3xl bg-white p-6 md:p-7 flex flex-col">
        <h3 class="text-[28px] md:text-[32px] font-bold text-[#181E25] tracking-tight leading-tight text-balance whitespace-pre-line">
          {a3.title}
        </h3>
        <p class="mt-2 text-[15px] text-[#6E7782] leading-relaxed text-balance">
          {a3.description}
        </p>
        <div class="mt-6 flex items-center gap-3 text-[12px] text-[#6E7782]">
          <span>{a3.date}</span>
          <a href={a3.href} class="text-[#181E25] font-medium hover:text-[#7A27FF] transition-colors">了解更多 &gt;</a>
        </div>
      </div>
    </div>

    <!-- Grid 外 col 1 下方：第 1 篇文章文字 (跟 (1,1) row-span-2 大图下方对齐，宽度 = col 1 宽度) -->
    <div class="mt-6 max-w-[calc((100%-3rem)/3)]">
      <h3 class="text-[24px] font-bold text-[#181E25] tracking-tight">{a1.subtitle}</h3>
      <p class="mt-2 text-[14px] text-[#6E7782] leading-relaxed">
        {a1.description}
      </p>
      <div class="mt-3 flex items-center gap-4 text-[12px] text-[#6E7782]">
        <span>{a1.date}</span>
        <a href={a1.href} class="text-[#181E25] font-medium hover:text-[#7A27FF] transition-colors">了解更多 &gt;</a>
      </div>
    </div>

    <div class="mt-16 flex justify-center">
      <a
        href="/faq"
        class="inline-flex items-center justify-center h-12 px-7 rounded-full border border-[#E4E7EB] bg-white text-[#181E25] text-[15px] font-medium hover:border-[#181E25] transition-colors"
      >
        查看全部 →
      </a>
    </div>
  </div>
</section>
