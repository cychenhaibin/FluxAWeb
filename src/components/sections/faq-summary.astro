---
import { Button } from '@/components/ui/button';

// 临时：FAQ Content Collection 已废弃（Phase 3 重写 schema），内联 4 条
// Phase 5 整个 section 会被删除
const faqs = [
  { question: '下单后多久能开通？', answer: '大多数订单 5 分钟内自动开通，特殊情况下 30 分钟内人工处理。' },
  { question: '支持哪些支付方式？', answer: '支持微信、支付宝、USDT（TRC20）。企业用户可申请对公转账。' },
  { question: '账号是官方账号吗？', answer: '是。我们使用 OpenAI / Anthropic 官方账号体系，所有账号来源合规可查。' },
  { question: '可以换号或退款吗？', answer: '开通前可免费换号；开通后 24 小时内非账号质量问题支持按比例退款。' },
];
---
<section class="py-24 bg-[#F7F8FA]">
  <div class="container mx-auto max-w-3xl px-4">
    <div class="text-center">
      <h2 class="text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.05] font-bold text-[#181E25] tracking-[-0.04em] text-balance">
        常见问题
      </h2>
      <p class="mt-5 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed">
        没看到想问的？去 FAQ 页面翻翻看
      </p>
    </div>

    <div class="mt-16 rounded-3xl bg-white border border-[#E4E7EB] overflow-hidden divide-y divide-[#E4E7EB]">
      {faqs.map((item) => (
        <details class="group px-6 py-5 hover:bg-[#F7F8FA] transition-colors [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <span class="text-[16px] font-semibold text-[#181E25] tracking-tight pr-4">{item.question}</span>
            <span class="ml-4 shrink-0 text-[#6E7782] transition-transform group-open:rotate-45 text-xl leading-none">+</span>
          </summary>
          <p class="mt-3 text-[14px] leading-relaxed text-[#6E7782]">{item.answer}</p>
        </details>
      ))}
    </div>

    <div class="mt-12 flex justify-center">
      <a href="/faq">
        <Button className="rounded-full h-12 px-7 text-[15px] font-medium border border-[#E4E7EB] bg-white text-[#181E25] hover:border-[#181E25]">
          查看全部 →
        </Button>
      </a>
    </div>
  </div>
</section>
