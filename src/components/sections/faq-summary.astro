---
import { getEntry } from 'astro:content';
import { Button } from '@/components/ui/button';

const faqEntry = await getEntry('faq', 'faq');
const faqs = faqEntry?.data?.slice(0, 4) ?? [];
---
<section class="py-20 bg-zinc-50">
  <div class="container mx-auto max-w-3xl px-4">
    <div class="text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-3 py-1 text-[12px] text-zinc-700 mb-5">
        <span class="h-1.5 w-1.5 rounded-full bg-pink-500"></span>
        7×24 客服
      </div>
      <h2 class="text-3xl md:text-[44px] leading-[1.1] font-semibold text-zinc-900 tracking-[-0.03em] text-balance">常见问题</h2>
      <p class="mt-4 text-zinc-600 text-base">没看到想问的？去 FAQ 页面翻翻看</p>
    </div>

    <div class="mt-12 bg-white border border-zinc-200 rounded-2xl shadow-stripe divide-y divide-zinc-100">
      {faqs.map((item) => (
        <details class="group px-6 py-4 hover:bg-zinc-50/50 transition-colors [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <span class="text-[15px] font-medium text-zinc-900 tracking-tight pr-4">{item.question}</span>
            <span class="ml-4 shrink-0 text-zinc-400 transition-transform group-open:rotate-45">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14" />
                <path d="M5 12h14" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-[13.5px] leading-relaxed text-zinc-600">{item.answer}</p>
          <div class="mt-2 text-[11px] uppercase tracking-wider text-indigo-600 font-medium">{item.category}</div>
        </details>
      ))}
    </div>

    <div class="mt-10 flex justify-center">
      <a href="/faq">
        <Button size="lg" variant="outline" className="rounded-full h-11 px-6 text-[13px] font-medium border-zinc-300 bg-white text-zinc-900 hover:bg-zinc-50">
          查看更多问题
        </Button>
      </a>
    </div>
  </div>
</section>
