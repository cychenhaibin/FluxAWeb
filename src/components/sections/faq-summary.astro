---
import { getEntry } from 'astro:content';
import { Button } from '@/components/ui/button';

const faqEntry = await getEntry('faq', 'faq');
const faqs = faqEntry?.data?.slice(0, 4) ?? [];
---
<section class="py-24 bg-white">
  <div class="container mx-auto max-w-3xl px-4">
    <div class="text-center">
      <h2 class="text-[clamp(2rem,5vw,3.5rem)] leading-[1.1] font-bold text-[#181E25] tracking-[-0.035em] text-balance">
        常见 <span class="gradient-blue-text">问题</span>
      </h2>
      <p class="mt-5 text-[16px] text-[#6E7782]">没看到想问的？去 FAQ 页面翻翻看</p>
    </div>

    <div class="mt-12 rounded-3xl bg-white border border-[#E4E7EB] overflow-hidden divide-y divide-[#E4E7EB]">
      {faqs.map((item) => (
        <details class="group px-6 py-5 hover:bg-[#F7F8FA] transition-colors [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <span class="text-[15px] font-semibold text-[#181E25] tracking-tight pr-4">{item.question}</span>
            <span class="ml-4 shrink-0 h-7 w-7 rounded-full bg-[#F2F3F5] text-[#6E7782] flex items-center justify-center transition-transform group-open:rotate-45 group-open:bg-[#7A27FF] group-open:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14" />
                <path d="M5 12h14" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-[14px] leading-relaxed text-[#6E7782]">{item.answer}</p>
          <div class="mt-3 inline-block text-[11px] uppercase tracking-wider text-[#7A27FF] font-semibold">{item.category}</div>
        </details>
      ))}
    </div>

    <div class="mt-10 flex justify-center">
      <a href="/faq">
        <Button size="lg" variant="outline" className="rounded-full h-12 px-7 text-[15px] font-medium border-[#E4E7EB] bg-white text-[#181E25] hover:border-[#7A27FF] hover:text-[#7A27FF]">
          查看更多问题
        </Button>
      </a>
    </div>
  </div>
</section>
