---
import { getCollection } from 'astro:content';

// 主推业务 = MiniMax Max 拼车（FluxA 旗舰）
const services = await getCollection('services');
const primary = services.find((s) => s.data.slug === 'minimax');
const primaryShowcase = primary?.data.showcase;
---
<section class="relative bg-white pt-16 pb-12 overflow-hidden">
  <!-- 装饰圆 (minimaxi.com 风格：紫粉渐变) -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute top-20 -left-32 w-96 h-96 rounded-full bg-[#7A27FF]/8 blur-3xl"></div>
    <div class="absolute top-40 -right-20 w-80 h-80 rounded-full bg-[#FF276F]/8 blur-3xl"></div>
    <div class="absolute bottom-0 left-1/3 w-72 h-72 rounded-full bg-[#FF7038]/6 blur-3xl"></div>
  </div>

  <div class="container-fluid relative z-10">
    <div class="text-center max-w-4xl mx-auto">
      <!-- 居中大字品牌名 (minimaxi.com 风格: clamp 字号 + 渐变 highlight) -->
      <h1 class="heading-display text-[clamp(3.5rem,9vw,7.5rem)] text-balance">
        <span class="text-[#181E25]">FluxA</span>
        <span class="gradient-pink-orange-text ml-3 md:ml-5">AI 服务</span>
      </h1>

      <!-- 副标题 (灰色) -->
      <p class="mt-8 text-[18px] md:text-[20px] text-[#6E7782] leading-relaxed text-pretty max-w-2xl mx-auto">
        {primary?.data.tagline ?? 'AI 服务，一站搞定'}
      </p>

      <!-- 3 CTA (黑色实心 × 2 + 白底深色边框 × 1) -->
      <div class="mt-10 flex flex-col sm:flex-row gap-3 items-center justify-center">
        <a
          href="/services/minimax"
          class="inline-flex items-center justify-center h-12 px-8 rounded-full bg-[#181E25] text-white text-[15px] font-medium hover:bg-[#0a0d12] transition-colors min-w-[150px]"
        >
          {primary?.data.ctaLabel ?? '立即拼车'}
        </a>
        <a
          href="/pricing"
          class="inline-flex items-center justify-center h-12 px-8 rounded-full bg-[#181E25] text-white text-[15px] font-medium hover:bg-[#0a0d12] transition-colors min-w-[150px]"
        >
          查看套餐价格
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center h-12 px-8 rounded-full border border-[#E4E7EB] bg-white text-[#181E25] text-[15px] font-medium hover:border-[#181E25] transition-colors min-w-[150px]"
        >
          联系客服
        </a>
      </div>
    </div>
  </div>
</section>

<!-- 大电影感海报 (minimaxi.com 风格：占满宽度 + 渐变 + 装饰圆 + 大白字) -->
<section class="relative bg-white pb-16">
  <div class="container-fluid">
    <a
      href={primary ? `/services/${primary.data.slug}` : '/services/minimax'}
      class="group block relative aspect-[16/7] rounded-3xl overflow-hidden shadow-2xl shadow-black/10"
    >
      <!-- 渐变背景 (粉橙 → 紫) -->
      <div class="absolute inset-0 gradient-pink"></div>

      <!-- 装饰圆 (模糊光斑) -->
      <div class="absolute top-12 left-12 w-32 h-32 rounded-full bg-white/20 blur-2xl"></div>
      <div class="absolute bottom-16 right-20 w-48 h-48 rounded-full bg-white/15 blur-3xl"></div>
      <div class="absolute top-1/2 right-1/3 w-24 h-24 rounded-full bg-[#7A27FF]/40 blur-2xl"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 rounded-full bg-white/10 blur-3xl"></div>

      <!-- 海报大文字 (minimaxi.com 风格: 居中, 大字, 白字) -->
      <div class="relative h-full flex flex-col items-center justify-center text-white px-8">
        {primaryShowcase?.subtitle && (
          <div class="text-[11px] uppercase tracking-[0.3em] font-semibold opacity-90 mb-4">
            {primaryShowcase.badge ?? 'FEATURED'}
          </div>
        )}
        <div class="text-[clamp(2.5rem,7vw,5.5rem)] font-bold tracking-[-0.04em] leading-[0.95] text-center text-balance">
          {primaryShowcase?.title ?? 'MiniMax Max 拼车'}
        </div>
        {primaryShowcase?.description && (
          <div class="mt-5 text-[14px] md:text-[16px] opacity-90 max-w-xl text-center text-pretty">
            {primaryShowcase.description}
          </div>
        )}
        <div class="mt-7 inline-flex items-center justify-center h-11 px-7 rounded-full bg-white text-[#7A27FF] text-[14px] font-semibold group-hover:opacity-90 transition-opacity">
          了解详情 →
        </div>
      </div>
    </a>
  </div>
</section>
