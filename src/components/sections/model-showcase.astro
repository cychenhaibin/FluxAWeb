---
import { getCollection } from 'astro:content';
import Icon from '@/components/icon.astro';

const services = await getCollection('services');

// 4 capability 卡：4 业务的核心能力
const capabilities = services.map((s) => ({
  slug: s.data.slug,
  name: s.data.name,
  icon: s.data.icon,
  highlights: s.data.highlights.slice(0, 3),
}));

// benchmark 数据（FluxA 4 业务特点）
const benchmarks = [
  { label: '官方价透明', value: '100%', display: '官方价' },
  { label: '到账速度', value: '5min', display: '5 分钟' },
  { label: '服务费', value: '$3', display: '仅 $3' },
  { label: '客服响应', value: '7×24', display: '7×24' },
];
---
<section class="py-24 bg-white">
  <div class="container-fluid">
    <div class="grid gap-16 lg:grid-cols-[1fr_1fr] items-center">
      <!-- 左：标题 + benchmark panel -->
      <div>
        <h2 class="heading-display text-[clamp(2.5rem,6vw,4.5rem)] text-balance">
          为什么选 <span class="gradient-pink-orange-text">FluxA</span>
        </h2>
        <p class="mt-5 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed max-w-xl">
          官方价透明、5 分钟到账、7×24 客服、仅 $3 服务费——我们用一个平台，解决所有 AI 服务需求。
        </p>

        <!-- benchmark 4 数字面板 -->
        <div class="mt-10 grid grid-cols-2 gap-3">
          {benchmarks.map((b) => (
            <div class="rounded-2xl bg-[#F7F8FA] border border-[#E4E7EB] p-5">
              <div class="text-[11px] font-semibold text-[#6E7782] uppercase tracking-[0.15em]">{b.label}</div>
              <div class="mt-2 text-[clamp(1.75rem,3vw,2.5rem)] font-bold text-[#181E25] tracking-[-0.02em] tnum leading-none">
                {b.display}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 右：4 capability 卡 (2x2 grid) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {capabilities.map((c) => (
          <a
            href={`/services/${c.slug}`}
            class="group rounded-3xl bg-white border border-[#E4E7EB] p-6 hover:border-[#181E25] transition-all"
          >
            <div class="inline-flex h-11 w-11 rounded-xl gradient-purple items-center justify-center text-white">
              <Icon name={c.icon} size={20} />
            </div>
            <h3 class="mt-4 text-[17px] font-bold text-[#181E25] tracking-tight">{c.name}</h3>
            <ul class="mt-3 space-y-1.5 text-[13px] text-[#6E7782] leading-relaxed">
              {c.highlights.map((h) => (
                <li class="flex gap-2">
                  <span class="text-[#7A27FF] shrink-0">✓</span>
                  <span>{h.title}</span>
                </li>
              ))}
            </ul>
            <div class="mt-4 text-[12px] text-[#181E25] font-medium group-hover:text-[#7A27FF] transition-colors">
              了解详情 →
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
