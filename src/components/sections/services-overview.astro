---
import { getCollection } from 'astro:content';
import { Button } from '@/components/ui/button';
import Icon from '@/components/icon.astro';

const services = await getCollection('services');

// 给每个业务分配渐变（按 slug 固定）
const gradientMap: Record<string, { card: string; text: string; icon: string }> = {
  chatgpt: { card: 'gradient-blue', text: 'gradient-blue-text', icon: '#1BA4FF' },
  claude: { card: 'gradient-purple', text: 'gradient-purple-text', icon: '#7A27FF' },
  minimax: { card: 'gradient-pink', text: 'gradient-pink-text', icon: '#FF276F' },
  'ai-aggregator': { card: 'bg-[#181E25]', text: 'text-white', icon: '#FFFFFF' },
};
---
<section class="py-24 bg-white">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-[clamp(2rem,5vw,3.5rem)] leading-[1.1] font-bold text-[#181E25] tracking-[-0.035em] text-balance">
        覆盖所有 <span class="gradient-purple-text">AI 服务</span> 场景
      </h2>
      <p class="mt-5 text-[16px] text-[#6E7782] leading-relaxed">
        从个人订阅到团队拼车，从单一模型到聚合平台，官方价直充 + 透明服务费
      </p>
    </div>

    <div class="mt-16 grid gap-5 md:grid-cols-2">
      {services.map((s) => {
        const g = gradientMap[s.data.slug] || gradientMap['chatgpt'];
        return (
          <article class="group relative rounded-3xl bg-white border border-[#E4E7EB] p-7 card-hover overflow-hidden">
            <!-- 渐变小色块装饰 -->
            <div class={`absolute -top-12 -right-12 h-32 w-32 rounded-full ${g.card} opacity-10 blur-2xl`}></div>
            <div class="relative">
              <div class="flex items-start gap-4">
                <div class={`shrink-0 h-12 w-12 rounded-xl ${g.card} flex items-center justify-center shadow-sm`}>
                  <Icon name={s.data.icon} class="text-white" size={24} />
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class={`text-[20px] font-bold tracking-tight ${g.text}`}>{s.data.name}</h3>
                  <p class="mt-1.5 text-[14px] text-[#6E7782] leading-relaxed">{s.data.description}</p>
                </div>
              </div>

              <ul class="mt-6 space-y-3">
                {s.data.highlights.map((h) => (
                  <li class="flex items-start gap-2.5 text-[14px]">
                    <div class={`shrink-0 mt-0.5 h-5 w-5 rounded-md ${g.card} flex items-center justify-center`}>
                      <Icon name={h.icon} class="text-white" size={12} />
                    </div>
                    <div class="text-[#181E25]">
                      <span class="font-semibold">{h.title}</span>
                      <span class="text-[#6E7782]"> · {h.description}</span>
                    </div>
                  </li>
                ))}
              </ul>

              <div class="mt-6 flex justify-end">
                <a href={`/services/${s.data.slug}`}>
                  <Button variant="ghost" className={`rounded-full text-[14px] font-medium ${g.text} hover:bg-[#F7F8FA] px-4 h-9`}>
                    查看详情 →
                  </Button>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
