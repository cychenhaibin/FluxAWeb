---
import { getCollection } from 'astro:content';
import { Button } from '@/components/ui/button';
import Icon from '@/components/icon.astro';

const services = await getCollection('services');
---
<section class="py-20 bg-zinc-50 relative">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-3 py-1 text-[12px] text-zinc-700 mb-5 shadow-stripe">
        <span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>
        4 大核心业务
      </div>
      <h2 class="text-3xl md:text-[44px] leading-[1.1] font-semibold text-zinc-900 tracking-[-0.03em] text-balance">覆盖所有 AI 服务场景</h2>
      <p class="mt-4 text-zinc-600 text-base max-w-xl mx-auto leading-relaxed">
        从个人订阅到团队拼车，从单一模型到聚合平台，官方价直充 + 透明服务费
      </p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-2">
      {services.map((s) => (
        <article class="group bg-white border border-zinc-200 rounded-2xl p-7 hover:border-indigo-200 hover:shadow-stripe-hover transition-all">
          <div class="flex items-start gap-4">
            <div class="shrink-0 h-11 w-11 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center group-hover:bg-indigo-100 transition-all">
              <Icon name={s.data.icon} class="text-indigo-600" size={22} />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-lg font-semibold text-zinc-900 tracking-tight">{s.data.name}</h3>
              <p class="mt-1.5 text-[13px] text-zinc-600 leading-relaxed">{s.data.description}</p>
            </div>
          </div>

          <ul class="mt-5 space-y-2.5">
            {s.data.highlights.map((h) => (
              <li class="flex items-start gap-2.5 text-[13px]">
                <div class="shrink-0 mt-0.5 h-4 w-4 rounded bg-indigo-50 flex items-center justify-center">
                  <Icon name={h.icon} class="text-indigo-600" size={10} />
                </div>
                <div class="text-zinc-700">
                  <span class="font-medium text-zinc-900">{h.title}</span>
                  <span class="text-zinc-500"> · {h.description}</span>
                </div>
              </li>
            ))}
          </ul>

          <div class="mt-6 flex justify-end">
            <a href={`/services/${s.data.slug}`}>
              <Button variant="ghost" className="rounded-full text-[13px] text-indigo-600 hover:text-indigo-700 hover:bg-indigo-50 px-3">
                查看详情 →
              </Button>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
