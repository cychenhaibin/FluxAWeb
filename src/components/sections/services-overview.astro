---
import { getCollection } from 'astro:content';
import { Button } from '@/components/ui/button';
import Icon from '@/components/icon.astro';

const services = await getCollection('services');
---
<section class="py-20 bg-[#14121f] relative">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[12px] text-zinc-300 mb-5 backdrop-blur-md">
        <span class="h-1.5 w-1.5 rounded-full bg-[#ff6b35]"></span>
        4 大核心业务
      </div>
      <h2 class="text-3xl md:text-[44px] leading-[1.2] font-semibold text-white tracking-[-0.012em] text-balance">覆盖所有 AI 服务场景</h2>
      <p class="mt-4 text-zinc-400 text-base max-w-xl mx-auto leading-relaxed">
        从个人订阅到团队拼车，从单一模型到聚合平台，官方价直充 + 透明服务费
      </p>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-2">
      {services.map((s) => (
        <article class="group glass-card rounded-2xl p-7 hover:border-[#ff6b35]/40 hover:shadow-orange transition-all">
          <div class="flex items-start gap-4">
            <div class="shrink-0 h-11 w-11 rounded-xl bg-[#ff6b35]/10 border border-[#ff6b35]/30 flex items-center justify-center group-hover:bg-[#ff6b35]/20 transition-all">
              <Icon name={s.data.icon} class="text-[#ff6b35]" size={22} />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-lg font-semibold text-white tracking-tight">{s.data.name}</h3>
              <p class="mt-1.5 text-[13px] text-zinc-400 leading-relaxed">{s.data.description}</p>
            </div>
          </div>

          <ul class="mt-5 space-y-2.5">
            {s.data.highlights.map((h) => (
              <li class="flex items-start gap-2.5 text-[13px]">
                <div class="shrink-0 mt-0.5 h-4 w-4 rounded bg-[#ff6b35]/10 flex items-center justify-center">
                  <Icon name={h.icon} class="text-[#ff6b35]" size={10} />
                </div>
                <div class="text-zinc-300">
                  <span class="font-medium text-white">{h.title}</span>
                  <span class="text-zinc-500"> · {h.description}</span>
                </div>
              </li>
            ))}
          </ul>

          <div class="mt-6 flex justify-end">
            <a href={`/services/${s.data.slug}`}>
              <Button variant="ghost" className="rounded-full text-[13px] text-[#ff6b35] hover:text-[#ff8255] hover:bg-[#ff6b35]/10 px-3">
                查看详情 →
              </Button>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
