---
import { getCollection } from 'astro:content';
import { Button } from '@/components/ui/button';

const services = await getCollection('services');
const svcMax = services.find((s) => s.data.slug === 'minimax');      // (1,1)+(2,1) 左大图 row-span-2
const svcChatGPT = services.find((s) => s.data.slug === 'chatgpt');  // (1,2) 右上 cell
const svcClaude = services.find((s) => s.data.slug === 'claude');     // (2,2) 右下 cell
---
<section class="py-24 bg-white">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.05] font-bold text-[#181E25] tracking-[-0.04em] text-balance">
        旗舰服务
      </h2>
      <p class="mt-5 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed">
        FluxA 主推三大业务，覆盖 ChatGPT 充值 / Claude 充值 / Max 拼车
      </p>
    </div>

    <!-- 2x2 grid (1:1 复刻 MiniMax 旗舰模型 布局: 大图 row-span-2 + 2 个 文字+图+底部行 cell) -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 md:grid-rows-2 gap-4 md:gap-x-[34px] md:gap-y-6">
      <!-- (1,1) + (2,1) 左大图 row-span-2 h-[550px]：Max 拼车 (粉橙 + 大白字) -->
      {svcMax && (
        <a
          href={`/services/${svcMax.data.slug}`}
          class="group md:row-span-2 relative overflow-hidden rounded-3xl md:rounded-[24px] gradient-pink h-[368px] md:h-[550px] hover:scale-[1.01] transition-transform"
        >
          <!-- 装饰圆 (模糊光斑) -->
          <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/10 blur-3xl"></div>
          <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-[#7A27FF]/30 blur-3xl"></div>
          <div class="absolute bottom-10 -left-10 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>

          <!-- 大白字 (居中 bottom) -->
          <div class="absolute left-1/2 -translate-x-1/2 bottom-4 z-[2] w-[min(calc(100%_-_32px),420px)] md:left-6 md:right-auto md:translate-x-0 md:bottom-5 md:w-[min(calc(100%_-_48px),420px)]">
            <div class="text-[clamp(2.5rem,6vw,5.5rem)] font-bold tracking-[-0.04em] leading-[0.9] text-balance text-white">
              Max<br />拼车
            </div>
          </div>
        </a>
      )}

      <!-- (1,2) 右上 cell：ChatGPT 充值 (透明 bg + 文字左上 + 图右上 + 底部行左下) -->
      {svcChatGPT && (
        <a
          href={`/services/${svcChatGPT.data.slug}`}
          class="group relative overflow-hidden rounded-3xl md:rounded-[24px] bg-transparent transition-colors duration-300 hover:bg-[#F7F8FA] flex flex-col md:block"
        >
          <!-- 文字 (左上 absolute on md+) -->
          <div class="order-2 md:absolute md:left-6 md:right-[56%] md:top-5 md:bottom-5 md:z-[2] z-[2] mx-auto mt-2.5 w-[min(calc(100%_-_32px),420px)] flex flex-col">
            <h3 class="m-0 whitespace-pre-line text-[24px] font-bold leading-[1.16] tracking-[-0.4px] text-[#181E25] md:text-[28px]">
              ChatGPT 充值
            </h3>
            <p class="m-0 mt-2 text-[14px] font-normal leading-[1.2] text-[#000000] md:text-[15px]">
              Plus / Pro 全档 · GPT-4o 无限 · o1 pro 深度推理
            </p>
          </div>

          <!-- 图 (右上 absolute, 48% 宽, 14px 圆角) -->
          <div class="order-1 md:order-none relative mx-auto h-[200px] w-[min(calc(100%_-_32px),420px)] overflow-hidden rounded-2xl md:rounded-[14px] md:absolute md:bottom-auto md:left-auto md:right-6 md:top-6 md:aspect-[288/217] md:h-auto md:w-[min(288px,48%)]">
            <div class="absolute inset-0 gradient-purple"></div>
            <div class="absolute -top-8 -right-8 w-32 h-32 rounded-full bg-white/15 blur-2xl"></div>
            <img src="/icons/openai.svg" alt="OpenAI" class="absolute inset-0 m-auto w-20 h-20 md:w-24 md:h-24 brightness-0 invert relative z-10" />
          </div>

          <!-- 底部行 (左下 absolute on md+) -->
          <footer class="order-3 md:absolute md:left-6 md:z-10 md:flex md:bottom-6 flex flex-wrap items-center justify-start gap-x-4 gap-y-1 text-[13px] leading-none text-[#6E7782]">
            <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C]">2026-08</span>
            <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C] transition-opacity group-hover:opacity-60">了解更多<span aria-hidden="true" class="inline-flex w-[0.75em] items-center justify-center">&gt;</span></span>
          </footer>
        </a>
      )}

      <!-- (2,2) 右下 cell：Claude 充值 (透明 bg + 文字左上 + 图右上 + 底部行左下) -->
      {svcClaude && (
        <a
          href={`/services/${svcClaude.data.slug}`}
          class="group relative overflow-hidden rounded-3xl md:rounded-[24px] bg-transparent transition-colors duration-300 hover:bg-[#F7F8FA] flex flex-col md:block"
        >
          <!-- 文字 -->
          <div class="order-2 md:absolute md:left-6 md:right-[56%] md:top-5 md:bottom-5 md:z-[2] z-[2] mx-auto mt-2.5 w-[min(calc(100%_-_32px),420px)] flex flex-col">
            <h3 class="m-0 whitespace-pre-line text-[24px] font-bold leading-[1.16] tracking-[-0.4px] text-[#181E25] md:text-[28px]">
              Claude 充值
            </h3>
            <p class="m-0 mt-2 text-[14px] font-normal leading-[1.2] text-[#000000] md:text-[15px]">
              Sonnet 4.5 + Opus 4.1 全模型 · Pro / Max 满血体验
            </p>
          </div>

          <!-- 图 (Claude 赤土色) -->
          <div class="order-1 md:order-none relative mx-auto h-[200px] w-[min(calc(100%_-_32px),420px)] overflow-hidden rounded-2xl md:rounded-[14px] md:absolute md:bottom-auto md:left-auto md:right-6 md:top-6 md:aspect-[288/217] md:h-auto md:w-[min(288px,48%)]">
            <div class="absolute inset-0 gradient-claude"></div>
            <div class="absolute -top-8 -right-8 w-32 h-32 rounded-full bg-white/15 blur-2xl"></div>
            <img src="/icons/anthropic.svg" alt="Anthropic" class="absolute inset-0 m-auto w-20 h-20 md:w-24 md:h-24 brightness-0 invert relative z-10" />
          </div>

          <!-- 底部行 -->
          <footer class="order-3 md:absolute md:left-6 md:z-10 md:flex md:bottom-6 flex flex-wrap items-center justify-start gap-x-4 gap-y-1 text-[13px] leading-none text-[#6E7782]">
            <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C]">2026-08</span>
            <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C] transition-opacity group-hover:opacity-60">了解更多<span aria-hidden="true" class="inline-flex w-[0.75em] items-center justify-center">&gt;</span></span>
          </footer>
        </a>
      )}
    </div>

    <div class="mt-16 flex justify-center">
      <a href="/services/ai-aggregator">
        <Button className="rounded-full h-12 px-7 text-[15px] font-medium border border-[#E4E7EB] bg-white text-[#181E25] hover:border-[#181E25]">
          查看 AI 聚合 →
        </Button>
      </a>
    </div>
  </div>
</section>
