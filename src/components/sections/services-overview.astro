---
import { getCollection } from 'astro:content';
import { Button } from '@/components/ui/button';

const services = await getCollection('services');
const svcMax = services.find((s) => s.data.slug === 'minimax');      // (1,1)+(2,1) 左大：Max 拼车
const svcChatGPT = services.find((s) => s.data.slug === 'chatgpt');  // (1,2) / (2,2) 中上 / 中下：ChatGPT 充值
const svcClaude = services.find((s) => s.data.slug === 'claude');     // (1,3) / (2,3) 右上 / 右下：Claude 充值
---
<section class="py-24 bg-white">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.05] font-bold text-[#181E25] tracking-[-0.04em] text-balance">
        旗舰服务
      </h2>
      <p class="mt-5 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed">
        FluxA 主推三大业务，覆盖 ChatGPT 充值 / Claude 充值 / Max 拼车
      </p>
    </div>

    <!-- 2x3 grid (1:1 复刻 MiniMax 旗舰模型布局) -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- (1,1) + (2,1) 左大图 row-span-2：Max 拼车 (粉橙渐变 + Users icon + 大白字) -->
      {svcMax && (
        <a
          href={`/services/${svcMax.data.slug}`}
          class="group md:row-span-2 relative rounded-3xl gradient-pink overflow-hidden hover:scale-[1.01] transition-transform"
        >
          <!-- 装饰圆 (模糊光斑) -->
          <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/10 blur-3xl"></div>
          <div class="absolute bottom-10 -left-10 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>

          <!-- 左上角 Users icon 在半透明白盒 + 大白字在底部 -->
          <div class="relative h-full min-h-[420px] md:min-h-[528px] flex flex-col items-start justify-between p-8 text-white">
            <div class="w-14 h-14 rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 text-white">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            </div>

            <div class="text-[clamp(3rem,7vw,6.5rem)] font-bold tracking-[-0.04em] leading-[0.9] text-balance">
              Max<br />拼车
            </div>
          </div>
        </a>
      )}

      <!-- (1,2) 中上图：ChatGPT 紫渐变 + OpenAI logo 居中 -->
      {svcChatGPT && (
        <a
          href={`/services/${svcChatGPT.data.slug}`}
          class="group relative aspect-square rounded-3xl gradient-purple overflow-hidden flex items-center justify-center hover:scale-[1.01] transition-transform"
        >
          <div class="absolute -top-8 -right-8 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>
          <img src="/icons/openai.svg" alt="OpenAI" class="relative z-10 w-24 h-24 md:w-32 md:h-32 brightness-0 invert" />
        </a>
      )}

      <!-- (1,3) 右上图：Claude 赤土色 + Anthropic logo 居中 -->
      {svcClaude && (
        <a
          href={`/services/${svcClaude.data.slug}`}
          class="group relative aspect-square rounded-3xl gradient-claude overflow-hidden flex items-center justify-center hover:scale-[1.01] transition-transform"
        >
          <div class="absolute -top-8 -right-8 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>
          <img src="/icons/anthropic.svg" alt="Anthropic" class="relative z-10 w-24 h-24 md:w-32 md:h-32 brightness-0 invert" />
        </a>
      )}

      <!-- (2,2) 中下文字 cell：白底 + ChatGPT 充值标题 + 描述 + 日期 + 了解更多 > -->
      {svcChatGPT && (
        <div class="rounded-3xl bg-white p-6 md:p-7 flex flex-col">
          <h3 class="text-[28px] md:text-[32px] font-bold text-[#181E25] tracking-tight leading-tight text-balance">
            ChatGPT 充值
          </h3>
          <p class="mt-2 text-[15px] text-[#6E7782] leading-relaxed text-balance">
            Plus / Pro 全档 · GPT-4o 无限 · o1 pro 深度推理
          </p>
          <div class="mt-6 flex items-center gap-3 text-[12px] text-[#6E7782]">
            <span>2026-08</span>
            <a href={`/services/${svcChatGPT.data.slug}`} class="text-[#181E25] font-medium hover:text-[#7A27FF] transition-colors">了解更多 &gt;</a>
          </div>
        </div>
      )}

      <!-- (2,3) 右下文字 cell：白底 + Claude 充值标题 + 描述 + 日期 + 了解更多 > -->
      {svcClaude && (
        <div class="rounded-3xl bg-white p-6 md:p-7 flex flex-col">
          <h3 class="text-[28px] md:text-[32px] font-bold text-[#181E25] tracking-tight leading-tight text-balance">
            Claude 充值
          </h3>
          <p class="mt-2 text-[15px] text-[#6E7782] leading-relaxed text-balance">
            Sonnet 4.5 + Opus 4.1 全模型 · Pro / Max 满血体验
          </p>
          <div class="mt-6 flex items-center gap-3 text-[12px] text-[#6E7782]">
            <span>2026-08</span>
            <a href={`/services/${svcClaude.data.slug}`} class="text-[#181E25] font-medium hover:text-[#7A27FF] transition-colors">了解更多 &gt;</a>
          </div>
        </div>
      )}
    </div>

    <!-- Grid 外 col 1 下方：Max 拼车文字 (跟 (1,1) row-span-2 大图下方对齐，宽度 = col 1 宽度) -->
    {svcMax && (
      <div class="mt-6 max-w-[calc((100%-3rem)/3)]">
        <h3 class="text-[24px] font-bold text-[#181E25] tracking-tight">Max 拼车</h3>
        <p class="mt-2 text-[14px] text-[#6E7782] leading-relaxed">
          Claude Max 5x 团队拼车服务，2-4 人共享账号分摊费用，加 $3 人工费
        </p>
        <div class="mt-3 flex items-center gap-4 text-[12px] text-[#6E7782]">
          <span>2026-08</span>
          <a href={`/services/${svcMax.data.slug}`} class="text-[#181E25] font-medium hover:text-[#7A27FF] transition-colors">了解更多 &gt;</a>
        </div>
      </div>
    )}

    <div class="mt-16 flex justify-center">
      <a href="/services/ai-aggregator">
        <Button className="rounded-full h-12 px-7 text-[15px] font-medium border border-[#E4E7EB] bg-white text-[#181E25] hover:border-[#181E25]">
          查看 AI 聚合 →
        </Button>
      </a>
    </div>
  </div>
</section>
