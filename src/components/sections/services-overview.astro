---
import { getCollection } from 'astro:content';
import { Button } from '@/components/ui/button';
import Icon from '@/components/icon.astro';

const services = await getCollection('services');
---
<section class="py-24 bg-zinc-950 relative overflow-hidden">
  <!-- 背景装饰 -->
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-indigo-500/10 rounded-full blur-3xl -z-0"></div>

  <div class="container mx-auto max-w-6xl px-4 relative">
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900/50 px-3 py-1 text-xs text-zinc-400 mb-6">
        <span class="h-1.5 w-1.5 rounded-full bg-indigo-400"></span>
        4 大核心业务
      </div>
      <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tighter">覆盖所有 AI 服务场景</h2>
      <p class="mt-4 text-zinc-400 text-lg">
        从个人订阅到团队拼车，从单一模型到聚合平台，官方价直充 + 透明服务费
      </p>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2">
      {services.map((s) => (
        <article class="group relative backdrop-blur-md bg-zinc-900/40 border border-zinc-800 rounded-2xl p-8 hover:border-zinc-700 hover:bg-zinc-900/60 transition-all">
          <div class="flex items-start gap-4">
            <div class="shrink-0 h-12 w-12 rounded-xl bg-gradient-to-br from-indigo-500/20 to-cyan-500/20 border border-indigo-500/30 flex items-center justify-center group-hover:from-indigo-500/30 group-hover:to-cyan-500/30 transition-all">
              <Icon name={s.data.icon} class="text-indigo-300" size={24} />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-xl font-semibold text-white">{s.data.name}</h3>
              <p class="mt-2 text-sm text-zinc-400 leading-relaxed">{s.data.description}</p>
            </div>
          </div>

          <ul class="mt-6 space-y-3">
            {s.data.highlights.map((h) => (
              <li class="flex items-start gap-3 text-sm">
                <div class="shrink-0 mt-0.5 h-5 w-5 rounded-md bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center">
                  <Icon name={h.icon} class="text-indigo-300" size={12} />
                </div>
                <div>
                  <span class="font-medium text-white">{h.title}</span>
                  <span class="text-zinc-400"> · {h.description}</span>
                </div>
              </li>
            ))}
          </ul>

          <div class="mt-6 flex justify-end">
            <a href={`/services/${s.data.slug}`}>
              <Button variant="ghost" className="rounded-full text-zinc-300 hover:text-white hover:bg-zinc-800">
                查看详情 →
              </Button>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
