---
import { getCollection } from 'astro:content';
import Icon from '@/components/icon.astro';
import { Button } from '@/components/ui/button';

const services = await getCollection('services');
const leftBig = services.find((s) => s.data.slug === 'minimax');
const topRight = services.find((s) => s.data.slug === 'chatgpt');
const bottomRight = services.find((s) => s.data.slug === 'claude');
---
<section class="py-24 bg-white">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.05] font-bold text-[#181E25] tracking-[-0.04em] text-balance">
        旗舰服务
      </h2>
      <p class="mt-5 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed">
        FluxA 主推三大业务，覆盖 ChatGPT 充值 / Claude 充值 / Max 拼车
      </p>
    </div>

    <!-- 1:1 复刻 MiniMax 旗舰模型 2x2 不对称布局 (左大跨 2 行 + 右上小 + 右下小) -->
    <!-- 文字在卡外 (白底黑字)，不是卡内白字 -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-10">
      <!-- 左大：Max 拼车 (粉橙渐变) - 跨 2 行 -->
      {leftBig && (
        <div class="md:row-span-2 space-y-5">
          <a
            href={`/services/${leftBig.data.slug}`}
            class="group relative block aspect-square rounded-3xl gradient-pink overflow-hidden flex items-center justify-center hover:scale-[1.01] transition-transform"
          >
            <!-- 装饰圆 (类似 MiniMax 3D 几何效果) -->
            <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/10 blur-3xl"></div>
            <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-[#7A27FF]/30 blur-3xl"></div>
            <div class="absolute bottom-10 -left-10 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>

            <div class="relative text-center text-white">
              <!-- maximax icon (Users 表示拼车多人共享) -->
              <div class="inline-flex items-center justify-center h-20 w-20 rounded-2xl bg-white/20 backdrop-blur-sm mb-6">
                <Icon name="Users" class="text-white" size={40} />
              </div>
              <div class="text-[clamp(3rem,6vw,5rem)] font-bold tracking-[-0.04em] leading-[0.95]">
                Max<br />拼车
              </div>
            </div>
          </a>
          <!-- 文字在卡外 (白底黑字) -->
          <div class="px-2">
            <h3 class="text-[22px] font-bold text-[#181E25] tracking-tight">Max 拼车</h3>
            <p class="mt-2 text-[14px] text-[#6E7782] leading-relaxed">
              Claude Max 5x 团队拼车服务，2-4 人共享账号分摊费用，加 $3 人工费
            </p>
            <div class="mt-4 flex items-center gap-4 text-[12px] text-[#6E7782]">
              <span>2026-08</span>
              <span class="text-[#181E25] font-medium">了解更多 ›</span>
            </div>
          </div>
        </div>
      )}

      <!-- 右上：ChatGPT 充值 (紫渐变 + ChatGPT logo) -->
      {topRight && (
        <div class="space-y-5">
          <a
            href={`/services/${topRight.data.slug}`}
            class="group relative block aspect-square rounded-3xl gradient-purple overflow-hidden flex items-center justify-center hover:scale-[1.01] transition-transform"
          >
            <div class="absolute -top-8 -right-8 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>
            <div class="absolute -bottom-12 -left-12 w-48 h-48 rounded-full bg-white/10 blur-3xl"></div>

            <img
              src="/icons/openai.svg"
              alt="ChatGPT"
              class="relative h-32 w-32 md:h-40 md:w-40 object-contain brightness-0 invert"
              loading="lazy"
            />
          </a>
          <!-- 文字在卡外 (白底黑字) -->
          <div class="px-2">
            <h3 class="text-[18px] font-bold text-[#181E25] tracking-tight">ChatGPT 充值</h3>
            <p class="mt-1.5 text-[13px] text-[#6E7782] leading-relaxed">
              Plus / Pro 全档 · GPT-4o 无限 · o1 pro 深度推理
            </p>
            <div class="mt-3 flex items-center gap-4 text-[11px] text-[#6E7782]">
              <span>2026-08</span>
              <span class="text-[#181E25] font-medium">了解更多 ›</span>
            </div>
          </div>
        </div>
      )}

      <!-- 右下：Claude 充值 (Claude 主题色赤土 + Claude A logo) -->
      {bottomRight && (
        <div class="space-y-5">
          <a
            href={`/services/${bottomRight.data.slug}`}
            class="group relative block aspect-square rounded-3xl gradient-claude overflow-hidden flex items-center justify-center hover:scale-[1.01] transition-transform"
          >
            <div class="absolute -top-8 -right-8 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>
            <div class="absolute -bottom-12 -left-12 w-48 h-48 rounded-full bg-white/10 blur-3xl"></div>

            <img
              src="/icons/anthropic.svg"
              alt="Claude"
              class="relative h-32 w-32 md:h-40 md:w-40 object-contain brightness-0 invert"
              loading="lazy"
            />
          </a>
          <!-- 文字在卡外 (白底黑字) -->
          <div class="px-2">
            <h3 class="text-[18px] font-bold text-[#181E25] tracking-tight">Claude 充值</h3>
            <p class="mt-1.5 text-[13px] text-[#6E7782] leading-relaxed">
              Sonnet 4.5 + Opus 4.1 全模型 · Pro / Max 满血体验
            </p>
            <div class="mt-3 flex items-center gap-4 text-[11px] text-[#6E7782]">
              <span>2026-08</span>
              <span class="text-[#181E25] font-medium">了解更多 ›</span>
            </div>
          </div>
        </div>
      )}
    </div>

    <div class="mt-14 flex justify-center">
      <a href="/services/ai-aggregator">
        <Button className="rounded-full h-12 px-7 text-[15px] font-medium border border-[#E4E7EB] bg-white text-[#181E25] hover:border-[#181E25]">
          查看 AI 聚合 →
        </Button>
      </a>
    </div>
  </div>
</section>
