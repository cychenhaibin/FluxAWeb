---
import { getCollection } from 'astro:content';
import { Button } from '@/components/ui/button';

const services = await getCollection('services');
const svcMax = services.find((s) => s.data.slug === 'minimax');      // (1,1)+(2,1) 左大图 row-span-2
const svcChatGPT = services.find((s) => s.data.slug === 'chatgpt');  // (1,2) 右上 cell
const svcClaude = services.find((s) => s.data.slug === 'claude');     // (2,2) 右下 cell
---
<section class="py-24 bg-white">
  <div class="mx-auto mt-[50px] w-full max-w-[1126px] px-4 md:mt-[60px] md:px-0">
    <div class="section-heading centered mx-auto mb-[36px] max-w-[760px] text-center">
      <h2 class="m-0 text-[24px] font-bold leading-[1.2] tracking-[-0.2px] text-[#181E25] md:text-[40px] md:tracking-[-0.4px]">
        旗舰服务
      </h2>
      <p class="m-0 mt-2 flex w-full flex-col justify-center break-words text-center text-[16px] leading-[19.2px] text-[#86909C] md:mt-3">
        FluxA 主推三大业务，覆盖 ChatGPT 充值 / Claude 充值 / Max 拼车
      </p>
    </div>

    <!-- 2x2 grid (1:1 复刻 MiniMax 旗舰模型 布局: 大图 row-span-2 + 2 个 文字+图+底部行 cell) -->
    <div class="model-layout relative mx-auto grid max-w-[1126px] grid-cols-1 gap-[15px] md:grid-cols-2 md:grid-rows-2 md:gap-x-[34px] md:gap-y-6">
      <!-- (1,1) + (2,1) 左大图 row-span-2 h-[550px]：Max 拼车 (粉橙 + 大白字) -->
      {svcMax && (
        <a
          href={`/services/${svcMax.data.slug}`}
          class="model-card group relative overflow-hidden rounded-[16px] bg-transparent transition-colors duration-300 hover:bg-[#F7F8FA] has-[a:active]:bg-[#F7F8FA] md:rounded-[24px] model-card-large h-[368px] md:row-span-2 md:h-[550px] gradient-pink"
        >
          <!-- 装饰圆 (模糊光斑) -->
          <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/10 blur-3xl"></div>
          <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-[#7A27FF]/30 blur-3xl"></div>
          <div class="absolute bottom-10 -left-10 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>

          <!-- 大白字 (mobile top-272 + bottom-4, desktop left-6 + bottom-5) -->
          <div class="absolute left-1/2 top-[272px] bottom-4 z-[2] flex w-[min(calc(100%_-_32px),336px)] -translate-x-1/2 flex-col justify-between md:left-6 md:right-auto md:top-auto md:translate-x-0 md:bottom-5 md:w-[min(calc(100%_-_48px),336px)]">
            <div class="text-[clamp(2rem,5vw,4.5rem)] font-bold tracking-[-0.04em] leading-[0.95] text-white text-balance md:whitespace-pre-line">
              Max<br />拼车
            </div>
          </div>
        </a>
      )}

      <!-- (1,2) 右上 cell：ChatGPT 充值 (MiniMax model-card 1:1) -->
      {svcChatGPT && (
        <a
          href={`/services/${svcChatGPT.data.slug}`}
          class="model-card group relative overflow-hidden rounded-[16px] bg-transparent transition-colors duration-300 hover:bg-[#F7F8FA] has-[a:active]:bg-[#F7F8FA] md:rounded-[24px] flex h-auto flex-col pt-2.5 pb-2.5 md:block md:h-[264px] md:pt-0 md:pb-0"
        >
          <!-- 文字 (mobile flex order-2, desktop absolute left-6 right-[56%] top-5 bottom-5) -->
          <div class="z-[2] order-2 mx-auto mt-2.5 flex w-[min(calc(100%_-_32px),336px)] flex-col md:absolute md:left-6 md:right-[56%] md:top-5 md:bottom-5 md:z-[2] md:w-auto md:overflow-hidden">
            <h3 class="m-0 whitespace-normal text-[24px] font-bold leading-[1.16] tracking-[-0.4px] text-[#181E25] md:whitespace-pre-line md:text-[23px]">
              ChatGPT 充值
            </h3>
            <p class="m-0 mt-2 text-[14px] font-normal leading-[1.2] tracking-[0] text-[#000000] md:mt-2 md:text-[18px]">
              Plus / Pro 全档 · GPT-4o 无限 · o1 pro 深度推理
            </p>
          </div>

          <!-- 图 (mobile h-[253px] w-[min(...336px)] + rounded-[12px], desktop absolute right-6 top-6 w-[min(288px,48%)] aspect-[288/217] rounded-[14px]) -->
          <div class="model-image-frame relative order-1 mx-auto h-[253px] w-[min(calc(100%_-_32px),336px)] overflow-hidden rounded-[12px] md:absolute md:bottom-auto md:left-auto md:right-6 md:top-6 md:order-none md:aspect-[288/217] md:h-auto md:w-[min(288px,48%)] md:rounded-[14px]">
            <div class="absolute inset-0 gradient-purple"></div>
            <div class="absolute -top-8 -right-8 w-32 h-32 rounded-full bg-white/15 blur-2xl"></div>
            <img src="/icons/openai.svg" alt="OpenAI" class="absolute inset-0 m-auto w-20 h-20 md:w-24 md:h-24 brightness-0 invert relative z-10" />
          </div>

          <!-- 底部行 (mobile flex order-3, desktop absolute left-6 bottom-6) -->
          <footer class="flex flex-wrap items-center justify-start gap-x-4 gap-y-1 text-[13px] leading-none text-[#6E7782] order-3 md:absolute md:left-6 md:z-10 md:flex md:bottom-6 mt-3 md:mt-0">
            <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C]">2026-08</span>
            <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C] transition-opacity group-hover:opacity-60">了解更多<span aria-hidden="true" class="inline-flex w-[0.75em] items-center justify-center">&gt;</span></span>
          </footer>
        </a>
      )}

      <!-- (2,2) 右下 cell：Claude 充值 (MiniMax model-card 1:1) -->
      {svcClaude && (
        <a
          href={`/services/${svcClaude.data.slug}`}
          class="model-card group relative overflow-hidden rounded-[16px] bg-transparent transition-colors duration-300 hover:bg-[#F7F8FA] has-[a:active]:bg-[#F7F8FA] md:rounded-[24px] flex h-auto flex-col pt-2.5 pb-2.5 md:block md:h-[264px] md:pt-0 md:pb-0"
        >
          <!-- 文字 -->
          <div class="z-[2] order-2 mx-auto mt-2.5 flex w-[min(calc(100%_-_32px),336px)] flex-col md:absolute md:left-6 md:right-[56%] md:top-5 md:bottom-5 md:z-[2] md:w-auto md:overflow-hidden">
            <h3 class="m-0 whitespace-normal text-[24px] font-bold leading-[1.16] tracking-[-0.4px] text-[#181E25] md:whitespace-pre-line md:text-[23px]">
              Claude 充值
            </h3>
            <p class="m-0 mt-2 text-[14px] font-normal leading-[1.2] tracking-[0] text-[#000000] md:mt-2 md:text-[18px]">
              Sonnet 4.5 + Opus 4.1 全模型 · Pro / Max 满血体验
            </p>
          </div>

          <!-- 图 (Claude 赤土色) -->
          <div class="model-image-frame relative order-1 mx-auto h-[253px] w-[min(calc(100%_-_32px),336px)] overflow-hidden rounded-[12px] md:absolute md:bottom-auto md:left-auto md:right-6 md:top-6 md:order-none md:aspect-[288/217] md:h-auto md:w-[min(288px,48%)] md:rounded-[14px]">
            <div class="absolute inset-0 gradient-claude"></div>
            <div class="absolute -top-8 -right-8 w-32 h-32 rounded-full bg-white/15 blur-2xl"></div>
            <img src="/icons/anthropic.svg" alt="Anthropic" class="absolute inset-0 m-auto w-20 h-20 md:w-24 md:h-24 brightness-0 invert relative z-10" />
          </div>

          <!-- 底部行 -->
          <footer class="flex flex-wrap items-center justify-start gap-x-4 gap-y-1 text-[13px] leading-none text-[#6E7782] order-3 md:absolute md:left-6 md:z-10 md:flex md:bottom-6 mt-3 md:mt-0">
            <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C]">2026-08</span>
            <span class="inline-flex items-center font-normal text-[14px] leading-[1.2] text-[#86909C] transition-opacity group-hover:opacity-60">了解更多<span aria-hidden="true" class="inline-flex w-[0.75em] items-center justify-center">&gt;</span></span>
          </footer>
        </a>
      )}
    </div>

    <div class="mt-16 flex justify-center">
      <a href="/services/ai-aggregator">
        <Button className="rounded-full h-12 px-7 text-[15px] font-medium border border-[#E4E7EB] bg-white text-[#181E25] hover:border-[#181E25]">
          查看 AI 聚合 →
        </Button>
      </a>
    </div>
  </div>
</section>
