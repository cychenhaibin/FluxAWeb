---
import { getCollection } from 'astro:content';
import { Button } from '@/components/ui/button';

const services = await getCollection('services');
const leftBig = services.find((s) => s.data.slug === 'minimax');      // 左大：Max 拼车
const topRight = services.find((s) => s.data.slug === 'chatgpt');      // 右上：ChatGPT
const bottomRight = services.find((s) => s.data.slug === 'claude');    // 右下：Claude
---
<section class="py-24 bg-white">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.05] font-bold text-[#181E25] tracking-[-0.04em] text-balance">
        旗舰服务
      </h2>
      <p class="mt-5 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed">
        FluxA 主推三大业务，覆盖 ChatGPT 充值 / Claude 充值 / Max 拼车
      </p>
    </div>

    <!-- 1:1 复刻 MiniMax 旗舰模型 2 行 3 列布局 (左大图跨 2 行 + 中上文字 + 右上图 / 中下文字 + 右下图) -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- (1,1) + (2,1) 左大图：Max 拼车 (粉橙渐变 + 大白字) -->
      {leftBig && (
        <a
          href={`/services/${leftBig.data.slug}`}
          class="group md:row-span-2 relative aspect-square rounded-3xl gradient-pink overflow-hidden flex items-center justify-center hover:scale-[1.01] transition-transform"
        >
          <!-- 装饰圆 -->
          <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/10 blur-3xl"></div>
          <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-[#7A27FF]/30 blur-3xl"></div>
          <div class="absolute bottom-10 -left-10 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>

          <div class="relative text-center text-white px-6">
            <div class="text-[clamp(3rem,7vw,6.5rem)] font-bold tracking-[-0.04em] leading-[0.9]">
              Max<br />拼车
            </div>
          </div>
        </a>
      )}

      <!-- (1,2) 中上文字 cell：白底 + ChatGPT 充值标题 + 描述 + 日期 + 了解更多 -->
      {topRight && (
        <div class="aspect-square rounded-3xl bg-[#F7F8FA] p-6 md:p-8 flex flex-col justify-between">
          <div>
            <h3 class="text-[24px] md:text-[28px] font-bold text-[#181E25] tracking-tight leading-tight">
              ChatGPT 充值
            </h3>
            <p class="mt-2 text-[14px] text-[#6E7782] leading-relaxed">
              Plus / Pro 全档 · GPT-4o 无限 · o1 pro 深度推理
            </p>
          </div>
          <div class="flex items-center justify-between text-[12px] text-[#6E7782]">
            <span>2026-08</span>
            <a href={`/services/${topRight.data.slug}`} class="text-[#181E25] font-medium hover:text-[#7A27FF]">了解更多 ›</a>
          </div>
        </div>
      )}

      <!-- (1,3) 右上图：ChatGPT 充值 (紫渐变 + 大白字) -->
      {topRight && (
        <a
          href={`/services/${topRight.data.slug}`}
          class="group relative aspect-square rounded-3xl gradient-purple overflow-hidden flex items-center justify-center hover:scale-[1.01] transition-transform"
        >
          <div class="absolute -top-8 -right-8 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>
          <div class="absolute -bottom-12 -left-12 w-48 h-48 rounded-full bg-white/10 blur-3xl"></div>

          <div class="relative text-center text-white px-4">
            <div class="text-[clamp(2rem,4.5vw,4rem)] font-bold tracking-[-0.04em] leading-[0.95]">
              ChatGPT<br />充值
            </div>
          </div>
        </a>
      )}

      <!-- (2,2) 中下文字 cell：白底 + Claude 充值标题 + 描述 + 日期 + 了解更多 -->
      {bottomRight && (
        <div class="aspect-square rounded-3xl bg-[#F7F8FA] p-6 md:p-8 flex flex-col justify-between">
          <div>
            <h3 class="text-[24px] md:text-[28px] font-bold text-[#181E25] tracking-tight leading-tight">
              Claude 充值
            </h3>
            <p class="mt-2 text-[14px] text-[#6E7782] leading-relaxed">
              Sonnet 4.5 + Opus 4.1 全模型 · Pro / Max 满血体验
            </p>
          </div>
          <div class="flex items-center justify-between text-[12px] text-[#6E7782]">
            <span>2026-08</span>
            <a href={`/services/${bottomRight.data.slug}`} class="text-[#181E25] font-medium hover:text-[#7A27FF]">了解更多 ›</a>
          </div>
        </div>
      )}

      <!-- (2,3) 右下图：Claude 充值 (Claude 主题色赤土 + 大白字) -->
      {bottomRight && (
        <a
          href={`/services/${bottomRight.data.slug}`}
          class="group relative aspect-square rounded-3xl gradient-claude overflow-hidden flex items-center justify-center hover:scale-[1.01] transition-transform"
        >
          <div class="absolute -top-8 -right-8 w-40 h-40 rounded-full bg-white/15 blur-2xl"></div>
          <div class="absolute -bottom-12 -left-12 w-48 h-48 rounded-full bg-white/10 blur-3xl"></div>

          <div class="relative text-center text-white px-4">
            <div class="text-[clamp(2rem,4.5vw,4rem)] font-bold tracking-[-0.04em] leading-[0.95]">
              Claude<br />充值
            </div>
          </div>
        </a>
      )}
    </div>

    <!-- 左大图下方的文字 (白底黑字) - Max 拼车配文 -->
    {leftBig && (
      <div class="mt-6 max-w-[calc((100%-3rem)/3)]">
        <h3 class="text-[24px] font-bold text-[#181E25] tracking-tight">Max 拼车</h3>
        <p class="mt-2 text-[14px] text-[#6E7782] leading-relaxed">
          Claude Max 5x 团队拼车服务，2-4 人共享账号分摊费用，加 $3 人工费
        </p>
        <div class="mt-3 flex items-center gap-4 text-[12px] text-[#6E7782]">
          <span>2026-08</span>
          <a href={`/services/${leftBig.data.slug}`} class="text-[#181E25] font-medium hover:text-[#7A27FF]">了解更多 ›</a>
        </div>
      </div>
    )}

    <div class="mt-16 flex justify-center">
      <a href="/services/ai-aggregator">
        <Button className="rounded-full h-12 px-7 text-[15px] font-medium border border-[#E4E7EB] bg-white text-[#181E25] hover:border-[#181E25]">
          查看 AI 聚合 →
        </Button>
      </a>
    </div>
  </div>
</section>
