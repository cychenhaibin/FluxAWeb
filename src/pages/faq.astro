---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import FaqAccordion from '@/components/faq-accordion';

const faqEntry = await getEntry('faq', 'faq');
const items = faqEntry?.data ?? [];
---
<BaseLayout title="常见问题 - FluxA">
  <section class="py-24 bg-zinc-950">
    <div class="container mx-auto max-w-3xl px-4">
      <div class="text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900/60 px-3 py-1 text-xs text-zinc-400 mb-6">
          <span class="h-1.5 w-1.5 rounded-full bg-purple-400"></span>
          7×24 客服
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-white tracking-tighter">常见问题</h1>
        <p class="mt-6 text-lg text-zinc-400">下单、账户、续费、退款——这里有你想问的</p>
      </div>

      <div class="mt-12 backdrop-blur-md bg-zinc-900/40 border border-zinc-800 rounded-2xl p-3">
        <FaqAccordion client:visible items={items} />
      </div>
    </div>
  </section>
</BaseLayout>
