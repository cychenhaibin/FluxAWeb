---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import FaqAccordion from '@/components/faq-accordion';

const faqEntry = await getEntry('faq', 'faq');
const items = faqEntry?.data ?? [];
---
<BaseLayout title="常见问题 - FluxA">
  <section class="relative bg-[#08090a] pt-32 pb-12 overflow-hidden">
    <div class="container mx-auto max-w-6xl px-4">
      <div class="flex items-end justify-between gap-8">
        <h1 class="text-[clamp(2.5rem,6.5vw,5rem)] leading-[0.95] font-semibold text-white tracking-[-0.04em] text-balance max-w-3xl">常见问题</h1>
        <div class="hidden md:flex items-center gap-1.5 text-[13px] text-zinc-400 shrink-0 pb-3">
          <span class="px-1.5 py-0.5 rounded-md bg-[#5e6ad2] text-white text-[11px] font-medium uppercase tracking-wider">FAQ</span>
        </div>
      </div>
      <p class="mt-6 text-[15px] md:text-base text-zinc-400 leading-relaxed text-pretty max-w-2xl">
        8 个常见问题 · 5 个分类。<br />
        下单、账户、续费、退款——这里有你想问的。
      </p>
    </div>
  </section>

  <section class="bg-[#08090a] pb-24">
    <div class="container mx-auto max-w-3xl px-4">
      <div class="card rounded-md overflow-hidden divide-y divide-white/5">
        <FaqAccordion client:visible items={items} />
      </div>
    </div>
  </section>
</BaseLayout>
