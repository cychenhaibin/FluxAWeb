---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import FaqAccordion from '@/components/faq-accordion';

const faqEntry = await getEntry('faq', 'faq');
const items = faqEntry?.data ?? [];
---
<BaseLayout title="常见问题 - FluxA">
  <section class="py-24 mesh-soft">
    <div class="container mx-auto max-w-3xl px-4">
      <div class="text-center">
        <div class="inline-flex items-center gap-2 rounded-full bg-white/80 border border-black/5 px-3 py-1 text-[12px] text-zinc-600 mb-5 shadow-apple">
          <span class="h-1.5 w-1.5 rounded-full bg-[#ec4899]"></span>
          7×24 客服
        </div>
        <h1 class="text-4xl md:text-[56px] font-semibold text-zinc-900 tracking-[-0.02em] leading-[1.1] text-balance">
          常见 <span class="text-gradient">问题</span>
        </h1>
        <p class="mt-5 text-base md:text-lg text-zinc-600">下单、账户、续费、退款——这里有你想问的</p>
      </div>

      <div class="mt-10 glass rounded-3xl overflow-hidden divide-y divide-black/5">
        <FaqAccordion client:visible items={items} />
      </div>
    </div>
  </section>
</BaseLayout>
