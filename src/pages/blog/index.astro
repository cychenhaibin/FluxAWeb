---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Card, CardContent } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { BookOpen } from 'lucide-react';

const posts = [
  { slug: 'fast-fulfillment', title: '5 分钟极速到账：我们的订单系统重构之路', date: '2026-07-01', tag: '工程实践', summary: '我们重构了订单系统，实现 5 分钟极速到账，特殊情况下 30 分钟内人工处理。' },
  { slug: 'transparent-pricing', title: '$3 服务费透明计费：为什么我们只收这么多', date: '2026-06-20', tag: '价格政策', summary: '我们坚持透明计费，每单仅 $3 服务费，无隐藏费用，所有渠道一视同仁。' },
  { slug: 'o1-pro-mode', title: 'OpenAI o1 pro 模式正式支持', date: '2026-06-10', tag: '技术', summary: 'Pro 100 套餐已正式支持 o1 pro 深度推理模式，欢迎体验。' },
  { slug: 'sonnet-4-5', title: 'Anthropic Sonnet 4.5 发布', date: '2026-05-25', tag: '行业', summary: 'Sonnet 4.5 已正式发布，Max 5x/20x 套餐同步支持。' },
];
---
<BaseLayout title="博客 - FluxA">
  <section class="w-full bg-background py-20 md:py-28 border-b border-border">
    <div class="container-fluid">
      <div class="mx-auto max-w-2xl text-center">
        <Badge variant="outline" className="mb-4 rounded-full px-3 py-1 text-xs font-medium">
          <BookOpen className="h-3 w-3" />
          FluxA 博客
        </Badge>
        <h1 class="text-balance text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
          工程 · 价格 · 技术 · 行业
        </h1>
      </div>
    </div>
  </section>

  <section class="w-full bg-background py-20 md:py-28">
    <div class="container-fluid max-w-4xl">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {posts.map((p) => (
          <a href={`/blog/${p.slug}`} class="block">
            <Card className="h-full transition-all hover:border-foreground/20 hover:shadow-sm">
              <CardContent className="p-6">
                <Badge variant="secondary" className="rounded-full px-2.5 py-0.5 text-[10px] font-medium uppercase tracking-wider">
                  {p.tag}
                </Badge>
                <h2 class="mt-3 text-lg font-semibold tracking-tight text-foreground">
                  {p.title}
                </h2>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                  {p.summary}
                </p>
                <div class="mt-4 text-xs text-muted-foreground">{p.date}</div>
              </CardContent>
            </Card>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
