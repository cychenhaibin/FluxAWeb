---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Pricing from '@/components/sections/pricing';

const services = (await getCollection('services')).map((s) => ({
  slug: s.data.slug,
  name: s.data.name,
}));
const pricingList = await getCollection('pricing');
const pricingByService = Object.fromEntries(
  pricingList.map((p) => [p.data.service, p.data])
);
const order = ['chatgpt', 'claude', 'minimax', 'ai-aggregator'];
const orderedServices = [...services].sort(
  (a, b) => order.indexOf(a.slug) - order.indexOf(b.slug)
);
---
<BaseLayout
  title="价格方案 - FluxA"
  description="FluxA 价格方案 — ChatGPT / Claude / MiniMax Max 拼车 / AI 聚合，官方价 + 仅 $3 服务费。"
>
  <Pricing
    client:load
    services={orderedServices}
    pricingByService={pricingByService}
  />
</BaseLayout>
