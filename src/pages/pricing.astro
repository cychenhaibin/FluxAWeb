---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/lib/site-config';
import PricingTabs from '@/components/pricing-tabs';

const navOrder = siteConfig.nav
  .filter((n) => n.href.startsWith('/services/'))
  .map((n) => n.href.split('/').pop());
const services = (await getCollection('services')).sort(
  (a, b) => navOrder.indexOf(a.data.slug) - navOrder.indexOf(b.data.slug)
);
const pricingList = await getCollection('pricing');
const pricingByService = Object.fromEntries(pricingList.map((p) => [p.data.service.id, p.data]));
---
<BaseLayout title="价格 - FluxA">
  <section class="relative py-24 bg-[#0a0a14] mesh-bg overflow-hidden">
    <div class="container mx-auto max-w-6xl px-4 relative">
      <div class="text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[12px] text-zinc-300 mb-5 backdrop-blur-md">
          <span class="h-1.5 w-1.5 rounded-full bg-[#ff6b35]"></span>
          官方价透明
        </div>
        <h1 class="text-4xl md:text-[56px] font-semibold text-white tracking-[-0.015em] leading-[1.15] text-balance">价格方案</h1>
        <p class="mt-5 text-base md:text-lg text-zinc-400">每档套餐仅加 $3 人工费，5 分钟开通</p>
      </div>

      <div class="mt-10 mx-auto max-w-3xl rounded-2xl border border-amber-500/30 bg-amber-500/10 p-4 text-sm text-amber-200 flex items-start gap-3 backdrop-blur-md">
        <span class="text-base">⚠️</span>
        <div>
          <strong class="font-semibold">价格说明：</strong>
          所有套餐均为官方价 + $3 人工费。下单前请确认账号状态，下单后 5 分钟内开通。如对价格有疑问，请联系客服。
        </div>
      </div>

      <div class="mt-10">
        <PricingTabs client:visible services={services.map(s => ({slug: s.data.slug, name: s.data.name}))} pricingByService={pricingByService} />
      </div>
    </div>
  </section>
</BaseLayout>
