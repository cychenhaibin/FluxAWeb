---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/lib/site-config';
import PricingTabs from '@/components/pricing-tabs';

const navOrder = siteConfig.nav
  .filter((n) => n.href.startsWith('/services/'))
  .map((n) => n.href.split('/').pop());
const services = (await getCollection('services')).sort(
  (a, b) => navOrder.indexOf(a.data.slug) - navOrder.indexOf(b.data.slug)
);
const pricingList = await getCollection('pricing');
const pricingByService = Object.fromEntries(pricingList.map((p) => [p.data.service.id, p.data]));
---
<BaseLayout title="价格 - FluxA">
  <section class="relative bg-[#08090a] pt-32 pb-12 overflow-hidden">
    <div class="container mx-auto max-w-6xl px-4">
      <div class="flex items-end justify-between gap-8">
        <h1 class="text-[clamp(2.5rem,6.5vw,5rem)] leading-[0.95] font-semibold text-white tracking-[-0.04em] text-balance max-w-3xl">价格方案</h1>
        <div class="hidden md:flex items-center gap-1.5 text-[13px] text-zinc-400 shrink-0 pb-3">
          <span class="px-1.5 py-0.5 rounded-md bg-[#5e6ad2] text-white text-[11px] font-medium uppercase tracking-wider">Pricing</span>
        </div>
      </div>
      <p class="mt-6 text-[15px] md:text-base text-zinc-400 leading-relaxed text-pretty max-w-2xl">
        4 块业务 · 11 个套餐可选。<br />
        所有套餐均为官方价 + $3 人工费，5 分钟极速到账。
      </p>
    </div>
  </section>

  <section class="bg-[#08090a] pb-24">
    <div class="container mx-auto max-w-6xl px-4">
      <div class="mx-auto max-w-3xl rounded-md border border-amber-500/30 bg-amber-500/10 p-4 text-sm text-amber-200 flex items-start gap-3">
        <span class="text-base">⚠️</span>
        <div>
          <strong class="font-semibold">价格说明：</strong>
          所有套餐均为官方价 + $3 人工费。下单前请确认账号状态，下单后 5 分钟内开通。如对价格有疑问，请联系客服。
        </div>
      </div>

      <div class="mt-10">
        <PricingTabs client:visible services={services.map(s => ({slug: s.data.slug, name: s.data.name}))} pricingByService={pricingByService} />
      </div>
    </div>
  </section>
</BaseLayout>
