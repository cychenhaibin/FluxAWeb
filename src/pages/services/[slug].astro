---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/lib/site-config';
import Icon from '@/components/icon.astro';
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Check, ArrowRight, BadgeDollarSign } from 'lucide-react';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const data = service.data;
const pricing = await getEntry('pricing', data.slug);

const tierCount = pricing?.data.tiers.length ?? 0;
const startingTier = pricing?.data.tiers[0];
const startingPrice = startingTier
  ? `${startingTier.price}${startingTier.period ?? ''}`
  : null;
---
<BaseLayout title={`${data.name} - ${siteConfig.title}`} description={data.tagline}>
  <!-- Hero -->
  <section class="w-full bg-background py-16 md:py-24 border-b border-border">
    <div class="container-fluid">
      <div class="mx-auto max-w-2xl text-center">
        <Badge variant="outline" className="mb-5 rounded-full px-3 py-1 text-xs font-medium">
          {data.showcase?.badge ?? data.name}
        </Badge>
        <h1 class="text-balance text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
          {data.name}
        </h1>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground sm:text-base">
          {data.tagline}
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <Button asChild size="lg">
            <a href="#pricing">
              查看套餐
              <ArrowRight className="h-4 w-4" />
            </a>
          </Button>
          <Button asChild size="lg" variant="outline">
            <a href="/contact">{data.ctaLabel}</a>
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- 描述 + 起售价 -->
  <section class="w-full bg-background py-12 border-b border-border">
    <div class="container-fluid max-w-3xl">
      <p class="text-center text-sm leading-relaxed text-foreground/80 sm:text-base">
        {data.description}
      </p>
      {startingPrice && (
        <div class="mt-6 flex justify-center">
          <div class="inline-flex items-center gap-3 rounded-md border border-border bg-background px-4 py-2 text-sm">
            <span class="text-muted-foreground">起售价</span>
            <span class="font-semibold text-foreground tnum">{startingPrice}</span>
            {tierCount > 0 && (
              <>
                <span class="text-border">·</span>
                <span class="text-muted-foreground">共 {tierCount} 个套餐</span>
              </>
            )}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- 核心亮点 -->
  <section class="w-full bg-muted/30 py-20 md:py-24 border-b border-border">
    <div class="container-fluid">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-balance text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
          核心亮点
        </h2>
        <p class="mt-3 text-sm text-muted-foreground">为什么选择 {data.name}</p>
      </div>
      <div class="mx-auto mt-12 grid max-w-5xl grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {data.highlights.map((h) => (
          <Card className="h-full transition-all hover:border-foreground/20 hover:shadow-sm">
            <CardHeader className="gap-3">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-md bg-foreground text-background">
                <Icon name={h.icon} size={18} class="text-background" />
              </span>
              <CardTitle className="text-base font-semibold tracking-tight">{h.title}</CardTitle>
              <CardDescription className="text-sm leading-relaxed">{h.description}</CardDescription>
            </CardHeader>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- 套餐价格 -->
  {pricing && pricing.data.tiers.length > 0 && (
    <section id="pricing" class="w-full bg-background py-20 md:py-24 border-b border-border">
      <div class="container-fluid max-w-5xl">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-balance text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            套餐价格
          </h2>
          <p class="mt-3 text-sm text-muted-foreground">
            官方价 + 仅 $3 服务费 · 5 分钟到账
          </p>
        </div>
        <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-3">
          {pricing.data.tiers.map((tier) => (
            <Card
              className={
                "flex h-full flex-col transition-all " +
                (tier.recommended
                  ? "border-foreground/30 shadow-sm ring-1 ring-foreground/10"
                  : "hover:border-foreground/20 hover:shadow-sm")
              }
            >
              <CardHeader className="gap-2">
                {tier.recommended && (
                  <Badge
                    variant="default"
                    className="self-start rounded-full px-2.5 text-[10px] font-medium uppercase tracking-wider"
                  >
                    推荐
                  </Badge>
                )}
                <CardTitle className="text-lg font-semibold tracking-tight">
                  {tier.name}
                </CardTitle>
                <div class="flex items-baseline gap-2 mt-2">
                  <span class="text-3xl font-semibold tracking-tight tnum text-foreground">
                    {tier.price}
                  </span>
                  {tier.period && (
                    <span class="text-sm text-muted-foreground">{tier.period}</span>
                  )}
                </div>
                {(tier.originalPrice || tier.serviceFee) && (
                  <div class="mt-2 flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground">
                    {tier.originalPrice && (
                      <span class="rounded-md bg-muted px-2 py-0.5">
                        官方 ${tier.originalPrice}
                      </span>
                    )}
                    {tier.serviceFee && (
                      <span class="inline-flex items-center gap-1 rounded-md bg-muted px-2 py-0.5">
                        <BadgeDollarSign className="h-3 w-3" />
                        服务费 ${tier.serviceFee}
                      </span>
                    )}
                  </div>
                )}
              </CardHeader>
              <CardContent className="mt-2 flex flex-1 flex-col">
                <ul class="space-y-2.5 text-sm text-foreground/80 flex-1">
                  {tier.features.map((f) => (
                    <li class="flex items-start gap-2.5">
                      <span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-sm bg-foreground text-background">
                        <Check className="h-3 w-3" strokeWidth={3} />
                      </span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
                <Button
                  asChild
                  variant={tier.recommended ? "default" : "outline"}
                  className="mt-6 w-full"
                >
                  <a href="/contact">
                    {tier.ctaLabel}
                    <ArrowRight className="h-4 w-4" />
                  </a>
                </Button>
              </CardContent>
            </Card>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 底部 CTA -->
  <section class="w-full bg-foreground py-16 text-background">
    <div class="container-fluid text-center">
      <h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        {data.demo?.description ?? `立即开始使用 ${data.name}`}
      </h3>
      <div class="mt-6 flex justify-center">
        <Button
          asChild
          size="lg"
          className="bg-background text-foreground hover:bg-background/90"
        >
          <a href="/pricing">
            查看所有套餐
            <ArrowRight className="h-4 w-4" />
          </a>
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
