---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Card, CardHeader, CardTitle, CardDescription } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { MessageCircle, Mail, Ticket, ChevronRight } from 'lucide-react';
import { siteConfig } from '@/lib/site-config';

const { contact } = siteConfig;

const channels = [
  {
    icon: MessageCircle,
    title: contact.wechat.name,
    desc: '扫码添加客服微信，实时沟通、订单咨询。',
    qr: contact.wechat.qrPlaceholder,
    isQr: true,
  },
  {
    icon: Mail,
    title: contact.email.name,
    desc: '商务合作、退款申诉、发票申请。',
    link: `mailto:${contact.email.address}`,
    linkLabel: contact.email.address,
  },
  {
    icon: Ticket,
    title: contact.ticket.name,
    desc: '提交工单，技术问题逐条跟踪回复。',
    link: contact.ticket.url,
    linkLabel: '提交工单',
  },
];
---
<BaseLayout title="联系我们 - FluxA">
  <section class="w-full bg-background py-20 md:py-28 border-b border-border">
    <div class="container-fluid">
      <div class="mx-auto max-w-2xl text-center">
        <Badge variant="outline" className="mb-4 rounded-full px-3 py-1 text-xs font-medium">
          联系我们
        </Badge>
        <h1 class="text-balance text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
          3 种联系方式
        </h1>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground sm:text-base">
          7×24 在线响应 · 工作日 5 分钟内真人客服回复
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl grid-cols-1 gap-4 md:grid-cols-3">
        {channels.map((c) => {
          const Icon = c.icon;
          const inner = (
            <Card className="h-full transition-all hover:border-foreground/20 hover:shadow-sm">
              <CardHeader className="items-center gap-3 text-center">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-md bg-foreground text-background">
                  <Icon className="h-5 w-5" />
                </span>
                <CardTitle className="text-base font-semibold tracking-tight">{c.title}</CardTitle>
                <CardDescription className="text-sm leading-relaxed">{c.desc}</CardDescription>
                {c.isQr ? (
                  <img
                    src={c.qr}
                    alt="客服微信二维码"
                    width="120"
                    height="120"
                    class="mt-3 rounded-md border border-border bg-background p-1.5"
                  />
                ) : (
                  <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-foreground">
                    {c.linkLabel}
                    <ChevronRight className="h-3.5 w-3.5" />
                  </span>
                )}
              </CardHeader>
            </Card>
          );
          return c.isQr ? (
            <div>{inner}</div>
          ) : (
            <a href={c.link} target={c.link?.startsWith('http') ? '_blank' : undefined} rel={c.link?.startsWith('http') ? 'noopener noreferrer' : undefined} class="block">
              {inner}
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
