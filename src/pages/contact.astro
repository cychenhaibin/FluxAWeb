---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/icon.astro';
import { siteConfig } from '@/lib/site-config';

const { contact } = siteConfig;
---
<BaseLayout title="联系我们 - FluxA">
  <section class="relative py-24 bg-[#08090a]  overflow-hidden">
    <div class="container mx-auto max-w-6xl px-4 relative">
      <div class="text-center max-w-2xl mx-auto">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[12px] text-zinc-300 mb-5 backdrop-blur-md">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          真人值守
        </div>
        <h1 class="text-4xl md:text-[56px] font-semibold text-white tracking-[-0.025em] leading-[1.1] text-balance">联系我们</h1>
        <p class="mt-5 text-base md:text-lg text-zinc-400">三种方式，7×24 在线响应</p>
      </div>

      <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="card rounded-xl p-7 flex flex-col items-center text-center hover:border-[#5e6ad2]/50 transition-all">
          <div class="h-14 w-14 rounded-xl bg-[#5e6ad2]/15 border border-[#5e6ad2]/25 flex items-center justify-center text-[#5e6ad2]">
            <Icon name="MessageCircle" size={28} />
          </div>
          <h2 class="mt-5 text-lg font-semibold text-white">{contact.wechat.name}</h2>
          <p class="mt-2 text-sm text-zinc-400">扫码添加客服微信，实时沟通、订单咨询</p>
          <img
            src={contact.wechat.qrPlaceholder}
            alt="客服微信二维码"
            width="96"
            height="96"
            class="mt-5 rounded-xl border border-white/10 bg-white p-1"
          />
        </div>

        <a
          href={`mailto:${contact.email.address}`}
          class="card rounded-xl p-7 flex flex-col items-center text-center hover:border-[#5e6ad2]/50 transition-all"
        >
          <div class="h-14 w-14 rounded-xl bg-[#5e6ad2]/15 border border-[#5e6ad2]/25 flex items-center justify-center text-[#5e6ad2]">
            <Icon name="Mail" size={28} />
          </div>
          <h2 class="mt-5 text-lg font-semibold text-white">{contact.email.name}</h2>
          <p class="mt-2 text-sm text-zinc-400">商务合作、退款申诉、发票申请</p>
          <span class="mt-5 text-[#5e6ad2] hover:text-[#c4c5f5] font-medium break-all">
            {contact.email.address}
          </span>
        </a>

        <a
          href={contact.ticket.url}
          target="_blank"
          rel="noopener noreferrer"
          class="card rounded-xl p-7 flex flex-col items-center text-center hover:border-[#5e6ad2]/50 transition-all"
        >
          <div class="h-14 w-14 rounded-xl bg-[#5e6ad2]/15 border border-[#5e6ad2]/25 flex items-center justify-center text-[#5e6ad2]">
            <Icon name="Ticket" size={28} />
          </div>
          <h2 class="mt-5 text-lg font-semibold text-white">{contact.email.name}</h2>
          <p class="mt-2 text-sm text-zinc-400">提交工单，技术问题逐条跟踪回复</p>
          <span class="mt-5 inline-flex items-center gap-1 text-[#5e6ad2] hover:text-[#c4c5f5] font-medium">
            提交工单
            <Icon name="ChevronRight" size={16} />
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
