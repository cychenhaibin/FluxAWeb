---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/icon.astro';
import { siteConfig } from '@/lib/site-config';

const { contact } = siteConfig;
---
<BaseLayout title="联系我们 - FluxA">
  <section class="relative bg-white pt-24 pb-12 overflow-hidden">
    <div class="container mx-auto max-w-6xl px-4 text-center">
      <h1 class="text-[clamp(2.5rem,7vw,5rem)] leading-[1.05] font-bold text-[#181E25] tracking-[-0.04em] text-balance">
        联系 <span class="gradient-pink-text">我们</span>
      </h1>
      <p class="mt-6 text-[16px] md:text-[18px] text-[#6E7782] leading-relaxed max-w-2xl mx-auto">
        3 种联系方式 · 7×24 在线响应。<br />
        工作日 5 分钟内真人客服回复。
      </p>
    </div>
  </section>

  <section class="bg-white pb-24">
    <div class="container mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="rounded-3xl bg-white border border-[#E4E7EB] p-8 flex flex-col items-center text-center card-hover">
          <div class="h-14 w-14 rounded-2xl gradient-pink flex items-center justify-center text-white">
            <Icon name="MessageCircle" size={26} />
          </div>
          <h2 class="mt-5 text-[18px] font-bold text-[#181E25]">{contact.wechat.name}</h2>
          <p class="mt-2 text-[14px] text-[#6E7782]">扫码添加客服微信，实时沟通、订单咨询</p>
          <img
            src={contact.wechat.qrPlaceholder}
            alt="客服微信二维码"
            width="120"
            height="120"
            class="mt-6 rounded-2xl border border-[#E4E7EB] bg-white p-1.5"
          />
        </div>

        <a
          href={`mailto:${contact.email.address}`}
          class="rounded-3xl bg-white border border-[#E4E7EB] p-8 flex flex-col items-center text-center card-hover"
        >
          <div class="h-14 w-14 rounded-2xl gradient-purple flex items-center justify-center text-white">
            <Icon name="Mail" size={26} />
          </div>
          <h2 class="mt-5 text-[18px] font-bold text-[#181E25]">{contact.email.name}</h2>
          <p class="mt-2 text-[14px] text-[#6E7782]">商务合作、退款申诉、发票申请</p>
          <span class="mt-6 text-[#7A27FF] hover:opacity-80 font-semibold break-all text-[14px]">
            {contact.email.address}
          </span>
        </a>

        <a
          href={contact.ticket.url}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-3xl bg-white border border-[#E4E7EB] p-8 flex flex-col items-center text-center card-hover"
        >
          <div class="h-14 w-14 rounded-2xl gradient-blue flex items-center justify-center text-white">
            <Icon name="Ticket" size={26} />
          </div>
          <h2 class="mt-5 text-[18px] font-bold text-[#181E25]">{contact.ticket.name}</h2>
          <p class="mt-2 text-[14px] text-[#6E7782]">提交工单，技术问题逐条跟踪回复</p>
          <span class="mt-6 inline-flex items-center gap-1 text-[#7A27FF] hover:opacity-80 font-semibold text-[14px]">
            提交工单
            <Icon name="ChevronRight" size={16} />
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
