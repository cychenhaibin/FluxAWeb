---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/icon.astro';
import { siteConfig } from '@/lib/site-config';

const { contact } = siteConfig;
---
<BaseLayout title="联系我们 - FluxA">
  <section class="relative bg-[#08090a] pt-32 pb-12 overflow-hidden">
    <div class="container mx-auto max-w-6xl px-4">
      <div class="flex items-end justify-between gap-8">
        <h1 class="text-[clamp(2.5rem,6.5vw,5rem)] leading-[0.95] font-semibold text-white tracking-[-0.04em] text-balance max-w-3xl">联系我们</h1>
        <div class="hidden md:flex items-center gap-1.5 text-[13px] text-zinc-400 shrink-0 pb-3">
          <span class="px-1.5 py-0.5 rounded-md bg-emerald-500 text-white text-[11px] font-medium uppercase tracking-wider">Online</span>
        </div>
      </div>
      <p class="mt-6 text-[15px] md:text-base text-zinc-400 leading-relaxed text-pretty max-w-2xl">
        3 种联系方式 · 7×24 在线响应。<br />
        工作日 5 分钟内真人客服回复。
      </p>
    </div>
  </section>

  <section class="bg-[#08090a] pb-24">
    <div class="container mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="card rounded-md p-7 flex flex-col items-center text-center hover:border-[#5e6ad2]/50 transition-all">
          <div class="h-12 w-12 rounded-md bg-[#5e6ad2]/15 border border-[#5e6ad2]/25 flex items-center justify-center text-[#5e6ad2]">
            <Icon name="MessageCircle" size={24} />
          </div>
          <h2 class="mt-5 text-[15px] font-semibold text-white">{contact.wechat.name}</h2>
          <p class="mt-2 text-sm text-zinc-400">扫码添加客服微信，实时沟通、订单咨询</p>
          <img
            src={contact.wechat.qrPlaceholder}
            alt="客服微信二维码"
            width="96"
            height="96"
            class="mt-5 rounded-md border border-white/10 bg-white p-1"
          />
        </div>

        <a
          href={`mailto:${contact.email.address}`}
          class="card rounded-md p-7 flex flex-col items-center text-center hover:border-[#5e6ad2]/50 transition-all"
        >
          <div class="h-12 w-12 rounded-md bg-[#5e6ad2]/15 border border-[#5e6ad2]/25 flex items-center justify-center text-[#5e6ad2]">
            <Icon name="Mail" size={24} />
          </div>
          <h2 class="mt-5 text-[15px] font-semibold text-white">{contact.email.name}</h2>
          <p class="mt-2 text-sm text-zinc-400">商务合作、退款申诉、发票申请</p>
          <span class="mt-5 text-[#5e6ad2] hover:text-[#c4c5f5] font-medium break-all text-sm">
            {contact.email.address}
          </span>
        </a>

        <a
          href={contact.ticket.url}
          target="_blank"
          rel="noopener noreferrer"
          class="card rounded-md p-7 flex flex-col items-center text-center hover:border-[#5e6ad2]/50 transition-all"
        >
          <div class="h-12 w-12 rounded-md bg-[#5e6ad2]/15 border border-[#5e6ad2]/25 flex items-center justify-center text-[#5e6ad2]">
            <Icon name="Ticket" size={24} />
          </div>
          <h2 class="mt-5 text-[15px] font-semibold text-white">{contact.ticket.name}</h2>
          <p class="mt-2 text-sm text-zinc-400">提交工单，技术问题逐条跟踪回复</p>
          <span class="mt-5 inline-flex items-center gap-1 text-[#5e6ad2] hover:text-[#c4c5f5] font-medium text-sm">
            提交工单
            <Icon name="ChevronRight" size={16} />
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
