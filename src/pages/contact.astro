---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/icon.astro';
import { siteConfig } from '@/lib/site-config';

const { contact } = siteConfig;
---
<BaseLayout title="联系我们 - FluxA">
  <section class="relative py-24 bg-zinc-950 overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-indigo-500/10 rounded-full blur-3xl -z-0"></div>

    <div class="container mx-auto max-w-6xl px-4 relative">
      <div class="text-center max-w-2xl mx-auto">
        <div class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900/60 px-3 py-1 text-xs text-zinc-400 mb-6">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
          真人值守
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-white tracking-tighter">联系我们</h1>
        <p class="mt-6 text-lg text-zinc-400">三种方式，7×24 在线响应</p>
      </div>

      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="backdrop-blur-md bg-zinc-900/40 border border-zinc-800 rounded-2xl p-8 flex flex-col items-center text-center hover:border-zinc-700 transition-all">
          <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-indigo-500/20 to-cyan-500/20 border border-indigo-500/30 flex items-center justify-center text-indigo-300">
            <Icon name="MessageCircle" size={28} />
          </div>
          <h2 class="mt-5 text-lg font-semibold text-white">{contact.wechat.name}</h2>
          <p class="mt-2 text-sm text-zinc-400">扫码添加客服微信，实时沟通、订单咨询</p>
          <img
            src={contact.wechat.qrPlaceholder}
            alt="客服微信二维码"
            width="96"
            height="96"
            class="mt-5 rounded-xl border border-zinc-800 bg-white p-1"
          />
        </div>

        <a
          href={`mailto:${contact.email.address}`}
          class="backdrop-blur-md bg-zinc-900/40 border border-zinc-800 rounded-2xl p-8 flex flex-col items-center text-center hover:border-zinc-700 transition-all"
        >
          <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-indigo-500/20 to-cyan-500/20 border border-indigo-500/30 flex items-center justify-center text-indigo-300">
            <Icon name="Mail" size={28} />
          </div>
          <h2 class="mt-5 text-lg font-semibold text-white">{contact.email.name}</h2>
          <p class="mt-2 text-sm text-zinc-400">商务合作、退款申诉、发票申请</p>
          <span class="mt-5 text-indigo-400 hover:text-indigo-300 font-medium break-all">
            {contact.email.address}
          </span>
        </a>

        <a
          href={contact.ticket.url}
          target="_blank"
          rel="noopener noreferrer"
          class="backdrop-blur-md bg-zinc-900/40 border border-zinc-800 rounded-2xl p-8 flex flex-col items-center text-center hover:border-zinc-700 transition-all"
        >
          <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-indigo-500/20 to-cyan-500/20 border border-indigo-500/30 flex items-center justify-center text-indigo-300">
            <Icon name="Ticket" size={28} />
          </div>
          <h2 class="mt-5 text-lg font-semibold text-white">{contact.ticket.name}</h2>
          <p class="mt-2 text-sm text-zinc-400">提交工单，技术问题逐条跟踪回复</p>
          <span class="mt-5 inline-flex items-center gap-1 text-indigo-400 hover:text-indigo-300 font-medium">
            提交工单
            <Icon name="ChevronRight" size={16} />
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
