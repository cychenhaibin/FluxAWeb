---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Card, CardContent } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { ArrowRight, Briefcase, MapPin, Users } from 'lucide-react';

const positions = [
  { title: '高级前端工程师', team: '工程', location: '远程 / 北京', desc: '负责 FluxA 官网、AI 聚合平台的前端架构与开发，React + Astro + Tailwind 经验优先。' },
  { title: 'AI 应用工程师', team: 'AI', location: '远程 / 上海', desc: '基于 LLM 构建智能客服、订单自动化、知识库系统，需要 Prompt Engineering + RAG 经验。' },
  { title: '客户成功经理', team: '客户成功', location: '远程', desc: '负责企业客户的接入培训、续费、技术支持，需要 B2B SaaS 客户成功经验。' },
  { title: '内容运营', team: '运营', location: '远程', desc: '负责 FluxA 公众号、博客、行业动态的内容创作，需要 AI / SaaS 行业背景。' },
];
---
<BaseLayout title="加入我们 - FluxA">
  <section class="w-full bg-background py-20 md:py-28 border-b border-border">
    <div class="container-fluid">
      <div class="mx-auto max-w-2xl text-center">
        <Badge variant="outline" className="mb-4 rounded-full px-3 py-1 text-xs font-medium">
          <Briefcase className="h-3 w-3" />
          加入 FluxA
        </Badge>
        <h1 class="text-balance text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
          远程友好 · 弹性工作
        </h1>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground sm:text-base">
          与顶尖团队一起构建 AI 服务
        </p>
      </div>
    </div>
  </section>

  <section class="w-full bg-background py-20 md:py-28 border-b border-border">
    <div class="container-fluid max-w-4xl">
      <h2 class="text-balance text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
        开放职位
      </h2>
      <div class="mt-10 space-y-3">
        {positions.map((p) => (
          <Card className="transition-all hover:border-foreground/20 hover:shadow-sm">
            <CardContent className="p-6 md:p-7">
              <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <div>
                  <h3 class="text-base font-semibold tracking-tight text-foreground">
                    {p.title}
                  </h3>
                  <div class="mt-1.5 flex items-center gap-3 text-xs text-muted-foreground">
                    <span class="inline-flex items-center gap-1 rounded-full bg-muted px-2.5 py-0.5 font-medium text-foreground">
                      <Users className="h-3 w-3" />
                      {p.team}
                    </span>
                    <span class="inline-flex items-center gap-1">
                      <MapPin className="h-3 w-3" />
                      {p.location}
                    </span>
                  </div>
                  <p class="mt-3 text-sm text-muted-foreground leading-relaxed max-w-2xl">
                    {p.desc}
                  </p>
                </div>
                <Button asChild variant="outline" size="sm" className="shrink-0">
                  <a href={`mailto:careers@fluxa.ai?subject=申请：${p.title}`}>
                    申请
                    <ArrowRight className="h-3.5 w-3.5" />
                  </a>
                </Button>
              </div>
            </CardContent>
          </Card>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
