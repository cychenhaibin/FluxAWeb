---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Card, CardHeader, CardTitle, CardDescription } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { ShieldCheck, Zap, Headphones, ArrowRight } from 'lucide-react';

const values = [
  {
    icon: ShieldCheck,
    title: '透明定价',
    desc: '官方价 + 仅 $3 服务费，所有套餐一视同仁，无隐藏费用。',
  },
  {
    icon: Zap,
    title: '极速体验',
    desc: '5 分钟内自动开通，特殊情况下 30 分钟内人工处理。',
  },
  {
    icon: Headphones,
    title: '7×24 客服',
    desc: '真人客服在线响应，紧急工单 5 分钟内回复。',
  },
];

const stats = [
  { num: '2000+', label: '服务 AI 团队' },
  { num: '5min', label: '极速到账' },
  { num: '7×24', label: '真人客服' },
  { num: '$3', label: '透明服务费' },
];
---
<BaseLayout title="关于我们 - FluxA" description="FluxA 致力于为开发者和团队提供稳定、极速、可观测的 AI 服务。">
  <section class="w-full bg-background py-20 md:py-28 border-b border-border">
    <div class="container-fluid">
      <div class="mx-auto max-w-2xl text-center">
        <Badge variant="outline" className="mb-4 rounded-full px-3 py-1 text-xs font-medium">
          关于 FluxA
        </Badge>
        <h1 class="text-balance text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
          AI 服务，一站搞定
        </h1>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground sm:text-base">
          FluxA 成立于 2026 年，是一家专注于 AI 服务交付的团队。
        </p>
      </div>

      <div class="mx-auto mt-12 max-w-3xl space-y-5 text-sm leading-relaxed text-muted-foreground sm:text-base">
        <p>
          我们从 ChatGPT / Claude 官方价直充起步，逐步扩展到 MiniMax Max 拼车（Claude Max 团队账号拼车）和自营 AI 聚合 API 平台，覆盖开发者、创业团队、企业客户对 AI 服务的全部需求。
        </p>
        <p>
          我们坚持透明计费（官方价 + 仅 $3 服务费）、极速交付（5 分钟到账）、7×24 真人客服，让 AI 服务像水电一样即开即用。
        </p>
      </div>
    </div>
  </section>

  <section class="w-full bg-muted/30 py-16 border-b border-border">
    <div class="container-fluid">
      <div class="mx-auto max-w-4xl">
        <div class="grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-4">
          {stats.map((s) => (
            <div class="bg-background p-6 text-center">
              <div class="text-2xl font-semibold tracking-tight tnum text-foreground sm:text-3xl">
                {s.num}
              </div>
              <div class="mt-1 text-xs text-muted-foreground sm:text-sm">
                {s.label}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="w-full bg-background py-20 md:py-28 border-b border-border">
    <div class="container-fluid">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-balance text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
          我们的价值观
        </h2>
      </div>
      <div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-4 md:grid-cols-3">
        {values.map((v) => {
          const Icon = v.icon;
          return (
            <Card className="h-full transition-all hover:border-foreground/20 hover:shadow-sm">
              <CardHeader className="gap-3">
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-md bg-foreground text-background">
                  <Icon className="h-4 w-4" />
                </span>
                <CardTitle className="text-base font-semibold tracking-tight">{v.title}</CardTitle>
                <CardDescription className="text-sm leading-relaxed">{v.desc}</CardDescription>
              </CardHeader>
            </Card>
          );
        })}
      </div>

      <div class="mt-12 flex justify-center">
        <Button asChild size="lg">
          <a href="/contact">
            联系商务
            <ArrowRight className="h-4 w-4" />
          </a>
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
