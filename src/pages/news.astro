---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Card, CardContent } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { ArrowRight, Newspaper } from 'lucide-react';

const articles = [
  { title: 'MiniMax Max 拼车正式上线', date: '2026-08-13', tag: '新品上线', desc: 'Anthropic Claude Max 5x 官方团队账号 2-4 人拼车，比单独订阅省 50% 以上。', href: '/services/minimax' },
  { title: 'ChatGPT Pro 200 满血套餐', date: '2026-08-05', tag: '套餐', desc: 'Pro 200 满血版上线：1v1 专属客户经理 + 7×24 售后 + 所有模型优先通道。', href: '/services/chatgpt' },
  { title: 'Claude Max 20x 满血体验', date: '2026-07-28', tag: '套餐', desc: 'Max 20x 满血体验：所有优先通道 + Opus 4 满血 + 高峰不限速。', href: '/services/claude' },
  { title: 'AI 聚合平台上线', date: '2026-07-15', tag: '新品上线', desc: 'GPT-4o + Claude Opus + Gemini Pro + 国产大模型，统一接入，智能路由。', href: '/services/ai-aggregator' },
  { title: '5 分钟极速到账', date: '2026-07-01', tag: '工程实践', desc: '我们重构了订单系统，实现 5 分钟极速到账，特殊情况下 30 分钟内人工处理。', href: '#' },
  { title: '$3 服务费透明计费', date: '2026-06-20', tag: '价格政策', desc: '我们坚持透明计费，每单仅 $3 服务费，无隐藏费用，所有渠道一视同仁。', href: '#' },
  { title: 'OpenAI o1 pro 模式正式支持', date: '2026-06-10', tag: '技术', desc: 'Pro 100 套餐已正式支持 o1 pro 深度推理模式，欢迎体验。', href: '#' },
  { title: 'Anthropic Sonnet 4.5 发布', date: '2026-05-25', tag: '行业', desc: 'Sonnet 4.5 已正式发布，Max 5x/20x 套餐同步支持。', href: '#' },
];
---
<BaseLayout title="行业动态 - FluxA">
  <section class="w-full bg-background py-20 md:py-28 border-b border-border">
    <div class="container-fluid">
      <div class="mx-auto max-w-2xl text-center">
        <Badge variant="outline" className="mb-4 rounded-full px-3 py-1 text-xs font-medium">
          <Newspaper className="h-3 w-3" />
          行业动态
        </Badge>
        <h1 class="text-balance text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
          价格 · 服务 · 工程 · 资讯
        </h1>
      </div>
    </div>
  </section>

  <section class="w-full bg-background py-20 md:py-28">
    <div class="container-fluid max-w-4xl">
      <div class="space-y-3">
        {articles.map((a) => (
          <a href={a.href} class="block">
            <Card className="transition-all hover:border-foreground/20 hover:shadow-sm">
              <CardContent className="p-6">
                <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                  <div class="flex-1">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                      <Badge variant="secondary" className="rounded-full px-2.5 py-0.5 text-[10px] font-medium">
                        {a.tag}
                      </Badge>
                      <time>{a.date}</time>
                    </div>
                    <h3 class="mt-2 text-base font-semibold tracking-tight text-foreground">
                      {a.title}
                    </h3>
                    <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                      {a.desc}
                    </p>
                  </div>
                  <ArrowRight className="mt-1 h-4 w-4 shrink-0 text-muted-foreground" />
                </div>
              </CardContent>
            </Card>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
